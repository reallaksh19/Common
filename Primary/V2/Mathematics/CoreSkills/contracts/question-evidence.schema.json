{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/Primary/V2/Mathematics/CoreSkills/contracts/question-evidence.schema.json",
  "title": "PrimaryMathQuestionEvidence",
  "type": "object",
  "required": [
    "question_ref",
    "concept_key",
    "concept_title",
    "scope_basis",
    "capability_refs",
    "problem_family_refs",
    "representation_requirements"
  ],
  "properties": {
    "question_ref": {"type": "string", "minLength": 1},
    "source_ref": {"type": ["string", "null"]},
    "raw_text": {"type": ["string", "null"]},
    "concept_key": {"type": "string", "minLength": 1},
    "concept_title": {"type": "string", "minLength": 1},
    "scope_basis": {
      "enum": [
        "CURRICULUM_CONFIRMED",
        "QUESTION_SET_OBSERVED",
        "SCHOOL_CLASSWORK_OBSERVED",
        "COMMON_G4_5_CAPABILITY",
        "CURRICULUM_OVERLAY",
        "EXTENSION",
        "STRETCH",
        "MAPPING_PENDING",
        "SOURCE_NOT_PROVIDED"
      ]
    },
    "authority_ref": {"type": ["string", "null"]},
    "capability_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "prerequisite_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "problem_family_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "translation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "quantity_structure": {"type": ["object", "null"]},
    "representation_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["representation_id", "role", "primitive_kind", "semantic_params", "validator_refs", "provenance"],
        "properties": {
          "representation_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["CONCRETE", "PICTORIAL", "STRUCTURAL", "SYMBOLIC", "STRATEGIC", "PROCEDURAL", "ABSTRACT_REASONING"]},
          "primitive_kind": {"type": "string", "minLength": 1},
          "semantic_params": {"type": "object"},
          "validator_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fade_modes": {"type": "array", "items": {"enum": ["FULL", "PARTIAL", "EMPTY_FRAME", "NONE"]}, "uniqueItems": true},
          "provenance": {"enum": ["SOURCE_ASSET_EXACT", "SOURCE_ASSET_CROP", "SOURCE_ASSET_ANNOTATED", "RECONSTRUCTED_VISUAL", "ENGINE_AUTHORED_VISUAL", "AUTHORED_NOTEBOOK_EXAMPLE", "STRUCTURED_REPLAY", "FAITHFUL_TRANSCRIPTION", "ORIGINAL_SOURCE_IMAGE"]}
        },
        "additionalProperties": true
      }
    },
    "ambiguity": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
