{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/Primary/V2/Mathematics/Architecture/contracts/learning-design-plan.schema.json",
  "title": "PrimaryMathLearningDesignPlan",
  "type": "object",
  "required": ["schema_version", "plan_id", "product", "skill_model_ref", "modules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "product": {"enum": ["CORE1_STUDY_GUIDE", "CORE2_COMPANION"]},
    "skill_model_ref": {"type": "string", "minLength": 1},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "concept_ref", "concept_mode", "objective", "learner_action"],
        "properties": {
          "module_id": {"type": "string", "minLength": 1},
          "concept_ref": {"type": "string", "minLength": 1},
          "concept_mode": {"enum": ["INTRODUCE", "CONNECT", "REPAIR", "PROBE", "PRACTISE", "RETRIEVE", "TRANSFER", "VERIFY", "REFERENCE"]},
          "objective": {"type": "string", "minLength": 1},
          "prerequisite_refs": {"type": "array", "items": {"type": "string"}},
          "representation_refs": {"type": "array", "items": {"type": "string"}},
          "learner_action": {"type": "string", "minLength": 1},
          "support_level": {"enum": ["H0", "H1", "H2", "H3", "NONE"]},
          "fade_mode": {"enum": ["FULL", "PARTIAL", "EMPTY_FRAME", "NONE"]},
          "independent_check_required": {"type": "boolean"},
          "core1_module_ref": {"type": ["string", "null"]},
          "hint_ref": {"type": ["string", "null"]},
          "practice_batch_type": {"enum": ["RECONNECT", "BUILD", "CHOOSE", "MIX", "TRANSFER", "RETRIEVE", "NOT_APPLICABLE"]},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
