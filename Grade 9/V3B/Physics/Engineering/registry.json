      "research_brief_ref": "RESEARCH.md#thermodynamics",
      "obligations": [
        {
          "id": "PHY-TH-FIRST-LAW-C1",
          "kind": "CONCEPT",
          "statement": "Heat entering and work leaving contribute with opposite signs to the internal-energy change.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-R1",
          "kind": "RELATION",
          "statement": "Delta U = Q - W_by; equivalently Delta U = Q + W_on with W_on = -W_by.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-R2",
          "kind": "RELATION",
          "statement": "Q = Delta U + W_by; adiabatic means Q = 0, not Delta U = 0.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-V1",
          "kind": "REPRESENTATION",
          "statement": "Energy-flow arrows map individually to signed terms in the first-law equation.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ],
          "relation_ids": [
            "PHY-TH-FIRST-LAW-R1",
            "PHY-TH-FIRST-LAW-R2"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-M1",
          "kind": "MISCONCEPTION",
          "statement": "Positive work done on a gas is negative work done by that gas.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-M2",
          "kind": "MISCONCEPTION",
          "statement": "Equal initial and final states imply equal Delta U, not equal Q or W for different paths.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-K1",
          "kind": "CHECK",
          "statement": "500 J enters and 180 J leaves as work: Delta U = 320 J; recombine 320 + 180 = 500 J.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
        },
        {
          "id": "PHY-TH-FIRST-LAW-K2",
          "kind": "CHECK",
          "statement": "For a closed adiabatic compression with W_by = -90 J, Delta U = +90 J.",
          "evidence_refs": [
            "https://ocw.mit.edu/ans7870/16/16.unified/thermoF03/chapter_3.htm",
            "https://openstax.org/books/university-physics-volume-2/pages/3-3-first-law-of-thermodynamics"
          ]
