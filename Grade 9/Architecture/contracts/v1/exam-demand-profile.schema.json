{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exam-demand-profile.schema.json",
  "title": "ExamDemandProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["exam_demand_profile_id", "schema_version", "exam_id", "cycle", "response_contract", "evidence_source_refs", "concept_ids", "question_family_ids", "representation_types", "demand_dimensions"],
  "properties": {
    "exam_demand_profile_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "schema_version": {"const": "1.0.0"},
    "exam_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "cycle": {"type": "string", "minLength": 1},
    "stage": {"type": "string"},
    "grade": {"type": "integer", "minimum": 1, "maximum": 12},
    "response_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1}
      }
    },
    "evidence_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "representative_occurrence_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/stable_id"},
      "default": []
    },
    "concept_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "question_family_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "representation_types": {"type": "array", "items": {"type": "string"}},
    "hidden_prerequisite_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/stable_id"},
      "default": []
    },
    "common_distractors_or_failure_models": {"type": "array", "items": {"type": "string"}, "default": []},
    "demand_dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean"]
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_code": {"type": "string"},
        "editorial_label": {"type": "string"},
        "calibration_basis": {"$ref": "common.schema.json#/$defs/calibration_basis"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/stable_id"},
          "default": []
        }
      }
    },
    "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
    "fresh_until": {"type": "string", "format": "date"}
  }
}