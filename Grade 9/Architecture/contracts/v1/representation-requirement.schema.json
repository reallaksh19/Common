{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "representation-requirement.schema.json",
  "title": "RepresentationRequirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["representation_requirement_id", "subject", "representation_type", "concept_ids", "research_refs", "semantic_requirements", "required_labels"],
  "properties": {
    "representation_requirement_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "subject": {"enum": ["MATHEMATICS", "PHYSICS", "CHEMISTRY", "CROSS_SUBJECT"]},
    "representation_type": {"type": "string", "minLength": 1},
    "concept_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "research_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "semantic_requirements": {
      "type": "object",
      "description": "Subject-semantic payload. Geometry/layout is deliberately excluded and belongs to Core (2)'s Shared Representation Layer.",
      "additionalProperties": true
    },
    "required_labels": {"type": "array", "items": {"type": "string"}, "default": []},
    "approved_asset_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/stable_id"},
      "default": []
    },
    "traceability_class": {"const": "MATERIAL_REPRESENTATION"},
    "blocking_if_unsupported": {"type": "boolean", "default": true}
  }
}