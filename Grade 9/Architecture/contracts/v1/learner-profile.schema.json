{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learner-profile.schema.json",
  "title": "LearnerProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["learner_profile_id", "schema_version", "privacy_class", "baselines"],
  "properties": {
    "learner_profile_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "schema_version": {"const": "1.0.0"},
    "privacy_class": {"enum": ["PRIVATE", "ANONYMIZED", "PUBLIC_SYNTHETIC"]},
    "grade": {"type": "integer", "minimum": 1, "maximum": 12},
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subtopic_id", "value", "basis", "confidence"],
        "properties": {
          "subtopic_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "value": {"type": "integer", "minimum": 0, "maximum": 100},
          "basis": {"$ref": "common.schema.json#/$defs/baseline_basis"},
          "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "common.schema.json#/$defs/stable_id"},
            "default": []
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}