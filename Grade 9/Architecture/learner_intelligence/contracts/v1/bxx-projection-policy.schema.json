{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bxx-projection-policy.schema.json",
  "title": "BxxProjectionPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "semantics", "inputs", "output_bounds", "forbidden_interpretations"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "semantics": {"const": "PUBLICATION_ADAPTATION_BASELINE"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["CAPABILITY_STATE", "CONFIDENCE", "INDEPENDENT_EVIDENCE", "GUIDED_EVIDENCE", "TRANSFER_EVIDENCE", "DELAYED_EVIDENCE", "ACTIVE_DIAGNOSTIC_CASES"]}
    },
    "output_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"const": 0},
        "maximum": {"const": 100}
      }
    },
    "forbidden_interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["PSYCHOMETRIC_MASTERY_PERCENTAGE", "PROBABILITY_OF_KNOWLEDGE", "IQ_OR_APTITUDE_SCORE"]}
    }
  }
}
