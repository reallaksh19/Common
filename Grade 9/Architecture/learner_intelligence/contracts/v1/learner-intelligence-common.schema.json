{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learner-intelligence-common.schema.json",
  "title": "Learner Intelligence Common v1",
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "evidence_strength": {"enum": ["INSUFFICIENT", "WEAK", "MODERATE", "STRONG"]},
    "observation_type": {"enum": ["SUCCESS", "OMISSION", "INVALID_TRANSFORMATION", "WRONG_MODEL_SELECTION", "INCONSISTENT_STATE", "REPRESENTATION_MISMATCH", "CALCULATION_ERROR", "CONDITION_VIOLATION", "UNSUPPORTED_INFERENCE", "VERIFICATION_MISSING", "AMBIGUOUS"]},
    "capability_state": {"enum": ["UNKNOWN", "REPAIR_REQUIRED", "DEVELOPING", "READY", "ROBUST"]},
    "diagnostic_status": {"enum": ["OPEN", "SUSPECTED", "SUPPORTED", "REFUTED", "RESOLVED"]},
    "evidence_kind": {"enum": ["FORMAL_ASSESSMENT", "DIAGNOSTIC", "PRACTICE", "RETRIEVAL", "TRANSFER", "TEACHER_OBSERVATION", "DIGITAL_INTERACTION", "OTHER"]},
    "assistance_level": {"enum": ["NONE", "RECOGNITION_CUE", "REPRESENTATION_CUE", "FIRST_STEP", "INTERMEDIATE_STEPS", "NEAR_SOLUTION", "FULL_SOLUTION", "UNKNOWN"]}
  }
}
