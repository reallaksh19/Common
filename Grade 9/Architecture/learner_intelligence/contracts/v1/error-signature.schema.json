{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-signature.schema.json",
  "title": "ErrorSignature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_signature_id", "scope", "description", "observable_pattern", "candidate_capability_refs"],
  "properties": {
    "error_signature_id": {"type": "string", "minLength": 1},
    "scope": {"enum": ["SHARED", "MATHEMATICS", "PHYSICS", "CHEMISTRY"]},
    "description": {"type": "string", "minLength": 1},
    "observable_pattern": {"type": "string", "minLength": 1},
    "candidate_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "candidate_misconception_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "alternative_explanations": {"type": "array", "items": {"type": "string"}},
    "probe_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
