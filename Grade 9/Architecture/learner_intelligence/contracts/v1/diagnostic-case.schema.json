{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic-case.schema.json",
  "title": "DiagnosticCase v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostic_case_id", "learner_ref", "target_capability_ref", "observation_refs", "hypotheses"],
  "properties": {
    "diagnostic_case_id": {"$ref": "learner-intelligence-common.schema.json#/$defs/stable_id"},
    "learner_ref": {"$ref": "learner-intelligence-common.schema.json#/$defs/stable_id"},
    "target_capability_ref": {"type": "string", "minLength": 1},
    "observation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "status", "evidence_strength", "supporting_observation_refs", "alternative_explanations", "probe_required"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "misconception_ref": {"type": "string"},
          "failure_mode": {"type": "string"},
          "status": {"$ref": "learner-intelligence-common.schema.json#/$defs/diagnostic_status"},
          "evidence_strength": {"$ref": "learner-intelligence-common.schema.json#/$defs/evidence_strength"},
          "supporting_observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "contradicting_observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "alternative_explanations": {"type": "array", "items": {"type": "string"}},
          "probe_required": {"type": "boolean"},
          "recommended_probe_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "policy_ref": {"type": "string"}
  }
}
