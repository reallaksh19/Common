{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic-policy.schema.json",
  "title": "DiagnosticPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "single_error_rule", "supported_hypothesis_rules", "ambiguity_action", "state_labels"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "single_error_rule": {"const": "CANNOT_CONFIRM_MISCONCEPTION"},
    "supported_hypothesis_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["RECURRENCE_ACROSS_INDEPENDENT_ATTEMPTS", "ERROR_SIGNATURE_PLUS_TARGETED_PROBE", "SUBJECT_AUTHORIZED_DETERMINISTIC_DISCRIMINATOR"]}
    },
    "ambiguity_action": {"const": "DIAGNOSTIC_PROBE_REQUIRED"},
    "preserve_upstream_success": {"const": true},
    "hinted_success_counts_as_independent": {"const": false},
    "allow_unobserved_psychological_cause_inference": {"const": false},
    "state_labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["UNKNOWN", "REPAIR_REQUIRED", "DEVELOPING", "READY", "ROBUST"]},
      "minItems": 5,
      "maxItems": 5
    }
  }
}
