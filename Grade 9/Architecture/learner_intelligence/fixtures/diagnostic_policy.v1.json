{
  "policy_id": "LI-DIAGNOSTIC-POLICY-V1",
  "version": "1.0.0",
  "single_error_rule": "CANNOT_CONFIRM_MISCONCEPTION",
  "supported_hypothesis_rules": [
    "RECURRENCE_ACROSS_INDEPENDENT_ATTEMPTS",
    "ERROR_SIGNATURE_PLUS_TARGETED_PROBE",
    "SUBJECT_AUTHORIZED_DETERMINISTIC_DISCRIMINATOR"
