{
  "$id": "skp-source-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKP Pilot Source Record",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sourceIntent": {
      "enum": [
        "CURRICULUM_AUTHORITY",
        "SUBJECT_TRUTH",
        "DERIVATION_REFERENCE",
        "NOVICE_EXPLANATION",
        "ADVANCED_EXPLANATION",
        "MISCONCEPTION_EVIDENCE",
        "REPRESENTATION_REFERENCE",
        "QUESTION_FAMILY_EVIDENCE",
        "LOCAL_ASSESSMENT",
        "EXTERNAL_ASSESSMENT",
        "RESEARCH_EXTENSION",
        "HISTORICAL_CONTEXT"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "title",
    "source_type",
    "source_locator",
    "provenance_scope",
    "version_identity",
    "content_digest",
    "intent_assessments",
    "licensing_state",
    "overall_disposition"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9_-]*$"},
    "title": {"type": "string", "minLength": 3},
    "creator_or_organization": {"type": "string", "minLength": 2},
    "publication_year": {
      "anyOf": [
        {"type": "integer", "minimum": 1800, "maximum": 2200},
        {"type": "null"}
      ]
    },
    "source_type": {
      "enum": [
        "OFFICIAL_CURRICULUM",
        "PRIMARY_STANDARD",
        "TEXTBOOK",
        "PEER_REVIEWED_RESEARCH",
        "PROFESSIONAL_REFERENCE",
        "QUESTION_BANK",
        "WEB_EXPLANATION",
        "REPOSITORY_ARTIFACT",
        "DATASET",
        "OTHER"
      ]
    },
    "source_locator": {"type": "string", "minLength": 3},
    "provenance_scope": {"enum": ["LOCAL_REPOSITORY", "WEB", "EXTERNAL_DOCUMENT"]},
    "version_identity": {"type": "string", "minLength": 1},
    "content_digest": {
      "anyOf": [
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "intent_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_intent", "target_refs", "authority_disposition", "selection_reason",
          "limitations", "corroboration_state"
        ],
        "properties": {
          "source_intent": {"$ref": "#/$defs/sourceIntent"},
          "target_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "authority_disposition": {
            "enum": [
              "PROMOTED_FOR_INTENT",
              "CANDIDATE",
              "CORROBORATION_REQUIRED",
              "CONFLICTING",
              "SUPERSEDED",
              "OUT_OF_SCOPE",
              "REJECTED_AUTHORITY",
              "REUSE_RESTRICTED",
              "UNRESOLVED"
            ]
          },
          "selection_reason": {"type": "string", "minLength": 10},
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3}
          },
          "population_context": {
            "anyOf": [
              {"type": "string", "minLength": 3},
              {"type": "null"}
            ]
          },
          "corroboration_state": {
            "enum": ["NOT_REQUIRED", "REQUIRED_OPEN", "CORROBORATED", "CONFLICTING", "UNRESOLVED"]
          }
        }
      }
    },
    "conflict_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9_-]*$"}
    },
    "licensing_state": {
      "enum": [
        "OPEN_OR_PUBLIC_DOMAIN",
        "LICENSED_LOCAL_USE",
        "REFERENCE_ONLY",
        "REPRODUCTION_RESTRICTED",
        "UNKNOWN_REVIEW_REQUIRED"
      ]
    },
    "overall_disposition": {
      "enum": ["CANDIDATE", "PARTIALLY_PROMOTED", "PROMOTED", "REJECTED", "UNRESOLVED"]
    }
  }
}
