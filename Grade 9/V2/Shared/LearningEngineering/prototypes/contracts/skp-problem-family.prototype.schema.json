{
  "$id": "skp-problem-family.prototype.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKP Problem Family Prototype",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "variation": {
      "anyOf": [
        {"type": "string", "minLength": 3},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimension", "allowed_changes", "invariant"],
          "properties": {
            "dimension": {"type": "string", "minLength": 2},
            "allowed_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "invariant": {"type": "string", "minLength": 5}
          }
        }
      ]
    },
    "typedTransferBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["near_transfer", "far_transfer", "must_remain_invariant"],
      "properties": {
        "near_transfer": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "far_transfer": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "must_remain_invariant": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    }
  },
  "required": ["schema_version", "prototype_only", "problem_family_id", "skp_ref", "title", "structural_signature", "capability_refs", "concept_refs", "relation_refs", "reasoning_sequence_refs", "representation_refs", "verification_route_refs", "allowed_variations", "transfer_boundaries", "surface_cues_not_authority", "source_refs"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "prototype_only": {"const": true},
    "problem_family_id": {"type": "string", "pattern": "^FAMILY-[A-Z0-9][A-Z0-9_-]*$"},
    "skp_ref": {"type": "string", "pattern": "^SKP-[A-Z0-9][A-Z0-9_-]*$"},
    "title": {"type": "string", "minLength": 3},
    "structural_signature": {"type": "string", "minLength": 10},
    "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9_-]*$"}},
    "concept_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CONCEPT-[A-Z0-9][A-Z0-9_-]*$"}},
    "relation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REL-[A-Z0-9][A-Z0-9_-]*$"}},
    "reasoning_sequence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REASON-[A-Z0-9][A-Z0-9_-]*$"}},
    "representation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REP-[A-Z0-9][A-Z0-9_-]*$"}},
    "verification_route_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^VERIFY-[A-Z0-9][A-Z0-9_-]*$"}},
    "allowed_variations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variation"}},
    "transfer_boundaries": {
      "anyOf": [
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        {"$ref": "#/$defs/typedTransferBoundaries"}
      ]
    },
    "surface_cues_not_authority": {"const": true},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9_-]*$"}},
    "source_family_ref": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
