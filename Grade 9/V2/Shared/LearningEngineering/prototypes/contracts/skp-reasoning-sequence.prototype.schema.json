{
  "$id": "skp-reasoning-sequence.prototype.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SKP Reasoning Sequence Prototype",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prototype_only", "sequence_id", "skp_ref", "capability_refs", "steps", "learner_support_authority", "source_refs"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "prototype_only": {"const": true},
    "sequence_id": {"type": "string", "pattern": "^REASON-[A-Z0-9][A-Z0-9_-]*$"},
    "skp_ref": {"type": "string", "pattern": "^SKP-[A-Z0-9][A-Z0-9_-]*$"},
    "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-[A-Z0-9][A-Z0-9_-]*$"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "semantic_role", "semantic_job", "relation_refs", "representation_refs", "fragility", "fragility_rationale", "source_step_ref"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^STEP-[A-Z0-9][A-Z0-9_-]*$"},
          "semantic_role": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
          "semantic_job": {"type": "string", "minLength": 5},
          "relation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REL-[A-Z0-9][A-Z0-9_-]*$"}},
          "representation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^REP-[A-Z0-9][A-Z0-9_-]*$"}},
          "fragility": {"enum": ["LOW", "MEDIUM", "HIGH", "UNRESOLVED"]},
          "fragility_rationale": {"type": "string"},
          "source_step_ref": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
        },
        "allOf": [
          {
            "if": {"properties": {"fragility": {"const": "HIGH"}}},
            "then": {"properties": {"fragility_rationale": {"minLength": 10}}}
          }
        ]
      }
    },
    "learner_support_authority": {"const": false},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9_-]*$"}},
    "source_route_ref": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
