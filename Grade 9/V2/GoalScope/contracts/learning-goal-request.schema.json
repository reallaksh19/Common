{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningGoalRequest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_request_id",
    "schema_version",
    "requested_by",
    "subject",
    "intent",
    "target_ids",
    "mandatory_target_ids",
    "optional_target_ids"
  ],
  "properties": {
    "goal_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "requested_by": {
      "enum": [
        "LEARNER",
        "TEACHER",
        "PARENT",
        "SYSTEM"
      ]
    },
    "subject": {
      "enum": [
        "MATHEMATICS",
        "PHYSICS",
        "CHEMISTRY",
        "CROSS_SUBJECT"
      ]
    },
    "intent": {
      "enum": [
        "CURRICULUM_MASTERY",
        "COMPETITIVE_EXAM_PREPARATION",
        "FOUNDATIONAL_REPAIR",
        "TRANSFER",
        "REVIEW"
      ]
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "mandatory_target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "optional_target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "exam_profile_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "request_notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
