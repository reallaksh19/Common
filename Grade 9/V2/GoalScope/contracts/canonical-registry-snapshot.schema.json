{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Synthetic canonical registry snapshot",
  "type":"object",
  "additionalProperties":false,
  "required":["registry_id","schema_version","version","digest","assets"],
  "properties":{
    "registry_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "schema_version":{"const":"2.0.0"},
    "version":{"type":"string","minLength":1},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "assets":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["canonical_id","subject","version","digest","status","dependencies"],"properties":{"canonical_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"subject":{"enum":["MATHEMATICS","PHYSICS","CHEMISTRY"]},"version":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["ACTIVE","STALE","RETIRED"]},"dependencies":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["canonical_id","reason"],"properties":{"canonical_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"reason":{"type":"string","minLength":1},"required_version":{"type":"string","minLength":1},"required_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}}
  }
}
