{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalKnowledgeSet V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_knowledge_set_id","schema_version","canonical_registry_id","canonical_registry_version","canonical_registry_digest","primary_bundles","dependency_bundles","resolution_events","canonical_gap_candidates","knowledge_set_digest"],
  "properties": {
    "canonical_knowledge_set_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "schema_version":{"const":"2.0.0"},
    "canonical_registry_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "canonical_registry_version":{"type":"string","minLength":1},
    "canonical_registry_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "primary_bundles":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["canonical_id","subject","version","digest"],"properties":{"canonical_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"subject":{"enum":["MATHEMATICS","PHYSICS","CHEMISTRY"]},"version":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "dependency_bundles":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["canonical_id","subject","version","digest","required_by","dependency_reason","resolution_status"],"properties":{"canonical_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"subject":{"enum":["MATHEMATICS","PHYSICS","CHEMISTRY"]},"version":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"required_by":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}},"dependency_reason":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"resolution_status":{"enum":["REUSE_EXISTING","COMPOSE_DEPENDENCY","REVALIDATE"]}}}},
    "resolution_events":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["from_id","to_id","status","reason"],"properties":{"from_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"to_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"status":{"enum":["REUSE_EXISTING","COMPOSE_DEPENDENCY","REVALIDATE","CANONICAL_GAP_CANDIDATE"]},"reason":{"type":"string","minLength":1}}}},
    "canonical_gap_candidates":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["missing_canonical_id","required_by","reason"],"properties":{"missing_canonical_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"required_by":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},"reason":{"type":"string","minLength":1}}}},
    "knowledge_set_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
