{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalTargetScope V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_target_scope_id",
    "schema_version",
    "goal_request_id",
    "canonical_registry_id",
    "canonical_registry_version",
    "canonical_registry_digest",
    "target_obligations",
    "excluded_target_ids"
  ],
  "properties": {
    "canonical_target_scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "schema_version": {"const": "2.0.0"},
    "goal_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "canonical_registry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "canonical_registry_version": {"type": "string", "minLength": 1},
    "canonical_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_id", "obligation", "goal_reason_refs"],
        "properties": {
          "canonical_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
          "obligation": {"enum": ["REQUIRED", "OPTIONAL"]},
          "goal_reason_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}
          }
        }
      }
    },
    "excluded_target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}
    },
    "scope_policy_version": {"type": "string", "minLength": 1}
  }
}
