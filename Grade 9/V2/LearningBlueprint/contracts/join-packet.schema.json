{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/g9-v2/learning-blueprint/join-packet.schema.json",
  "title": "Core1 x Core2 join packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "packet_type", "ground_truth_manifest_id", "semantic_packet_ref", "assessment_packet_ref", "validation_packet_ref", "join_state", "obligations", "assessment_without_semantic_support", "semantic_without_assessment_evidence", "unresolved", "digest"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 3},
    "packet_type": {"const": "J"},
    "ground_truth_manifest_id": {"type": "string", "minLength": 3},
    "semantic_packet_ref": {"type": "string", "minLength": 3},
    "assessment_packet_ref": {"type": "string", "minLength": 3},
    "validation_packet_ref": {"type": "string", "minLength": 3},
    "join_state": {"enum": ["READY_FOR_LEARNER_STATE", "BLOCK_CONFLICT", "BLOCK_MISSING_SEMANTIC_SUPPORT"]},
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "capability_ref", "semantic_claim_refs", "assessment_claim_refs", "state"],
        "properties": {
          "obligation_id": {"type": "string", "minLength": 3},
          "capability_ref": {"type": "string", "minLength": 2},
          "semantic_claim_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
          "assessment_claim_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
          "state": {"const": "SEMANTIC_AND_ASSESSMENT_ALIGNED"}
        }
      }
    },
    "assessment_without_semantic_support": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_ref", "assessment_claim_refs"],
        "properties": {
          "capability_ref": {"type": "string", "minLength": 2},
          "assessment_claim_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "semantic_without_assessment_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_ref", "semantic_claim_refs", "interpretation"],
        "properties": {
          "capability_ref": {"type": "string", "minLength": 2},
          "semantic_claim_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
          "interpretation": {"const": "NO_ASSESSMENT_DEMAND_EVIDENCE_DOES_NOT_IMPLY_LOW_IMPORTANCE"}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
