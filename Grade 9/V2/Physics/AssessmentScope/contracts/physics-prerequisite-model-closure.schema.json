{
  "$id": "physics-prerequisite-model-closure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_ref": {
      "type": "string"
    },
    "closure_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "direct_capability_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "item_ref": {
            "type": "string"
          },
          "prerequisite_capability_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "undeclared_prerequisite_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "item_ref",
          "direct_capability_refs",
          "prerequisite_capability_refs",
          "undeclared_prerequisite_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "prerequisite_closure_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "PHYSICS"
    }
  },
  "required": [
    "prerequisite_closure_id",
    "schema_version",
    "subject",
    "authority_ref",
    "items",
    "closure_digest"
  ],
  "type": "object"
}
