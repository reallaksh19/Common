{
  "registry_id": "PHY-CORE2A-VALIDATORS-v1",
  "schema_version": "1.0.0",
  "validators": {
    "CONSTANT_ACCELERATION_VELOCITY": {
      "required_fields": ["u", "a", "t", "expected_v"],
      "quantity": "VELOCITY",
      "relation": "v = u + a t"
    },
    "CONSTANT_ACCELERATION_INITIAL_VELOCITY": {
      "required_fields": ["v", "a", "t", "expected_u"],
      "quantity": "VELOCITY",
      "relation": "u = v - a t"
    },
    "VECTOR_DOT_PERPENDICULAR": {
      "required_fields": ["vector_a", "vector_b"],
      "quantity": "DIMENSIONLESS_ZERO_TEST",
      "relation": "a dot b = 0"
    },
    "SPEED_FROM_COMPONENTS": {
      "required_fields": ["vx", "vy", "expected_speed"],
      "quantity": "SPEED",
      "relation": "speed = sqrt(vx^2 + vy^2)"
    }
  }
}
