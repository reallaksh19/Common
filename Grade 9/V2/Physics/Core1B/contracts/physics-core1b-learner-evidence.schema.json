{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-core1b-learner-evidence.schema.json",
  "title": "Physics Learner Capability Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "learner_profile_ref", "capability_id", "problem_family_ref", "state", "evidence", "hint_history", "error_history", "representation_coverage", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "learner_profile_ref": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "problem_family_ref": {"type": "string", "minLength": 1},
    "state": {"enum": ["NOT_EXPOSED", "EXPOSED", "SUPPORTED", "INDEPENDENT", "TRANSFER_READY", "ROBUST"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognise", "represent", "model_select", "first_move", "finish", "check", "delayed_retrieval"],
      "properties": {
        "recognise": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "represent": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "explain": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "model_select": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "first_move": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "finish": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "check": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]},
        "delayed_retrieval": {"enum": ["PASS", "PARTIAL", "FAIL", "UNTESTED"]}
      }
    },
    "hint_history": {"type": "array", "items": {"type": "string"}},
    "error_history": {"type": "array", "items": {"type": "string"}},
    "representation_coverage": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}