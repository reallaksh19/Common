{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"physics-core1b-unit.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","unit_id","subject","bucket_id","capability_id","problem_family_ref","upstream_authority","atom_refs","prerequisite_skip_evidence","readiness_requirements","model_validity_required","explanation_required","learner_surface"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "unit_id":{"type":"string","minLength":1},
    "subject":{"const":"PHYSICS"},
    "bucket_id":{"type":"string","minLength":1},
    "capability_id":{"type":"string","minLength":1},
    "problem_family_ref":{"type":"string","minLength":1},
    "upstream_authority":{"type":"object","additionalProperties":false,"required":["core1a_release_ref","core1a_release_digest"],"properties":{"core1a_release_ref":{"type":"string","minLength":1},"core1a_release_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "atom_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "prerequisite_skip_evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["atom_ref","event_ref","event_digest"],"properties":{"atom_ref":{"type":"string"},"event_ref":{"type":"string"},"event_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "readiness_requirements":{"type":"array","minItems":5,"uniqueItems":true,"items":{"enum":["recognise","represent","explain","applicability","model_select","first_move","finish","check"]}},
    "model_validity_required":{"type":"boolean"},
    "explanation_required":{"type":"boolean"},
    "learner_surface":{"type":"object","additionalProperties":false,"required":["teacher_moves","worked_example","faded_task","independent_task"],"properties":{"teacher_moves":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"worked_example":{"type":"string","minLength":1},"faded_task":{"type":"string","minLength":1},"independent_task":{"type":"string","minLength":1}}}
  }
}
