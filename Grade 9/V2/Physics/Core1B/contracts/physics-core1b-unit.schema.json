{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-core1b-unit.schema.json",
  "title": "Physics Core1B Unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit_id", "subject", "bucket_id", "capability_id", "authority_refs", "atom_refs", "learner_surface", "readiness"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "unit_id": {"type": "string", "minLength": 1},
    "subject": {"const": "PHYSICS"},
    "bucket_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "authority_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "atom_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "learner_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher_moves", "worked_example", "independent_task"],
      "properties": {
        "teacher_moves": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "worked_example": {"type": "string", "minLength": 1},
        "independent_task": {"type": "string", "minLength": 1}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognise", "represent", "first_move", "finish", "check"],
      "properties": {
        "recognise": {"type": "boolean"},
        "represent": {"type": "boolean"},
        "explain": {"type": "boolean"},
        "first_move": {"type": "boolean"},
        "finish": {"type": "boolean"},
        "check": {"type": "boolean"}
      }
    }
  }
}