  "equations": [
    {"id":"M2D-EQ-PROJ-UX","source_locator":"§3.1","canonical_expression":"u_x = u cos(theta)","learner_name":"Horizontal launch component","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"velocity resolved along chosen x-axis","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-UY","source_locator":"§3.1","canonical_expression":"u_y = u sin(theta)","learner_name":"Vertical launch component","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"velocity resolved along chosen y-axis","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-AX","source_locator":"§3.1","canonical_expression":"a_x = 0","learner_name":"No horizontal acceleration in the ideal projectile model","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"air resistance neglected; gravity vertical","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-AY","source_locator":"§3.1","canonical_expression":"a_y = -g","learner_name":"Vertical acceleration is gravity","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"up is positive; near-Earth constant-g model","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-VX","source_locator":"§3.1.1","canonical_expression":"v_x = u_x = u cos(theta)","learner_name":"Horizontal velocity stays constant","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"a_x = 0","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-X","source_locator":"§3.1.1","canonical_expression":"x = u_x t = u t cos(theta)","learner_name":"Horizontal position","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"origin at launch or x is horizontal displacement from launch","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-VY","source_locator":"§3.1.2","canonical_expression":"v_y = u_y - g t","learner_name":"Vertical velocity changes with time","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"up is positive; constant g","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-Y","source_locator":"§3.1.2","canonical_expression":"y = u_y t - (1/2) g t^2","learner_name":"Vertical position","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"origin at launch or y is vertical displacement from launch; constant g","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-VY2","source_locator":"§3.1.2","canonical_expression":"v_y^2 = u_y^2 - 2 g y","learner_name":"Vertical relation when time is not needed","core1a_home":"PROJECTILE_COMPONENT_CLOCK","valid_when":"same vertical sign convention; constant g","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-T","source_locator":"§3.1.3","canonical_expression":"T = 2 u sin(theta) / g","learner_name":"Time of flight","core1a_home":"PROJECTILE_SAME_HEIGHT","valid_when":"ideal projectile; launch and landing at same height","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-R","source_locator":"§3.1.4","canonical_expression":"R = u^2 sin(2 theta) / g","learner_name":"Horizontal range","core1a_home":"PROJECTILE_SAME_HEIGHT","valid_when":"ideal projectile; launch and landing at same height","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-H","source_locator":"§3.1.5","canonical_expression":"H = u^2 sin^2(theta) / (2 g)","learner_name":"Maximum height above launch","core1a_home":"PROJECTILE_APEX","valid_when":"ideal projectile; H measured above launch point","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-TRAJ","source_locator":"Equation of Trajectory","canonical_expression":"y = x tan(theta) - g x^2 / (2 u^2 cos^2(theta))","learner_name":"Projectile path without time","core1a_home":"PROJECTILE_TRAJECTORY","valid_when":"ideal projectile; axes/origin match derivation","must_be_taught":true,"status":"PLANNED"},
    {"id":"M2D-EQ-PROJ-TRAJ-R","source_locator":"Equation of Trajectory / Formulae Sheet","canonical_expression":"y = x (1 - x/R) tan(theta)","learner_name":"Trajectory written using range","core1a_home":"PROJECTILE_TRAJECTORY","valid_when":"same-height range R is valid","must_be_taught":true,"status":"PLANNED"},
