    {"id":"M2D-EQ-RIVER-SUM","source_locator":"§6.1","canonical_expression":"v_A = v_AB + v_B","learner_name":"Boat ground velocity","core1a_home":"RIVER_FOUNDATION","valid_when":"A is boat, B is stream, all vectors share coordinates","must_be_taught":true,"status":"PLANNED"},
