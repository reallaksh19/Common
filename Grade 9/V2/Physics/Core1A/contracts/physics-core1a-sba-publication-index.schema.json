{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-core1a-sba-publication-index.schema.json",
  "title": "Physics Core1A SBA Publication Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chapter_id", "render_as_first_step", "title", "columns", "rows"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "chapter_id": {"type": "string", "minLength": 1},
    "render_as_first_step": {"const": true},
    "title": {"type": "string", "minLength": 1},
    "columns": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1}
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket_id", "subtopic_bucket", "origin", "core1a_teaching_home", "core2_primary_questions", "state"],
      "properties": {
        "bucket_id": {"type": "string", "pattern": "^M2D-SBA-\\d{2}$"},
        "subtopic_bucket": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "core1a_teaching_home": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "core2_primary_questions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^Q\\d{2}$"}
        },
        "state": {"enum": ["BUILT", "IN_PROGRESS", "PLANNED", "SKIPPED_NO_PRIMARY_CORE2"]}
      }
    }
  }
}
