{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-core1a-source-contract.schema.json",
  "title": "Physics Core1A Source Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_contract_id",
    "bucket_id",
    "source_mode",
    "source_items",
    "required_concepts",
    "equations",
    "source_gaps",
    "forbidden_inventions"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_contract_id": {"type": "string", "pattern": "^SRC-CONTRACT-M2D-SBA-\\d{2}-v1$"},
    "bucket_id": {"type": "string", "pattern": "^M2D-SBA-\\d{2}$"},
    "source_mode": {"enum": ["THEORY_BACKED", "PRACTICE_DRIVEN", "SOURCE_VISIBLE_EXTENSION"]},
    "source_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "locator", "integrity_class", "content_summary", "use_policy", "teaching_atoms"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["THEORY", "EQUATION", "ILLUSTRATION", "PRACTICE", "FORMULA_SHEET", "CORE2_PROMPT"]},
          "locator": {"type": "string", "minLength": 1},
          "integrity_class": {"enum": ["CLEAN", "TYPOGRAPHIC_OCR_AMBIGUITY", "MATHEMATICAL_DOMAIN_ISSUE", "TRUNCATED_OR_AMBIGUOUS"]},
          "content_summary": {"type": "string", "minLength": 1},
          "use_policy": {"enum": ["USE", "USE_WITH_QC_NOTE", "DO_NOT_USE"]},
          "teaching_atoms": {"type": "array", "items": {"type": "string", "pattern": "^M2D-SBA-\\d{2}[A-Z]$"}, "uniqueItems": true}
        }
      }
    },
    "required_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept_id", "title", "teaching_atom"],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "teaching_atom": {"type": "string", "pattern": "^M2D-SBA-\\d{2}[A-Z]$"}
        }
      }
    },
    "equations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["equation_id", "canonical_expression", "learner_name", "authority", "valid_when", "teaching_atom", "must_be_taught", "derivation_basis"],
        "properties": {
          "equation_id": {"type": "string", "minLength": 1},
          "canonical_expression": {"type": "string", "minLength": 1},
          "learner_name": {"type": "string", "minLength": 1},
          "authority": {"enum": ["SOURCE", "CORE1_PREREQUISITE", "DERIVED_BRIDGE"]},
          "valid_when": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "teaching_atom": {"type": "string", "pattern": "^M2D-SBA-\\d{2}[A-Z]$"},
          "must_be_taught": {"type": "boolean"},
          "derivation_basis": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "source_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "description", "bridge_policy"],
        "properties": {
          "gap_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "bridge_policy": {"enum": ["DERIVE_FROM_AUTHORISED_PREREQUISITES", "LEARNER_QC_NOTE", "NO_BRIDGE"]}
        }
      }
    },
    "forbidden_inventions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
