{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-core1a-sba-build-manifest.schema.json",
  "title": "Physics Core1A SBA Build Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bucket_id",
    "learner_profile",
    "source_inputs",
    "primary_questions",
    "question_release",
    "question_load",
    "phase_gates",
    "learning_atoms",
    "transfer_routines",
    "publication_plan",
    "qa",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bucket_id": {"type": "string", "pattern": "^M2D-SBA-\\d{2}$"},
    "learner_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_knowledge_pct", "intrinsic_difficulty", "pathway"],
      "properties": {
        "prior_knowledge_pct": {"enum": [20, 50]},
        "intrinsic_difficulty": {"enum": ["D1", "D2", "D3", "D4"]},
        "pathway": {"enum": ["FOUNDATION_PATH", "QUICK_START_PATH"]}
      }
    },
    "source_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sba_registry", "publication_index", "core2_linkage", "profile_registry", "transfer_registry"],
      "properties": {
        "sba_registry": {"type": "string", "minLength": 1},
        "publication_index": {"type": "string", "minLength": 1},
        "core2_linkage": {"type": "string", "minLength": 1},
        "profile_registry": {"type": ["string", "null"]},
        "transfer_registry": {"type": ["string", "null"]}
      }
    },
    "primary_questions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^Q\\d{2}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "question_release": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "status", "routine_id", "release_prerequisite_buckets"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^Q\\d{2}$"},
          "status": {"enum": ["RELEASED", "HELD"]},
          "routine_id": {"type": ["string", "null"], "pattern": "^M2D-SBA-\\d{2}-R\\d+$"},
          "release_prerequisite_buckets": {
            "type": "array",
            "items": {"type": "string", "pattern": "^M2D-SBA-\\d{2}$"},
            "uniqueItems": true
          }
        }
      }
    },
    "question_load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "class", "minimum_transfer_families"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "class": {"enum": ["LOW", "MEDIUM", "HIGH", "VERY_HIGH"]},
        "minimum_transfer_families": {"type": "integer", "minimum": 1}
      }
    },
    "phase_gates": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "evidence"],
        "properties": {
          "gate": {"enum": [
            "G0_INDEX_SYNC",
            "G1_SOURCE_AND_CORE2_AUDIT",
            "G2_DIFFICULTY_AND_READINESS",
            "G3_LEARNING_ATOM_DECOMPOSITION",
            "G4_CORE2_HINT_PRETEACH_AUDIT",
            "G5_PROBLEM_FAMILY_ASSIMILATION",
            "G6_PAGE_PLAN",
            "G7_RENDER_AND_VISUAL_AUDIT",
            "G8_READINESS_AND_TRANSFER_AUDIT",
            "G9_MACHINE_QA_AND_HANDOFF"
          ]},
          "status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "PASS", "BLOCKED"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "learning_atoms": {
      "type": "array",
      "items": {"type": "string", "pattern": "^M2D-SBA-\\d{2}[A-Z]$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "transfer_routines": {
      "type": "array",
      "items": {"type": "string", "pattern": "^M2D-SBA-\\d{2}-R\\d+$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "publication_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_surface", "macro_order", "independent_practice_policy", "hint_delivery_policy", "readiness_gate_policy"],
      "properties": {
        "first_surface": {"const": "SBA_PUBLICATION_INDEX"},
        "macro_order": {
          "type": "array",
          "items": {"enum": [
            "SBA_INDEX",
            "FOUNDATION_PRETRAINING",
            "CONCEPT_BUILD",
            "PICTORIAL_STAGES",
            "PICTURE_TO_MATHS",
            "MISCONCEPTION",
            "WATCH_ONE",
            "COMPLETE_ONE",
            "PROBLEM_FAMILY_ROUTINES",
            "INDEPENDENT_PRACTICE",
            "HINTS",
            "READINESS",
            "CORE2_TRANSFER_SUMMARY"
          ]},
          "minItems": 8,
          "uniqueItems": true
        },
        "independent_practice_policy": {"const": "ATTEMPT_BEFORE_HINTS"},
        "hint_delivery_policy": {"enum": ["NEXT_PAGE", "COVER_BELOW_LINE", "INTERACTIVE_REVEAL"]},
        "readiness_gate_policy": {"const": "RECOGNISE_REPRESENT_FIRST_MOVE_FINISH"}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "primary_question_coverage_exact", "hint_preteach_complete", "visual_audit_complete", "pdf_preflight_complete", "ci_passed"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "primary_question_coverage_exact": {"type": "boolean"},
        "hint_preteach_complete": {"type": "boolean"},
        "visual_audit_complete": {"type": "boolean"},
        "pdf_preflight_complete": {"type": "boolean"},
        "ci_passed": {"type": "boolean"}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected_pdf_name", "expected_montage_name", "next_active_bucket", "notes"],
      "properties": {
        "status": {"enum": ["PLANNED", "IN_PROGRESS", "COMPLETE", "BLOCKED"]},
        "expected_pdf_name": {"type": "string", "minLength": 1},
        "expected_montage_name": {"type": "string", "minLength": 1},
        "next_active_bucket": {"type": ["string", "null"], "pattern": "^M2D-SBA-\\d{2}$"},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
