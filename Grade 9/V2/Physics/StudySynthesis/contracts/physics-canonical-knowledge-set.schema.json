{
  "$id": "physics-canonical-knowledge-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_knowledge_set_id": {"type": "string"},
    "canonical_semantic_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "refs": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "schema_version": {"const": "1.0.0"}
  },
  "required": ["schema_version", "canonical_knowledge_set_id", "canonical_semantic_digest", "refs"],
  "type": "object"
}
