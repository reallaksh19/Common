{
  "$id": "physics-study-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_inputs": {"maxItems": 0, "type": "array"},
    "entry_point_dependencies": {"type": "object"},
    "policy_id": {"const": "PHY-STUDY-POLICY-1"},
    "requirements_by_target": {"type": "object"},
    "schema_version": {"const": "1.0.0"},
    "target_rules": {"type": "object"},
    "version": {"type": "string"}
  },
  "required": ["schema_version", "policy_id", "version", "target_rules", "entry_point_dependencies", "requirements_by_target", "benchmark_inputs"],
  "type": "object"
}
