{
  "$id": "physics-teaching-primitive-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "genericity_statement": {
      "minLength": 1,
      "type": "string"
    },
    "primitives": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accessibility_pattern": {
            "minLength": 1,
            "type": "string"
          },
          "attention_target": {
            "minLength": 1,
            "type": "string"
          },
          "decorative": {
            "const": false
          },
          "instructional_job": {
            "minLength": 1,
            "type": "string"
          },
          "learner_action": {
            "minLength": 1,
            "type": "string"
          },
          "minimum_height_pt": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minimum_vector_ops": {
            "minimum": 1,
            "type": "integer"
          },
          "minimum_width_pt": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "primitive_id": {
            "minLength": 1,
            "type": "string"
          },
          "realized_as_vector_graphics": {
            "const": true
          },
          "renderer_binding": {
            "minLength": 1,
            "type": "string"
          },
          "renderer_constraints": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "required_render_params": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "schematic_fallback_allowed": {
            "type": "boolean"
          },
          "supports_compact_variant": {
            "type": "boolean"
          },
          "topic_scope_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "translation_obligation": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "accessibility_pattern",
          "attention_target",
          "decorative",
          "instructional_job",
          "learner_action",
          "minimum_height_pt",
          "minimum_vector_ops",
          "minimum_width_pt",
          "primitive_id",
          "realized_as_vector_graphics",
          "renderer_binding",
          "renderer_constraints",
          "required_render_params",
          "schematic_fallback_allowed",
          "supports_compact_variant",
          "topic_scope_refs",
          "translation_obligation"
        ],
        "type": "object"
      },
      "minItems": 10,
      "type": "array"
    },
    "quantitative_grounding_states": {
      "items": {
        "enum": [
          "SOURCE_QUANTITIES",
          "SCHEMATIC_STRUCTURE_ONLY"
        ]
      },
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "realization_rule": {
      "minLength": 1,
      "type": "string"
    },
    "registry_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "registry_id": {
      "minLength": 1,
      "type": "string"
    },
    "required_primitive_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 10,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "shared_library_ref": {
      "minLength": 1,
      "type": "string"
    },
    "size_contract_rule": {
      "minLength": 1,
      "type": "string"
    },
    "stable_render_interface": {
      "minLength": 1,
      "type": "string"
    },
    "subject": {
      "const": "PHYSICS"
    }
  },
  "required": [
    "genericity_statement",
    "primitives",
    "quantitative_grounding_states",
    "realization_rule",
    "registry_digest",
    "registry_id",
    "required_primitive_ids",
    "schema_version",
    "shared_library_ref",
    "size_contract_rule",
    "stable_render_interface",
    "subject"
  ],
  "title": "Physics P-H TeachingPrimitiveRegistry",
  "type": "object"
}
