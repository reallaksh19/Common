{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"physics-core1-lesson.schema.json",
  "type":"object","additionalProperties":false,
  "required":["lesson_id","capability_ref","treatment","source_scope_trace_item_refs","pck_asset_refs","promotion_status","problem_family_refs","system_frame_obligations","state_phase_obligations","model_validity_obligations","representation_requirements","verification_requirements","instructional_stages","equation_contract","graph_semantics","state_handoff","physical_verification","problem_authoring_plans","lesson_digest"],
  "properties":{
    "lesson_id":{"type":"string","pattern":"^PHY-P-G-LESSON-"},
    "capability_ref":{"type":"string","pattern":"^PHY-CAP-"},
    "treatment":{"enum":["READY_VERIFY_ONLY","ACTIVE_STUDY","REPAIR_BEFORE","REPAIR_IN_UNIT","PROBE_FIRST"]},
    "source_scope_trace_item_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "pck_asset_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^PHY-PCK-"}},
    "promotion_status":{"enum":["NOT_REQUIRED_FOR_TREATMENT","PRE_REVIEW_ONLY","PROMOTED"]},
    "problem_family_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^PHY-PF-"}},
    "system_frame_obligations":{"type":"array","minItems":1,"items":{"type":"object"}},
    "state_phase_obligations":{"type":"array","minItems":1,"items":{"type":"object"}},
    "model_validity_obligations":{"type":"array","minItems":1,"items":{"type":"object"}},
    "representation_requirements":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "verification_requirements":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "instructional_stages":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["stage","payload"],"properties":{"stage":{"type":"string"},"payload":{"type":"object"}}}},
    "equation_contract":{"type":"object","additionalProperties":false,"required":["applies","mode","see_equation","realize_terms","understand_origin","connect_transfer","unusual_features","explanation_deferred_until_probe"],"properties":{"applies":{"type":"boolean"},"mode":{"enum":["FULL_LEARNING","VERIFY_ONLY","PROBE_FIRST","NO_EQUATION"]},"see_equation":{"type":"array","items":{"type":"string"}},"realize_terms":{"type":"array","items":{"type":"string"}},"understand_origin":{"type":"array","items":{"type":"string"}},"connect_transfer":{"type":"array","items":{"type":"string"}},"unusual_features":{"type":"array","items":{"type":"string"}},"explanation_deferred_until_probe":{"type":"boolean"}}},
    "graph_semantics":{"type":"object","additionalProperties":false,"required":["required","operations","translation_chain"],"properties":{"required":{"type":"boolean"},"operations":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"translation_chain":{"type":"array","items":{"type":"string"}}}},
    "state_handoff":{"type":"object","additionalProperties":false,"required":["required","visible_terminal_to_next_initial"],"properties":{"required":{"type":"boolean"},"visible_terminal_to_next_initial":{"type":"boolean"}}},
    "physical_verification":{"type":"object","additionalProperties":false,"required":["checks"],"properties":{"checks":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "problem_authoring_plans":{"type":"array","items":{"type":"object"}},
    "lesson_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
