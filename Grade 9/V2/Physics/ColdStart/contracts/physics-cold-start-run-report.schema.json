{
  "$id": "physics-cold-start-run-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physics P-K ColdStartRunReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id", "schema_version", "subject", "run_mode", "manifest_ref", "manifest_digest",
    "input_custody", "assessment_truth", "stage_digests", "two_product_package",
    "runtime_dependency_audit", "authority_trace", "summary", "human_expert_review_states",
    "report_digest"
  ],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "PHYSICS"},
    "run_mode": {"enum": ["NO_ATTEMPT", "WITH_ATTEMPTS"]},
    "manifest_ref": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_set_digest", "declared_topic_scope_digest", "scope_authority_digest",
        "engineering_binding_registry_digest", "attempt_set_digest", "external_corpus_digest"
      ],
      "properties": {
        "question_set_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "declared_topic_scope_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scope_authority_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "engineering_binding_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attempt_set_digest": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        },
        "external_corpus_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "assessment_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_scope_digest", "engineering_readiness_digest", "engineering_consumer_status",
        "engineering_gate_requirement_state", "problem_semantics_digest", "study_scope_ref",
        "study_scope_digest", "required_capability_refs", "required_item_refs", "problem_family_refs",
        "physical_model_refs", "law_refs", "eligible_external_candidate_refs"
      ],
      "properties": {
        "assessment_scope_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "engineering_readiness_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "engineering_consumer_status": {"const": "ALLOWED"},
        "engineering_gate_requirement_state": {
          "enum": ["NOT_REQUIRED_FOR_THIS_SCOPE", "REQUIRED_AND_READY"]
        },
        "problem_semantics_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "study_scope_ref": {"type": "string", "minLength": 1},
        "study_scope_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "required_capability_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_item_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "problem_family_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "physical_model_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "law_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "eligible_external_candidate_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "stage_digests": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "two_product_package": {"$ref": "physics-two-product-package.schema.json"},
    "runtime_dependency_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_or_issue_history_used", "raw_pr156_used", "manual_precomputed_inputs_used", "runtime_reads"],
      "properties": {
        "chat_or_issue_history_used": {"const": false},
        "raw_pr156_used": {"const": false},
        "manual_precomputed_inputs_used": {"type": "array", "maxItems": 0},
        "runtime_reads": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority_trace": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_class", "authority_refs", "resolution"],
        "properties": {
          "decision_class": {"type": "string", "minLength": 1},
          "authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_count", "core1_lesson_count", "representation_count", "core2_page_count",
        "closure_state", "appendix_c_present", "total_vector_ops"
      ],
      "properties": {
        "capability_count": {"type": "integer", "minimum": 1},
        "core1_lesson_count": {"type": "integer", "minimum": 1},
        "representation_count": {"type": "integer", "minimum": 1},
        "core2_page_count": {"type": "integer", "minimum": 1},
        "closure_state": {"enum": ["CLOSED", "OPEN"]},
        "appendix_c_present": {"const": true},
        "total_vector_ops": {"type": "integer", "minimum": 1}
      }
    },
    "human_expert_review_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SUBJECT_EXPERT_PASS", "PEDAGOGY_EXPERT_PASS", "ASSESSMENT_EXPERT_PASS", "VISUAL_USABILITY_EXPERT_PASS"],
      "properties": {
        "SUBJECT_EXPERT_PASS": {"enum": ["PENDING", "FAIL"]},
        "PEDAGOGY_EXPERT_PASS": {"enum": ["PENDING", "FAIL"]},
        "ASSESSMENT_EXPERT_PASS": {"enum": ["PENDING", "FAIL"]},
        "VISUAL_USABILITY_EXPERT_PASS": {"enum": ["PENDING", "FAIL"]}
      }
    },
    "report_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
