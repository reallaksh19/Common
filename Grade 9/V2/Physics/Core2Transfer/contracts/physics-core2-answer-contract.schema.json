{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"physics-core2-answer-contract.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","answer_contract_id","question_id","answer_type","canonical_answer","solution_steps","verification_route","forbidden_hint_tokens"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "answer_contract_id":{"type":"string","pattern":"^CORE2-ANS-"},
    "question_id":{"type":"string","minLength":1},
    "answer_type":{"enum":["MCQ","NUMERIC","EXPRESSION"]},
    "canonical_answer":{"type":"string","minLength":1},
    "solution_steps":{"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "verification_route":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "forbidden_hint_tokens":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}
