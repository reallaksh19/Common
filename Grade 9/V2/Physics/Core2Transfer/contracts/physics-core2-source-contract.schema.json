{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"physics-core2-source-contract.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","source_contract_id","question_id","source_body","source_link","figure_semantics","source_digest","eligible","production_claim","provenance_note"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "source_contract_id":{"type":"string","pattern":"^CORE2-SRC-"},
    "question_id":{"type":"string","minLength":1},
    "source_body":{"type":"object","additionalProperties":false,"required":["stem","options"],"properties":{"stem":{"type":"string","minLength":1},"options":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "source_link":{"type":"string","minLength":1},
    "figure_semantics":{"type":"array","items":{"type":"string"}},
    "source_digest":{"type":"string","minLength":8},
    "eligible":{"const":true},
    "production_claim":{"type":"boolean"},
    "provenance_note":{"type":"string","minLength":1}
  }
}
