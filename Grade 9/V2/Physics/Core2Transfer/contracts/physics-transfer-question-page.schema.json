{
  "$id": "physics-transfer-question-page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer_ref": {
      "minLength": 1,
      "type": "string"
    },
    "answer_shown_with_the_question": {
      "const": false
    },
    "candidate_ref": {
      "minLength": 1,
      "type": "string"
    },
    "core1_linkage": {
      "$ref": "physics-core1-core2-linkage.schema.json"
    },
    "demand_score": {
      "minimum": 0,
      "type": "integer"
    },
    "demand_vector": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "figure_required": {
      "type": "boolean"
    },
    "figure_semantic": {
      "type": [
        "object",
        "null"
      ]
    },
    "final_answer": {
      "properties": {
        "answer_id": {
          "type": "string"
        },
        "answer_option_label": {
          "type": "string"
        },
        "authored_by_core2": {
          "const": false
        },
        "derived_from_source_key": {
          "const": true
        },
        "is_resolved_result": {
          "const": true
        },
        "source_answer_key": {
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "answer_id",
        "statement",
        "source_answer_key",
        "authored_by_core2",
        "is_resolved_result"
      ],
      "type": "object"
    },
    "first_step_reference_ref": {
      "minLength": 1,
      "type": "string"
    },
    "frame_sign_required": {
      "type": "boolean"
    },
    "guide_demand_badge": {
      "enum": [
        "GUIDED_TRANSFER",
        "SUPPORTED_TRANSFER",
        "INDEPENDENT_TRANSFER"
      ]
    },
    "hint_ladder": {
      "$ref": "physics-hint-ladder.schema.json"
    },
    "independent_verification": {
      "properties": {
        "is_answer": {
          "const": false
        },
        "is_distinct_from_solving_route": {
          "const": true
        }
      },
      "type": "object"
    },
    "model_validity_required": {
      "type": "boolean"
    },
    "options": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label",
          "text"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "page_id": {
      "minLength": 1,
      "type": "string"
    },
    "problem_family_ref": {
      "minLength": 1,
      "type": "string"
    },
    "quick_check": {
      "properties": {
        "is_answer": {
          "const": false
        }
      },
      "type": "object"
    },
    "reasoning_route": {
      "items": {
        "$ref": "physics-instance-route-state.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "representation_requirements": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "representation_states": {
      "items": {
        "properties": {
          "primitive_id": {
            "type": "string"
          },
          "quantitative_grounding": {
            "type": "string"
          },
          "render_params": {
            "type": "object"
          },
          "representation_requirement_ref": {
            "type": "string"
          },
          "representation_state_id": {
            "type": "string"
          },
          "source_figure_semantic_used": {
            "type": "boolean"
          }
        },
        "required": [
          "representation_state_id",
          "primitive_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "solution": {
      "$ref": "physics-solution-verification.schema.json"
    },
    "source_body_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_body_preserved": {
      "const": true
    },
    "source_link": {
      "minLength": 1,
      "type": "string"
    },
    "spatial_family": {
      "type": "boolean"
    },
    "stem": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "answer_ref",
    "answer_shown_with_the_question",
    "candidate_ref",
    "core1_linkage",
    "demand_score",
    "demand_vector",
    "figure_required",
    "figure_semantic",
    "final_answer",
    "first_step_reference_ref",
    "frame_sign_required",
    "guide_demand_badge",
    "hint_ladder",
    "independent_verification",
    "model_validity_required",
    "options",
    "page_id",
    "problem_family_ref",
    "quick_check",
    "reasoning_route",
    "representation_requirements",
    "solution",
    "source_body_digest",
    "source_body_preserved",
    "source_link",
    "spatial_family",
    "stem"
  ],
  "title": "Physics P-I TransferQuestionPage",
  "type": "object"
}
