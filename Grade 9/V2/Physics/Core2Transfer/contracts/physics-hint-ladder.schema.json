{
  "$id": "physics-hint-ladder.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "diagram_first": {
        "type": "boolean"
      },
      "figure": {
        "properties": {
          "primitive_id": {
            "type": "string"
          },
          "quantitative_grounding": {
            "type": "string"
          },
          "render_params": {
            "type": "object"
          }
        },
        "type": [
          "object",
          "null"
        ]
      },
      "hint_id": {
        "minLength": 1,
        "type": "string"
      },
      "intent": {
        "minLength": 1,
        "type": "string"
      },
      "level": {
        "enum": [
          "H1_NOTICE",
          "H2_MODEL",
          "H3_START"
        ]
      },
      "order": {
        "maximum": 3,
        "minimum": 1,
        "type": "integer"
      },
      "projected_route_role": {
        "enum": [
          "FRAME",
          "REPRESENT",
          "MODEL",
          "EXECUTE",
          "INTERPRET",
          "VERIFY"
        ]
      },
      "representation_state_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "reveals_relation": {
        "type": "boolean"
      },
      "reveals_result": {
        "const": false
      },
      "route_state_refs": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "text": {
        "minLength": 1,
        "type": "string"
      },
      "visual_role": {
        "enum": [
          "ATTENTION_CUE",
          "MODEL_REPRESENTATION",
          "FIRST_MOVE_OVERLAY"
        ]
      }
    },
    "required": [
      "hint_id",
      "intent",
      "level",
      "order",
      "projected_route_role",
      "reveals_relation",
      "reveals_result",
      "route_state_refs",
      "text",
      "visual_role"
    ],
    "type": "object"
  },
  "maxItems": 3,
  "minItems": 3,
  "title": "Physics P-I HintLadder",
  "type": "array"
}
