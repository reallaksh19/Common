{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-review-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_bundle_id",
    "schema_version",
    "subject",
    "question_set_ref",
    "question_set_digest",
    "review_registry_ref",
    "review_registry_digest",
    "diagnostic_use_policy_ref",
    "diagnostic_use_policy_digest",
    "review_precedes_attempt_interpretation",
    "attempt_data_consumed",
    "item_reviews",
    "summary",
    "bundle_digest"
  ],
  "properties": {
    "review_bundle_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "PHYSICS"
    },
    "question_set_ref": {
      "type": "string"
    },
    "question_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_registry_ref": {
      "type": "string"
    },
    "review_registry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic_use_policy_ref": {
      "type": "string"
    },
    "diagnostic_use_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_precedes_attempt_interpretation": {
      "const": true
    },
    "attempt_data_consumed": {
      "const": false
    },
    "item_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_count",
        "source_integrity_counts",
        "validity_counts",
        "diagnostic_use_counts"
      ],
      "properties": {
        "item_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_integrity_counts": {
          "type": "object"
        },
        "validity_counts": {
          "type": "object"
        },
        "diagnostic_use_counts": {
          "type": "object"
        }
      }
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
