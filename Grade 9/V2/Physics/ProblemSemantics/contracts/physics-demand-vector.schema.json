{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "level": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "dimension",
          "level",
          "rationale",
          "evidence_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "family_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "guide_badge_policy_ref": {
      "type": "string"
    },
    "item_ref": {
      "type": "string"
    },
    "psychometric_claim": {
      "const": false
    },
    "schema_version": {
      "type": "string"
    },
    "subject": {
      "const": "PHYSICS"
    },
    "vector_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "vector_id": {
      "type": "string"
    }
  },
  "required": [
    "vector_id",
    "schema_version",
    "subject",
    "item_ref",
    "family_refs",
    "dimensions",
    "guide_badge_policy_ref",
    "psychometric_claim",
    "vector_digest"
  ],
  "title": "PhysicsDemandVector",
  "type": "object"
}
