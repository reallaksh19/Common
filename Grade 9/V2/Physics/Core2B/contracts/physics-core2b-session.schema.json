{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"physics-core2b-session.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","session_id","subject","purpose","learner_profile_ref","core2a_binding","capability_bindings","item_overlays","retrieval_state"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "session_id":{"type":"string","pattern":"^PHY-C2B-"},
    "subject":{"const":"PHYSICS"},
    "purpose":{"enum":["FIRST_STUDY","PRACTICE","REVISION","COMPETITIVE_EXAM"]},
    "learner_profile_ref":{"type":"string","minLength":1},
    "core2a_binding":{"type":"object","additionalProperties":false,"required":["legal_pool_ref","legal_pool_digest"],"properties":{"legal_pool_ref":{"type":"string"},"legal_pool_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "capability_bindings":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["capability_ref","problem_family_ref","core1b_release_ref","core1b_release_digest","transfer_events"],"properties":{"capability_ref":{"type":"string"},"problem_family_ref":{"type":"string"},"core1b_release_ref":{"type":"string"},"core1b_release_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"transfer_events":{"type":"array","items":{"$ref":"#/$defs/transfer_event"}}}}},
    "item_overlays":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["core2a_item_ref","display_transfer_label","structural_distance","representation_change","model_discrimination","multi_step_bridge","synthesis","competitive_mixing","required_representation"],"properties":{"core2a_item_ref":{"type":"string"},"display_transfer_label":{"enum":["T0_DIRECT","T1_NEAR_TRANSFER","T2_REPRESENTATION_TRANSFER","T3_REVERSED_TARGET","T4_CONSTRAINT_TRANSFER","T5_DISCRIMINATION","T6_MULTI_STEP_BRIDGE","T7_SYNTHESIS","T8_COMPETITIVE_MIXED"]},"structural_distance":{"enum":["DIRECT","NEAR","REVERSED","CONSTRAINT"]},"representation_change":{"type":"boolean"},"model_discrimination":{"type":"boolean"},"multi_step_bridge":{"type":"boolean"},"synthesis":{"type":"boolean"},"competitive_mixing":{"type":"boolean"},"required_representation":{"type":["string","null"]}}}},
    "retrieval_state":{"$ref":"physics-core2b-retrieval-state.schema.json"}
  },
  "$defs":{"transfer_event":{"type":"object","additionalProperties":false,"required":["event_id","event_sequence","item_ref","outcome","dimensions","representation_used","hint_level_used","delayed_retrieval","evidence_ref","evidence_digest","event_digest"],"properties":{"event_id":{"type":"string","pattern":"^C2B-EVT-"},"event_sequence":{"type":"integer","minimum":1},"item_ref":{"type":"string"},"outcome":{"enum":["PASS","PARTIAL","FAIL"]},"dimensions":{"type":"array","uniqueItems":true,"items":{"enum":["STRUCTURAL_DISTANCE","REPRESENTATION_CHANGE","MODEL_DISCRIMINATION","MULTI_STEP_BRIDGE","SYNTHESIS","COMPETITIVE_MIXING"]}},"representation_used":{"type":["string","null"]},"hint_level_used":{"enum":["NO_HINT","RETRIEVAL_CUE","REPRESENTATION_CUE","MODEL_CUE","FIRST_MOVE_CUE","FULL_SOLUTION"]},"delayed_retrieval":{"type":"boolean"},"evidence_ref":{"type":"string"},"evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"event_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
}
