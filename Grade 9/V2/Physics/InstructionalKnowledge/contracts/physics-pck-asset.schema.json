{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-pck-asset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id","version","schema_version","subject","lifecycle_status","capability_refs","applicability_conditions","physical_anchor","system_frame_setup","representation_path","ordinary_language_bridge","model_validity_cue","relation_reconstruction_route","minimal_contrast","worked_example_family","common_wrong_model","misconception_discriminator","repair_route","verification_method","fading_dimensions","transfer_family","known_limitations","equation_features_to_explain","graph_semantics_required","state_handoff_required","provenance","review","asset_digest"],
  "properties": {
    "asset_id": {"type":"string","pattern":"^PHY-PCK-"},
    "version": {"type":"string"},
    "schema_version": {"const":"1.0.0"},
    "subject": {"const":"PHYSICS"},
    "lifecycle_status": {"const":"CANDIDATE"},
    "capability_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^PHY-CAP-"}},
    "applicability_conditions": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "physical_anchor": {"type":"string","minLength":1},
    "system_frame_setup": {"type":"object","additionalProperties":false,"required":["system_definition","frame_rule","sign_rule"],"properties":{"system_definition":{"type":"string","minLength":1},"frame_rule":{"type":"string","minLength":1},"sign_rule":{"type":"string","minLength":1}}},
    "representation_path": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "ordinary_language_bridge": {"type":"string","minLength":1},
    "model_validity_cue": {"type":"string","minLength":1},
    "relation_reconstruction_route": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "minimal_contrast": {"type":"object","additionalProperties":false,"required":["shared_structure","wrong_case","correct_case","prediction_prompt","decisive_feature"],"properties":{"shared_structure":{"type":"string","minLength":1},"wrong_case":{"type":"string","minLength":1},"correct_case":{"type":"string","minLength":1},"prediction_prompt":{"type":"string","minLength":1},"decisive_feature":{"type":"string","minLength":1}}},
    "worked_example_family": {"type":"string","minLength":1},
    "common_wrong_model": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "misconception_discriminator": {"type":"object","additionalProperties":false,"required":["probe","decisive_response"],"properties":{"probe":{"type":"string","minLength":1},"decisive_response":{"type":"string","minLength":1}}},
    "repair_route": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "verification_method": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
    "fading_dimensions": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "transfer_family": {"type":"string","minLength":1},
    "known_limitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "equation_features_to_explain": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "graph_semantics_required": {"type":"boolean"},
    "state_handoff_required": {"type":"boolean"},
    "provenance": {"type":"object","additionalProperties":false,"required":["evidence_class","source_refs","authoring_origin"],"properties":{"evidence_class":{"const":"REPOSITORY_AUTHORITY_PLUS_AI_ASSISTED_DRAFT"},"source_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"authoring_origin":{"const":"AI_ASSISTED_DRAFT"}}},
    "review": {"type":"object","additionalProperties":false,"required":["required_dimensions","status","human_review_evidence_refs"],"properties":{"required_dimensions":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["SUBJECT","PEDAGOGY"]}},"status":{"const":"PENDING_HUMAN_REVIEW"},"human_review_evidence_refs":{"type":"array","maxItems":0}}},
    "asset_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
