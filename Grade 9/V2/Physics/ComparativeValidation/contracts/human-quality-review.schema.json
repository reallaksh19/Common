{
  "$id": "https://common.local/physics/v2/human-quality-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "authority_class": {
            "const": "NO_AUTHORIZED_HUMAN_EVIDENCE"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "maxItems": 0
          },
          "reviewer_authority_refs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_class": {
            "const": "AUTHORIZED_HUMAN_REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          },
          "reviewer_authority_refs": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "authority_class": {
      "enum": [
        "NO_AUTHORIZED_HUMAN_EVIDENCE",
        "AUTHORIZED_HUMAN_REVIEW"
      ]
    },
    "candidate_artifact_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "quality_states": {
      "additionalProperties": false,
      "properties": {
        "PEDAGOGY_USABILITY": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "SUBJECT_CORRECTNESS": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        },
        "VISUAL_USABILITY": {
          "enum": [
            "PENDING",
            "PASS",
            "FAIL"
          ]
        }
      },
      "required": [
        "SUBJECT_CORRECTNESS",
        "PEDAGOGY_USABILITY",
        "VISUAL_USABILITY"
      ],
      "type": "object"
    },
    "reviewer_authority_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "candidate_artifact_sha256",
    "authority_class",
    "quality_states",
    "reviewer_authority_refs",
    "evidence_refs"
  ],
  "title": "Physics HumanQualityReview interface",
  "type": "object"
}
