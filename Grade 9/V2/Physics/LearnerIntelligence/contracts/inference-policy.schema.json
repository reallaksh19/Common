{
  "$id": "inference-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "ready_min_independent_valid_attempts", "repair_required_min_independent_invalid_attempts", "ambiguity_probe_map", "forbidden_inferences", "benchmark_inputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "ready_min_independent_valid_attempts": {"type": "integer", "minimum": 1},
    "repair_required_min_independent_invalid_attempts": {"type": "integer", "minimum": 2},
    "ambiguity_probe_map": {"type": "object", "propertyNames": {"pattern": "^PHY-[A-Z0-9-]+$"}, "additionalProperties": {"type": "string", "pattern": "^PHY-PROBE-[A-Z0-9-]+$"}},
    "forbidden_inferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "benchmark_inputs": {"type": "array", "maxItems": 0}
  }
}
