{
  "$id": "capability-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguous_attempt_count": {"minimum": 0, "type": "integer"},
    "capability_ref": {"pattern": "^PHY-[A-Z0-9-]+$", "type": "string"},
    "evidence_refs": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "evidence_status": {"enum": ["NONE", "DEMONSTRATED", "SUSPECTED", "AMBIGUOUS", "CORROBORATED"]},
    "invalid_attempt_count": {"minimum": 0, "type": "integer"},
    "misconception_status": {"enum": ["NONE", "SUSPECTED", "AMBIGUOUS"]},
    "positive_attempt_count": {"minimum": 0, "type": "integer"},
    "probe_refs": {"items": {"pattern": "^PHY-PROBE-[A-Z0-9-]+$", "type": "string"}, "type": "array", "uniqueItems": true},
    "state": {"enum": ["UNKNOWN", "DEVELOPING", "READY", "REPAIR_REQUIRED"]}
  },
  "required": ["capability_ref", "state", "evidence_status", "positive_attempt_count", "invalid_attempt_count", "ambiguous_attempt_count", "evidence_refs", "probe_refs", "misconception_status"],
  "type": "object"
}
