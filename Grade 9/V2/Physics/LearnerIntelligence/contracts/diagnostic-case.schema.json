{
  "$id": "diagnostic-case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "broad_topic_conclusion": {"const": false},
    "case_type": {"enum": ["LOCALIZED_FAILURE", "AMBIGUITY", "EXTERNAL_DEPENDENCY"]},
    "diagnostic_case_id": {"type": "string"},
    "evidence_refs": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "probe_refs": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "status": {"enum": ["SUSPECTED", "CORROBORATED", "PROBE_REQUIRED", "EXTERNAL"]},
    "target_ref": {"type": "string"}
  },
  "required": ["diagnostic_case_id", "case_type", "target_ref", "evidence_refs", "status", "probe_refs", "broad_topic_conclusion"],
  "type": "object"
}
