  "pedagogy_model": "SEE_REALIZE_UNDERSTAND",
  "genericity_statement": "Primary PCK family is derived from the structural obligations carried by each P-F capability record. No capability id, topic id or problem-family id is hard-coded into family selection, so a new Physics topic enters as data and never as a new schema or a new selection branch.",
  "lesson_mode_by_treatment": {
    "ACTIVE_STUDY": "FULL_LEARNING",
    "REPAIR_BEFORE": "FULL_LEARNING",
    "REPAIR_IN_UNIT": "FULL_LEARNING",
    "READY_VERIFY_ONLY": "CONCISE_VERIFY_ONLY",
    "PROBE_FIRST": "PROBE"
  },
  "content_roles_by_mode": {
    "FULL_LEARNING": [
      "SEE_PHENOMENON_ANCHOR",
      "SEE_SYSTEM_FRAME_SIGN",
      "REALIZE_REPRESENTATION",
      "REALIZE_RECONSTRUCTION",
