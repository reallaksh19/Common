    "PROBE": [
      "SEE_ACTIVATION",
      "DECISIVE_DIAGNOSTIC_PROBE",
      "BRANCH_AFTER_PROBE"
    ]
  },
  "family_selection_rules": [
    {
      "rule_id": "R-GRAPH",
      "when": {"any_representation_requirement_substring": ["GRAPH", "SIGNED_AREA"]},
      "family": "GRAPH_SLOPE_AREA_DECODING"
    },
    {
      "rule_id": "R-PHASE",
      "when": {"multiphase": true},
      "family": "PHASE_CONTINUITY_REASONING"
    },
    {
      "rule_id": "R-MODEL-VALIDITY",
      "when": {"model_validity_required": true},
      "family": "MODEL_SELECTION_AND_VALIDITY"
    },
    {
      "rule_id": "R-VECTOR",
      "when": {"any_representation_requirement": ["MOTION_VECTOR_DIAGRAM", "RELATIVE_STATE_DIAGRAM"]},
      "family": "VECTOR_COMPONENT_DECOMPOSITION"
    },
    {
      "rule_id": "R-FRAME-SIGN",
      "when": {"frame_or_sign_required": true},
      "family": "SYSTEM_FRAME_SIGN_SETUP"
    },
    {
      "rule_id": "R-RELATION",
      "when": {"any_representation_requirement": ["EQUATION_STATE_RELATION", "STATE_TABLE", "TIMELINE_INTERVAL", "RATE_TABLE"]},
      "family": "RELATION_RECONSTRUCTION"
    },
    {
      "rule_id": "R-REPRESENTATION",
      "when": {"has_representation_requirement": true},
      "family": "STATE_REPRESENTATION_TRANSLATION"
    },
    {
      "rule_id": "R-DEFAULT",
      "when": {},
      "family": "PHENOMENON_ANCHOR"
    }
  ],
  "support_pck_families": [
    "PHENOMENON_ANCHOR",
