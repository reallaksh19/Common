{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"physics-core1-answer-contract.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","answer_contract_id","authored_problem_id","canonical_result","reasoning_steps","verification_route","units_or_dimensions_check"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "answer_contract_id":{"type":"string","pattern":"^CORE1-ANS-"},
    "authored_problem_id":{"type":"string","pattern":"^CORE1-PROB-"},
    "canonical_result":{"type":"string","minLength":1},
    "reasoning_steps":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "verification_route":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "units_or_dimensions_check":{"type":"string","minLength":1}
  }
}
