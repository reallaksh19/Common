{
  "schema_version": "1.0.0",
  "policy_id": "PHY-B-LAYER-RUNTIME-BOUNDARY-v1",
  "status": "DRAFT_GOVERNANCE",
  "role_split": {
    "a_layers_authorize": true,
    "b_layers_execute": true,
    "b_layers_may_not_change_physics_truth": true,
    "b_layers_may_not_expand_transfer_legality": true,
    "b_layers_may_capture_observed_learner_evidence": true
  },
  "receipt_semantics": {
    "core1a_authority_release": "AUTHORIZES_WHAT_MAY_BE_TAUGHT",
    "core1b_exposure_receipt": "PROVES_RUNTIME_EXPOSURE_NOT_MASTERY",
    "observed_learner_evidence": "MAY_UPDATE_CONTROL_STATE_WITH_PROVENANCE",
    "core2a_legal_pool": "AUTHORIZES_WHICH_TRANSFER_ITEMS_ARE_LEGAL",
    "core2b_attempt_receipt": "OBSERVED_RUNTIME_EVIDENCE_NOT_LEGALITY"
  },
  "handoffs": {
    "core1a_to_core1b_requires_release_ref_and_digest": true,
    "core2a_to_core2b_requires_legal_pool_ref_and_digest": true,
    "core2b_item_requires_exact_core2a_item_ref": true,
    "b_to_control_requires_observed_evidence": true,
    "core2b_to_core1b_repair_is_request_only": true
  },
  "learner_evidence": {
    "allowed_basis": ["LEARNER_RESPONSE", "DIAGNOSTIC", "TEACHER_OBSERVATION"],
    "forbidden_basis": ["UNIT_READINESS_FLAG", "TEACHING_RECEIPT", "AUTHOR_CONFIG", "SIMULATED_PASS"],
    "state_may_not_be_synthesized_from_unit_configuration": true,
    "evidence_ref_and_digest_required": true,
    "append_only": true
  },
  "transfer_selection": {
    "single_session_state_insufficient": true,
    "per_required_capability_state_required": true,
    "all_required_capabilities_must_meet_item_floor": true,
    "representation_transfer_requires_matching_observed_representation_evidence": true,
    "scalar_transfer_rank_may_not_be_sole_authorizer": true,
    "discrimination_and_synthesis_are_independent_dimensions": true,
    "transfer_dimensions": ["STRUCTURAL_DISTANCE", "REPRESENTATION_CHANGE", "MODEL_DISCRIMINATION", "MULTI_STEP_BRIDGE", "SYNTHESIS", "COMPETITIVE_MIXING"],
    "purpose_cannot_expand_core2a_legal_pool": true,
    "retrieval_due_cannot_expand_core2a_legal_pool": true
  },
  "repair_loop": {
    "wrong_answer_is_not_diagnosis": true,
    "repair_smallest_explanatory_prerequisite_set": true,
    "repair_request_may_not_mutate_core1a_authority": true,
    "repair_request_may_not_mutate_core2a_legality": true,
    "return_to_original_target_after_repair": true
  }
}
