{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-request.schema.json",
  "title": "Physics Engineering Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "subject",
    "requested_topic",
    "requested_scope",
    "engineering_depth",
    "requested_action",
    "requested_for"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^ENG-REQ-[A-Z0-9-]+$"},
    "subject": {"const": "PHYSICS"},
    "requested_topic": {"type": "string", "minLength": 2},
    "requested_scope": {"type": "string", "minLength": 2},
    "engineering_depth": {"enum": ["FOUNDATION", "STANDARD", "RESEARCH"]},
    "requested_action": {"const": "AUTO_DISCOVER"},
    "curriculum_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grades": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 13}},
        "curriculum": {"type": "string", "minLength": 1},
        "exam_family": {"type": "string", "minLength": 1}
      }
    },
    "requested_for": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "notes": {"type": "string"}
  }
}
