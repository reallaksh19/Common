{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-engineering-discovery-catalog.schema.json",
  "title": "Physics Engineering Discovery Coverage Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "source_snapshot", "control_plane", "stress_test_policy", "discovered_subtopics", "v3_native_or_refined_gate_ids"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {"type": "string", "pattern": "^PHYSICS-ENGINEERING-DISCOVERY-[A-Z0-9-]+$"},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pr_number", "head_sha", "declared_subtopic_count", "role", "source_refs"],
      "properties": {
        "repository": {"const": "reallaksh19/Common"},
        "pr_number": {"const": 383},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "declared_subtopic_count": {"type": "integer", "minimum": 1},
        "role": {"const": "DISCOVERY_COVERAGE_INPUT_NOT_READINESS_AUTHORITY"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_registry_ref", "readiness_rule", "case_specific_overrides"],
      "properties": {
        "canonical_registry_ref": {"const": "GENERATED:physics-technical-engineering-gates.v3"},
        "readiness_rule": {"const": "DERIVED_BY_PRODUCTION_V3_VALIDATOR"},
        "case_specific_overrides": {"const": "PROHIBITED"}
      }
    },
    "stress_test_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_artifacts_role", "may_define_gate_logic", "may_promote_source_custody"],
      "properties": {
        "case_artifacts_role": {"const": "STRESS_TEST_ONLY"},
        "may_define_gate_logic": {"const": false},
        "may_promote_source_custody": {"const": false}
      }
    },
    "discovered_subtopics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discovery_gate_id", "curriculum", "jee_tier", "disposition", "v3_gate_ids"],
        "properties": {
          "discovery_gate_id": {"type": "string", "pattern": "^PHY-[A-Z0-9]+-[A-Z0-9-]+$"},
          "curriculum": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grade", "chapter"],
            "properties": {
              "grade": {"type": "integer", "minimum": 1, "maximum": 12},
              "chapter": {"type": "string", "minLength": 1}
            }
          },
          "jee_tier": {"enum": ["NOT_IN_JEE", "JEE_MAINS", "JEE_ADVANCED", "BOTH"]},
          "disposition": {"enum": ["EXACT_V3_ID", "MAPPED_V3", "MIGRATION_REQUIRED"]},
          "v3_gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PHY-[A-Z0-9]+-[A-Z0-9-]+$"}},
          "mapping_review_ref": {"type": "string", "pattern": "^provenance/pr383/mapping-reviews/[A-Za-z0-9._-]+\\.json$"}
        },
        "allOf": [
          {"if": {"properties": {"disposition": {"const": "EXACT_V3_ID"}}}, "then": {"properties": {"v3_gate_ids": {"minItems": 1, "maxItems": 1}}}},
          {"if": {"properties": {"disposition": {"const": "MAPPED_V3"}}}, "then": {"required": ["mapping_review_ref"], "properties": {"v3_gate_ids": {"minItems": 1}}}},
          {"if": {"properties": {"disposition": {"const": "MIGRATION_REQUIRED"}}}, "then": {"properties": {"v3_gate_ids": {"maxItems": 0}}}}
        ]
      }
    },
    "v3_native_or_refined_gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PHY-[A-Z0-9]+-[A-Z0-9-]+$"}}
  }
}
