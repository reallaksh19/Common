{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint-execution-route-registry.schema.json",
  "title": "Physics Blueprint Execution Route Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "subject",
    "selector_semantics",
    "label_inference_allowed",
    "routes",
    "registry_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "subject": {"const": "PHYSICS"},
    "selector_semantics": {"const": "OPAQUE_EXACT_ROUTE_ID"},
    "label_inference_allowed": {"const": false},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "status", "entry_phase", "inputs"],
        "properties": {
          "route_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]*$"},
          "status": {"const": "ACTIVE"},
          "entry_phase": {"const": "P-A AssessmentIntake"},
          "inputs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "required", "path"],
              "properties": {
                "role": {"enum": ["QUESTION_SET", "DECLARED_TOPIC_SCOPE", "ATTEMPT_SET"]},
                "required": {"type": "boolean"},
                "path": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
