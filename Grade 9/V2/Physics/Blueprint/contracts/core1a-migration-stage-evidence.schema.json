{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core1a-migration-stage-evidence.schema.json",
  "title": "Core1A Migration Stage Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "bucket_id",
    "stage",
    "evidence_state",
    "source_refs",
    "artifact_refs",
    "evidence_refs",
    "unresolved_requirements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "bucket_id": {"type": "string", "minLength": 1},
    "stage": {
      "enum": [
        "1A0_LEARNER_STATE_GAP",
        "1A1_LEARNING_ATOMS",
        "1A2_INFERENTIAL_JUMPS",
        "1A3_COGNITIVE_TRANSFORMATION",
        "1A4_REPRESENTATION_REQUIREMENTS",
        "1A5_REPRESENTATION_CANDIDATES",
        "1A6_REPRESENTATION_DECISIONS",
        "1A7_PICTURE_WORD_SYMBOL_EQUATION_BRIDGE",
        "1A8_MISCONCEPTION_CONTRAST",
        "1A9_WORKED_FADED_INDEPENDENT_PLAN",
        "1A10_CORE2_TRANSFER_BRIDGE",
        "1A11_UNRESOLVED_JUMP_AUDIT"
      ]
    },
    "evidence_state": {"enum": ["PARTIAL", "PRESENT"]},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_state": {"const": "PRESENT"}}},
      "then": {"properties": {"unresolved_requirements": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"evidence_state": {"const": "PARTIAL"}}},
      "then": {"properties": {"unresolved_requirements": {"minItems": 1}}}
    }
  ]
}
