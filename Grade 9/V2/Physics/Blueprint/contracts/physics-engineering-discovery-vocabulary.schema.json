{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-engineering-discovery-vocabulary.schema.json",
  "title": "PhysicsEngineeringDiscoveryVocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "catalog_id",
    "authority",
    "technical_authorization",
    "publication_authorization",
    "registry_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "PHYSICS"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^PHY-ENG-DISC-VOCAB-[A-Z0-9_-]+$"
    },
    "authority": {
      "const": "NON_AUTHORITATIVE_DISCOVERY_VOCABULARY"
    },
    "technical_authorization": {
      "const": "NOT_EVALUATED"
    },
    "publication_authorization": {
      "const": "NOT_IMPLIED"
    },
    "registry_id": {
      "const": "PHY-G9-11-TECHNICAL-ENGINEERING-GATES-v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_scope_kind",
          "target_scope_ref",
          "terms"
        ],
        "properties": {
          "target_scope_kind": {
            "enum": [
              "ENGINEERING_GATE"
            ]
          },
          "target_scope_ref": {
            "type": "string",
            "minLength": 3
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phrase",
                "term_class"
              ],
              "properties": {
                "phrase": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 160
                },
                "term_class": {
                  "enum": [
                    "LEARNER_ALIAS",
                    "COMPETITION_TERM",
                    "TECHNICAL_TERM",
                    "NOTATION_NAME",
                    "COMMON_ABBREVIATION",
                    "REGIONAL_VARIANT",
                    "MISCONCEPTION_ALIAS"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
