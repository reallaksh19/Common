{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/physics/core-differentiation-adaptation-unit.schema.json",
  "title": "Physics Core Differentiation and Adaptation Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cdau_id",
    "bucket_id",
    "capability_id",
    "problem_family_id",
    "domain_authority",
    "core_purpose_contract",
    "content_lineage",
    "example_fingerprint",
    "owner_control",
    "routing_target"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "cdau_id": {"type": "string", "minLength": 1},
    "bucket_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "problem_family_id": {"type": "string", "minLength": 1},
    "domain_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ground_truth_ref", "core1_ref", "core2_ref", "join_ref", "may_rewrite_source_truth"],
      "properties": {
        "ground_truth_ref": {"type": "string", "minLength": 1},
        "core1_ref": {"type": "string", "minLength": 1},
        "core2_ref": {"type": "string", "minLength": 1},
        "join_ref": {"type": "string", "minLength": 1},
        "may_rewrite_source_truth": {"const": false}
      }
    },
    "core_purpose_contract": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "purpose", "dominant_mode", "learner_actions", "prohibited_modes"],
        "properties": {
          "layer": {"enum": ["CORE1", "CORE1A", "CORE1B", "CORE2", "CORE2A", "CORE2B"]},
          "purpose": {"type": "string", "minLength": 1},
          "dominant_mode": {"enum": ["ORIENTATION", "DECLARATIVE", "GENERATIVE", "FROZEN_SOURCE", "WORKED_PROBLEM", "TRANSFER"]},
          "learner_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "prohibited_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "content_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_assets", "layer_usages", "cross_core_relationship", "duplication_classification"],
      "properties": {
        "canonical_assets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["asset_id", "asset_type"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "asset_type": {"enum": ["CONCEPT", "EQUATION", "REPRESENTATION", "MISCONCEPTION", "PROBLEM_FAMILY", "SOURCE_ITEM", "EXAMPLE"]}
            }
          }
        },
        "layer_usages": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["layer", "asset_id", "usage_mode", "transformation_note"],
            "properties": {
              "layer": {"enum": ["CORE1", "CORE1A", "CORE1B", "CORE2", "CORE2A", "CORE2B"]},
              "asset_id": {"type": "string", "minLength": 1},
              "usage_mode": {"enum": ["REFERENCE", "EXPLAIN", "DERIVE", "WORKED_EXEMPLAR", "COMPARE", "COMPLETE", "RECONSTRUCT", "SELECT", "DISCRIMINATE", "DIAGNOSE", "RETRIEVE", "TRANSFER", "VERIFY"]},
              "transformation_note": {"type": "string", "minLength": 1}
            }
          }
        },
        "cross_core_relationship": {"enum": ["SEMANTIC_REUSE", "PEDAGOGICAL_TRANSFORMATION", "FADING_ANCHOR", "STRUCTURAL_SIBLING", "FAR_TRANSFER_SIBLING", "NEAR_DUPLICATE", "PEDAGOGICAL_DUPLICATION"]},
        "duplication_classification": {
          "type": "object", "additionalProperties": false,
          "required": ["release_allowed", "reason"],
          "properties": {
            "release_allowed": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "example_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "givens", "numeric_values", "target_unknown", "representation", "model_sequence", "special_condition", "solution_path"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "givens": {"type": "array", "items": {"type": "string"}},
        "numeric_values": {"type": "array", "items": {"type": "string"}},
        "target_unknown": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "model_sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "special_condition": {"type": "string"},
        "solution_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "owner_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["override_present", "system_finding", "owner_decision", "final_action", "bounded_authority"],
      "properties": {
        "override_present": {"type": "boolean"},
        "system_finding": {"type": "string", "minLength": 1},
        "owner_decision": {"type": "string", "minLength": 1},
        "final_action": {"type": "string", "minLength": 1},
        "bounded_authority": {
          "type": "object", "additionalProperties": false,
          "required": ["may_change_product_routing", "may_change_source_truth", "may_change_observed_evidence", "may_expand_legal_pool"],
          "properties": {
            "may_change_product_routing": {"const": true},
            "may_change_source_truth": {"const": false},
            "may_change_observed_evidence": {"const": false},
            "may_expand_legal_pool": {"const": false}
          }
        }
      }
    },
    "routing_target": {"enum": ["SDU", "LAU"]}
  }
}