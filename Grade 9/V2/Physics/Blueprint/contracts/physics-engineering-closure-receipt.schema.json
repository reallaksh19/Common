{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-engineering-closure-receipt.schema.json",
  "title": "PhysicsEngineeringClosureReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "receipt_id",
    "request_id",
    "manifest_id",
    "registry_id",
    "registry_digest",
    "validator_contract_digest",
    "resolution_mode",
    "scope_refs",
    "direct_gate_ids",
    "transitive_gate_ids",
    "gate_states",
    "counts",
    "closure_status",
    "technical_authorization",
    "publication_authorization"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "PHYSICS"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^PHY-ENG-CLOSURE-[A-Z0-9_-]+$"
    },
    "request_id": {
      "type": "string"
    },
    "manifest_id": {
      "type": "string"
    },
    "registry_id": {
      "enum": [
        "PHY-G9-11-TECHNICAL-ENGINEERING-GATES-v1",
        "REG-PHY-TECH-GATE-V1"
      ]
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "validator_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resolution_mode": {
      "enum": [
        "GATE_IDENTITY",
        "REGISTRY_LINKED_BUCKET"
      ]
    },
    "scope_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "direct_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "transitive_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "gate_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "authoritative_technical_readiness",
          "source_scope",
          "blueprint_admissible",
          "failure_codes"
        ],
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "authoritative_technical_readiness": {
            "enum": [
              "ENGINEERING_GATE_READY",
              "ENGINEERING_GATE_INCOMPLETE"
            ]
          },
          "source_scope": {
            "type": "string"
          },
          "blueprint_admissible": {
            "type": "boolean"
          },
          "failure_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_gate_count",
        "transitive_gate_count",
        "ready_gate_count",
        "blocked_gate_count"
      ],
      "properties": {
        "direct_gate_count": {
          "type": "integer",
          "minimum": 1
        },
        "transitive_gate_count": {
          "type": "integer",
          "minimum": 1
        },
        "ready_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_gate_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "closure_status": {
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "technical_authorization": {
      "enum": [
        "ALLOWED",
        "BLOCKED"
      ]
    },
    "publication_authorization": {
      "const": "NOT_IMPLIED"
    }
  },
  "": "physics-engineering-closure-receipt.schema.json"
}