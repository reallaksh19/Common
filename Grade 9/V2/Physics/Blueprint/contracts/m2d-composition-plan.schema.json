{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-m2d-composition-plan.schema.json",
  "title": "Physics Motion in a Plane Composition Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","composition_plan_id","topic_id","chapter_plan_digest",
    "representation_readiness_digest","manuscript_release","sections","summary","composition_plan_digest"
  ],
  "properties": {
    "schema_version":{"const":"1.0.0"},
    "composition_plan_id":{"type":"string","pattern":"^M2D-COMPOSITION-PLAN-"},
    "topic_id":{"const":"PHY-M2D"},
    "chapter_plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "representation_readiness_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "manuscript_release": {
      "oneOf": [
        {"type":"null"},
        {
          "type":"object","additionalProperties":false,
          "required":["binding_id","stage_run_ref","stage_run_digest","provenance_class"],
          "properties":{
            "binding_id":{"type":"string","pattern":"^M2D-MANUSCRIPT-RELEASE-"},
            "stage_run_ref":{"type":"string","pattern":"^C1A-RUN-PHY-"},
            "stage_run_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
            "provenance_class":{"const":"REPOSITORY_PRODUCTION"}
          }
        }
      ]
    },
    "sections": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":[
          "section_id","order","concept_id","learner_title","semantic_ref","semantic_digest",
          "difficulty","source_group_refs","equation_refs","core2_challenge_refs",
          "illustration_archetype","authorized_representation_refs","page_intent"
        ],
        "properties":{
          "section_id":{"type":"string","pattern":"^M2D-COMP-[0-9]{2}$"},
          "order":{"type":"integer","minimum":1},
          "concept_id":{"type":"string","minLength":1},
          "learner_title":{"type":"string","minLength":1},
          "semantic_ref":{"type":"string","pattern":"^C1A-M2D-CONCEPT:"},
          "semantic_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "difficulty":{"enum":["D1","D2","D3","D4"]},
          "source_group_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "equation_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "core2_challenge_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "illustration_archetype":{"type":"string","minLength":1},
          "authorized_representation_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
          "page_intent":{"const":"TEACH_REPRESENT_PRACTISE_TRANSFER"}
        }
      }
    },
    "summary":{
      "type":"object","additionalProperties":false,
      "required":[
        "concept_count","mapped_concept_count","representation_status","manuscript_release_status",
        "composition_status","publication_ir_gate","renderer_invocation_allowed","release_authorized",
        "block_reasons","next_action"
      ],
      "properties":{
        "concept_count":{"type":"integer","minimum":1},
        "mapped_concept_count":{"type":"integer","minimum":0},
        "representation_status":{"enum":["READY_FOR_RENDER_ADAPTER","BLOCKED_REPRESENTATION_GAP"]},
        "manuscript_release_status":{"enum":["ABSENT","BOUND_REPOSITORY_PRODUCTION"]},
        "composition_status":{"enum":["BLOCKED_REPRESENTATION_GAP","BLOCKED_UPSTREAM_MANUSCRIPT_RELEASE","READY_FOR_PUBLICATION_IR"]},
        "publication_ir_gate":{"enum":["BLOCKED","OPEN"]},
        "renderer_invocation_allowed":{"const":false},
        "release_authorized":{"const":false},
        "block_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "next_action":{"enum":["CLOSE_REPRESENTATION_GAPS","MIGRATE_REAL_CORE1A_STAGE_RELEASE","COMPILE_PUBLICATION_IR"]}
      }
    },
    "composition_plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}