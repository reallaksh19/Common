{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-packet-envelope.schema.json",
  "title": "Physics Blueprint Packet Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "packet_type",
    "schema_version",
    "topic_id",
    "subtopic_ids",
    "producer_role",
    "producer_run_id",
    "producer_instance_id",
    "ground_truth_refs",
    "dependencies",
    "confidence",
    "validation_status",
    "unresolved_issues",
    "payload"
  ],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "packet_type": {
      "enum": [
        "GT_GROUND_TRUTH",
        "R_ROUTING",
        "G_EVIDENCE_GAP",
        "K_SEMANTIC",
        "EA_EQUATION_ASSIMILATION",
        "D_ASSESSMENT",
        "V_VALIDATION",
        "J_JOIN",
        "LS_LEARNER_STATE",
        "PUR_PURPOSE",
        "OVR_OWNER_OVERRIDE",
        "A_ASSIMILATION",
        "T_TAUGHT_STATE",
        "X_CORE2A_PLACEHOLDER"
      ]
    },
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "topic_id": {"type": "string", "minLength": 1},
    "subtopic_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "producer_role": {"enum": ["CORE0", "CORE1", "CORE2", "JOIN", "CORE1A", "CORE2A", "GOVERNOR"]},
    "producer_run_id": {"type": "string", "minLength": 1},
    "producer_instance_id": {"type": "string", "minLength": 1},
    "ground_truth_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "NOT_APPLICABLE"]},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "validation_status": {"enum": ["UNVALIDATED", "VALIDATED", "PARTIALLY_VALIDATED", "CONTRADICTED", "BLOCKED"]},
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "state", "description"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["UNKNOWN", "AMBIGUOUS", "CONTRADICTED", "ABSENT_EVIDENCE", "OUT_OF_SCOPE"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "payload": {"type": "object"}
  }
}
