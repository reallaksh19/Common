{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-passport-v2.schema.json",
  "title": "Subject Engineering Passport Diagnostic v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "passport_id", "request_id", "manifest_id", "closure_receipt_id", "closure_receipt_digest",
    "registry_ref", "registry_digest", "requested_topic", "requested_scope", "engineering_depth", "technical_state",
    "direct_gate_count", "transitive_gate_count", "ready_gate_count", "blocked_gate_count", "gate_states",
    "technical_coverage", "fragility_hotspots", "direct_gate_profiles", "source_item_status",
    "consumer_authorization", "publication_authorization", "next_action"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "passport_id": {"type": "string", "pattern": "^ENG-PASS-[A-Z0-9-]+$"},
    "request_id": {"type": "string", "pattern": "^ENG-REQ-[A-Z0-9-]+$"},
    "manifest_id": {"type": "string", "pattern": "^ENG-MAN-[A-Z0-9-]+$"},
    "closure_receipt_id": {"type": "string", "pattern": "^ENG-CLOSURE-[A-Z0-9-]+$"},
    "closure_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registry_ref": {"type": "string", "minLength": 1},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_topic": {"type": "string", "minLength": 2},
    "requested_scope": {"type": "string", "minLength": 2},
    "engineering_depth": {"enum": ["FOUNDATION", "STANDARD", "RESEARCH"]},
    "technical_state": {"enum": ["ENGINEERING_READY", "BLOCKED_PENDING_ENGINEERING"]},
    "direct_gate_count": {"type": "integer", "minimum": 1},
    "transitive_gate_count": {"type": "integer", "minimum": 0},
    "ready_gate_count": {"type": "integer", "minimum": 0},
    "blocked_gate_count": {"type": "integer", "minimum": 0},
    "gate_states": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate_id","status","direct"], "properties": {"gate_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"}, "status": {"enum": ["ENGINEERING_GATE_READY","ENGINEERING_GATE_INCOMPLETE","SOURCE_SCOPE_HELD","MISSING"]}, "direct": {"type": "boolean"}}}},
    "technical_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["concepts", "relations", "model_conditions", "representations", "reasoning_steps", "transformations", "misconceptions", "verifications", "problem_families"],
      "properties": {
        "concepts": {"$ref": "#/$defs/coverage"}, "relations": {"$ref": "#/$defs/coverage"}, "model_conditions": {"$ref": "#/$defs/coverage"},
        "representations": {"$ref": "#/$defs/coverage"}, "reasoning_steps": {"$ref": "#/$defs/coverage"}, "transformations": {"$ref": "#/$defs/coverage"},
        "misconceptions": {"$ref": "#/$defs/coverage"}, "verifications": {"$ref": "#/$defs/coverage"}, "problem_families": {"$ref": "#/$defs/coverage"}
      }
    },
    "fragility_hotspots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "hotspot_type", "ref", "level", "description"], "properties": {"gate_id": {"type": "string"}, "hotspot_type": {"enum": ["INFERENTIAL_JUMP", "DIFFICULTY_DIMENSION"]}, "ref": {"type": "string"}, "level": {"type": "integer", "minimum": 3, "maximum": 3}, "description": {"type": "string", "minLength": 3}}}},
    "direct_gate_profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "provisional_badge", "maturity", "dimensions"], "properties": {"gate_id": {"type": "string"}, "provisional_badge": {"enum": ["EASY", "MEDIUM", "HARD"]}, "maturity": {"const": "ENGINEERING"}, "dimensions": {"type": "object"}}}},
    "source_item_status": {"enum": ["INDEPENDENT_OF_TECHNICAL_GATE", "SOURCE_HELD", "SOURCE_READY"]},
    "consumer_authorization": {"const": "NOT_EVALUATED"},
    "publication_authorization": {"const": "NOT_IMPLIED"},
    "next_action": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "coverage": {"type": "object", "additionalProperties": false, "required": ["status", "count"], "properties": {"status": {"enum": ["PASS", "BLOCKED"]}, "count": {"type": "integer", "minimum": 0}}}
  }
}
