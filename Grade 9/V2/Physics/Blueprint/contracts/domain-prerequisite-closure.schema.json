{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-domain-prerequisite-closure.schema.json",
  "title": "Physics External Domain Prerequisite Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "engineering_receipt_ref",
    "prerequisites",
    "demands",
    "closure_status",
    "closure_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^DOMAIN-CLOSURE-PHY-"},
    "engineering_receipt_ref": {"type": "string", "minLength": 1},
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prerequisite_id", "status", "authority_ref", "demand_id"],
        "properties": {
          "prerequisite_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["READY_FROM_AUTHORITATIVE_DOMAIN", "HELD_NO_DOMAIN_RECEIPT"]},
          "authority_ref": {"type": ["string", "null"]},
          "demand_id": {"type": ["string", "null"]}
        }
      }
    },
    "demands": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/demand"}
    },
    "closure_status": {"enum": ["READY", "HELD"]},
    "closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "demand_id",
        "requester_subject",
        "provider_subject",
        "provider_entrypoint_ref",
        "prerequisite_id",
        "required_by_gate_ids",
        "engineering_receipt_ref",
        "engineering_closure_digest",
        "authority_contract_ref",
        "status",
        "demand_digest"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "demand_id": {"type": "string", "pattern": "^DOMAIN-DEMAND-PHY-"},
        "requester_subject": {"const": "PHYSICS"},
        "provider_subject": {"type": ["string", "null"]},
        "provider_entrypoint_ref": {"type": ["string", "null"]},
        "prerequisite_id": {"type": "string", "minLength": 1},
        "required_by_gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "engineering_receipt_ref": {"type": "string", "minLength": 1},
        "engineering_closure_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority_contract_ref": {"const": "contracts/domain-prerequisite-authority.schema.json"},
        "status": {"enum": ["OPEN_HELD", "OPEN_UNROUTABLE"]},
        "demand_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
