{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-independent-validation-session.schema.json",
  "title": "Physics Independent Validation Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "topic_id",
    "validator_role",
    "validator_instance_id",
    "upstream_role",
    "upstream_instance_ids",
    "ground_truth_refs",
    "pass1",
    "pass2",
    "pass3"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "validator_role": {"enum": ["CORE1", "CORE2", "CORE1A", "CORE2A"]},
    "validator_instance_id": {"type": "string", "minLength": 1},
    "upstream_role": {"enum": ["CORE1", "CORE2", "JOIN", "CORE1A"]},
    "upstream_instance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ground_truth_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pass1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "visible_ground_truth_refs", "visible_upstream_packet_refs", "independent_claims_digest", "locked"],
      "properties": {
        "mode": {"const": "GROUND_TRUTH_ONLY"},
        "visible_ground_truth_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "visible_upstream_packet_refs": {"type": "array", "maxItems": 0},
        "independent_claims_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locked": {"const": true}
      }
    },
    "pass2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "visible_upstream_packet_refs", "frozen_pass1_digest"],
      "properties": {
        "mode": {"const": "COMPARE_UPSTREAM"},
        "visible_upstream_packet_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "frozen_pass1_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "pass3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_claim_states"],
      "properties": {
        "mode": {"const": "EMIT_VALIDATION"},
        "allowed_claim_states": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 7,
          "items": {"enum": ["CONFIRMED", "REFINED", "MISSING", "UNSUPPORTED", "CONTRADICTED", "OUT_OF_SCOPE", "UNKNOWN"]},
          "allOf": [
            {"contains": {"const": "CONFIRMED"}},
            {"contains": {"const": "REFINED"}},
            {"contains": {"const": "MISSING"}},
            {"contains": {"const": "UNSUPPORTED"}},
            {"contains": {"const": "CONTRADICTED"}},
            {"contains": {"const": "OUT_OF_SCOPE"}},
            {"contains": {"const": "UNKNOWN"}}
          ]
        }
      }
    }
  }
}
