{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/physics/technical-teaching-unit-v2.schema.json",
  "title": "Physics Technical Teaching Unit v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ttu_id",
    "task_scale",
    "bucket_id",
    "problem_family_id",
    "difficulty_badge",
    "authority_binding",
    "semantic_target",
    "physical_setup",
    "canonical_completed_state",
    "reconstruction_contract",
    "verification_contract",
    "layer_realizations",
    "layout_contract"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "ttu_id": {"type": "string", "minLength": 1},
    "task_scale": {"enum": ["MICRO", "SUBSTANTIVE"]},
    "bucket_id": {"type": "string", "minLength": 1},
    "problem_family_id": {"type": "string", "minLength": 1},
    "difficulty_badge": {"enum": ["EASY", "MEDIUM", "HARD"]},
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_ref", "authority_class", "may_author_new_semantics"],
      "properties": {
        "authority_ref": {"type": "string", "minLength": 1},
        "authority_class": {
          "enum": [
            "CORE1_RELEASED_SEMANTICS",
            "CORE1A_RELEASED_TEACHING",
            "CORE2_FROZEN_SOURCE",
            "CORE2A_LEGAL_ITEM",
            "PROCESS_GOLDEN"
          ]
        },
        "may_author_new_semantics": {"const": false}
      }
    },
    "semantic_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "learning_atom_ids", "inferential_jump", "success_claim"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "learning_atom_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "inferential_jump": {"type": "string", "minLength": 1},
        "success_claim": {"type": "string", "minLength": 1}
      }
    },
    "physical_setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "event", "knowns", "unknown", "analysis_frame", "axis_or_sign_convention", "model_conditions"],
      "properties": {
        "objects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "event": {"type": "string", "minLength": 1},
        "knowns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unknown": {"type": "string", "minLength": 1},
        "analysis_frame": {"type": "string", "minLength": 1},
        "axis_or_sign_convention": {"type": "string", "minLength": 1},
        "model_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "canonical_completed_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "governing_relations", "working_steps", "result_or_conclusion"],
      "properties": {
        "representation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation_id", "type", "elements", "bindings"],
          "properties": {
            "representation_id": {"type": "string", "minLength": 1},
            "type": {
              "enum": [
                "VECTOR_OR_COMPONENT_CONSTRUCTION",
                "FREE_BODY_DIAGRAM",
                "GEOMETRIC_CONSTRUCTION",
                "FIELD_OR_FORCE_REPRESENTATION",
                "TRAJECTORY_WITH_MEANINGFUL_AXES",
                "PHYSICAL_GRAPH",
                "EVENT_TIMELINE",
                "STATE_TRANSITION_DIAGRAM",
                "REFERENCE_FRAME_OR_COORDINATE_DIAGRAM",
                "PHYSICAL_VARIABLE_TABLE",
                "EQUATION_DEPENDENCY_MAP"
              ]
            },
            "elements": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["element_id", "semantic_type", "canonical_content", "reasoning_role", "required_for_solution"],
                "properties": {
                  "element_id": {"type": "string", "minLength": 1},
                  "semantic_type": {
                    "enum": [
                      "OBJECT",
                      "FRAME_LABEL",
                      "AXIS_OR_SIGN",
                      "VECTOR",
                      "VECTOR_DIRECTION",
                      "VECTOR_MAGNITUDE",
                      "COMPONENT",
                      "FORCE",
                      "EVENT_MARKER",
                      "GRAPH_AXIS",
                      "GRAPH_FEATURE",
                      "GEOMETRIC_CONSTRAINT",
                      "EQUATION_TERM",
                      "MODEL_CONDITION",
                      "BOUNDARY_CONDITION",
                      "INTERMEDIATE_STATE"
                    ]
                  },
                  "canonical_content": {"type": "string", "minLength": 1},
                  "reasoning_role": {"type": "string", "minLength": 1},
                  "required_for_solution": {"type": "boolean"}
                }
              }
            },
            "bindings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["element_id", "relation_or_step_id", "binding_reason"],
                "properties": {
                  "element_id": {"type": "string", "minLength": 1},
                  "relation_or_step_id": {"type": "string", "minLength": 1},
                  "binding_reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "governing_relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation_id", "expression", "conditions"],
            "properties": {
              "relation_id": {"type": "string", "minLength": 1},
              "expression": {"type": "string", "minLength": 1},
              "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "working_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "action", "uses_element_ids", "uses_relation_ids", "output"],
            "properties": {
              "step_id": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "uses_element_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "uses_relation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "output": {"type": "string", "minLength": 1}
            }
          }
        },
        "result_or_conclusion": {"type": "string", "minLength": 1}
      }
    },
    "reconstruction_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstruction_required", "omissions", "learner_task", "fixed_help", "reveal_rule", "anti_triviality"],
      "properties": {
        "reconstruction_required": {"const": true},
        "omissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element_id", "semantic_type", "omission_kind", "learner_action", "targeted_capability", "pedagogical_reason"],
            "properties": {
              "element_id": {"type": "string", "minLength": 1},
              "semantic_type": {
                "enum": [
                  "FRAME_LABEL",
                  "AXIS_OR_SIGN",
                  "VECTOR",
                  "VECTOR_DIRECTION",
                  "VECTOR_MAGNITUDE",
                  "COMPONENT",
                  "FORCE",
                  "EVENT_MARKER",
                  "GRAPH_AXIS",
                  "GRAPH_FEATURE",
                  "GEOMETRIC_CONSTRAINT",
                  "EQUATION_TERM",
                  "MODEL_CONDITION",
                  "BOUNDARY_CONDITION",
                  "INTERMEDIATE_STATE"
                ]
              },
              "omission_kind": {
                "enum": [
                  "REMOVE_LABEL",
                  "REMOVE_DIRECTION",
                  "REMOVE_MAGNITUDE",
                  "REMOVE_COMPONENT",
                  "REMOVE_EQUATION_TERM",
                  "REMOVE_AXIS_OR_SIGN",
                  "REMOVE_EVENT_MARKER",
                  "REMOVE_FORCE",
                  "REMOVE_GRAPH_FEATURE",
                  "REMOVE_GEOMETRIC_CONSTRAINT",
                  "REMOVE_MODEL_SELECTION",
                  "REMOVE_BOUNDARY_CONDITION",
                  "REMOVE_INTERMEDIATE_STEP"
                ]
              },
              "learner_action": {"enum": ["LABEL", "DRAW", "COMPLETE", "SELECT", "DERIVE", "REARRANGE", "CALCULATE", "EXPLAIN"]},
              "targeted_capability": {"type": "string", "minLength": 1},
              "pedagogical_reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "learner_task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt", "expected_product", "success_criteria"],
          "properties": {
            "prompt": {"type": "string", "minLength": 1},
            "expected_product": {"type": "string", "minLength": 1},
            "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "fixed_help": {
          "type": "object",
          "additionalProperties": false,
          "required": ["help_is_preauthored_and_fixed", "steps", "dynamic_semantic_help_allowed_before_reveal"],
          "properties": {
            "help_is_preauthored_and_fixed": {"const": true},
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["help_id", "function", "text", "addresses_element_ids"],
                "properties": {
                  "help_id": {"enum": ["H1", "H2", "H3"]},
                  "function": {"enum": ["NOTICE", "REPRESENT", "START"]},
                  "text": {"type": "string", "minLength": 1},
                  "addresses_element_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                }
              }
            },
            "dynamic_semantic_help_allowed_before_reveal": {"const": false}
          }
        },
        "reveal_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_required_before_canonical_reveal", "canonical_state_reveal_after_attempt", "full_solution_exposure_is_mastery_evidence"],
          "properties": {
            "attempt_required_before_canonical_reveal": {"const": true},
            "canonical_state_reveal_after_attempt": {"const": true},
            "full_solution_exposure_is_mastery_evidence": {"const": false}
          }
        },
        "anti_triviality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cosmetic_blank_allowed", "arbitrary_number_blank_allowed", "answer_copy_task_allowed", "omitted_elements_must_change_reasoning_state"],
          "properties": {
            "cosmetic_blank_allowed": {"const": false},
            "arbitrary_number_blank_allowed": {"const": false},
            "answer_copy_task_allowed": {"const": false},
            "omitted_elements_must_change_reasoning_state": {"const": true}
          }
        }
      }
    },
    "verification_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_rules"],
      "properties": {
        "independent_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "type", "instruction", "uses_answer_key", "applicable_before_reveal"],
            "properties": {
              "rule_id": {"type": "string", "minLength": 1},
              "type": {
                "enum": [
                  "INVERSE_RELATION",
                  "SUBSTITUTE_BACK",
                  "LIMITING_CASE",
                  "DIMENSIONAL",
                  "SIGN_DIRECTION",
                  "CONSERVATION",
                  "GRAPH_BEHAVIOR",
                  "BOUNDARY_CONDITION",
                  "ALTERNATE_REPRESENTATION",
                  "MODEL_VALIDITY"
                ]
              },
              "instruction": {"type": "string", "minLength": 1},
              "uses_answer_key": {"const": false},
              "applicable_before_reveal": {"const": true}
            }
          }
        }
      }
    },
    "layer_realizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "mode", "uses_canonical_state", "uses_reconstruction_contract"],
        "properties": {
          "layer": {"enum": ["CORE1A", "CORE1B", "CORE2A", "CORE2B"]},
          "mode": {"enum": ["REFERENCE", "RECONSTRUCTION", "WORKED_APPLICATION", "TRANSFER_RECONSTRUCTION"]},
          "uses_canonical_state": {"type": "boolean"},
          "uses_reconstruction_contract": {"type": "boolean"}
        }
      }
    },
    "layout_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learner_state_and_canonical_state_visually_distinct", "omitted_elements_have_visible_targets", "help_separated_from_canonical_reveal", "minimum_final_label_pt", "oversized_low_information_figure"],
      "properties": {
        "learner_state_and_canonical_state_visually_distinct": {"const": true},
        "omitted_elements_have_visible_targets": {"const": true},
        "help_separated_from_canonical_reveal": {"const": true},
        "minimum_final_label_pt": {"type": "number", "minimum": 8.0},
        "oversized_low_information_figure": {"const": false}
      }
    }
  }
}