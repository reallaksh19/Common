{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-architecture-blueprint.schema.json",
  "title": "Physics Architecture Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["architecture_id", "schema_version", "planes", "roles", "invariants"],
  "properties": {
    "architecture_id": {"type": "string", "pattern": "^PHY-BLUEPRINT-v[0-9]+$"},
    "schema_version": {"const": "1.0.0"},
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EVIDENCE", "REASONING", "CONTROL"],
      "properties": {
        "EVIDENCE": {"$ref": "#/$defs/plane"},
        "REASONING": {"$ref": "#/$defs/plane"},
        "CONTROL": {"$ref": "#/$defs/plane"}
      }
    },
    "roles": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["CORE0", "CORE1", "CORE2", "JOIN", "CORE1A", "CORE2A"]},
      "allOf": [
        {"contains": {"const": "CORE0"}},
        {"contains": {"const": "CORE1"}},
        {"contains": {"const": "CORE2"}},
        {"contains": {"const": "JOIN"}},
        {"contains": {"const": "CORE1A"}},
        {"contains": {"const": "CORE2A"}}
      ]
    },
    "role_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CORE2A"],
      "properties": {
        "CORE2A": {"enum": ["PLACEHOLDER", "ACTIVE"]}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground_truth_is_authority",
        "adaptive_first_role",
        "fresh_agent_per_role",
        "second_role_independent_grounding",
        "max_subtopics_per_handoff",
        "learning_atoms_unbounded",
        "join_required_before_core1a",
        "core1a_reasoning_before_manuscript",
        "representation_requires_cognitive_purpose",
        "equation_requires_learning_anatomy",
        "owner_override_preserves_system_finding",
        "absence_of_evidence_must_remain_visible"
      ],
      "properties": {
        "ground_truth_is_authority": {"const": true},
        "adaptive_first_role": {"const": true},
        "fresh_agent_per_role": {"const": true},
        "second_role_independent_grounding": {"const": true},
        "max_subtopics_per_handoff": {"const": 3},
        "learning_atoms_unbounded": {"const": true},
        "join_required_before_core1a": {"const": true},
        "core1a_reasoning_before_manuscript": {"const": true},
        "representation_requires_cognitive_purpose": {"const": true},
        "equation_requires_learning_anatomy": {"const": true},
        "owner_override_preserves_system_finding": {"const": true},
        "absence_of_evidence_must_remain_visible": {"const": true}
      }
    }
  },
  "$defs": {
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
