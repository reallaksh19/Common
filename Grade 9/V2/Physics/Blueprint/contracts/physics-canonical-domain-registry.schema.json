{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physics-canonical-domain-registry.schema.json",
  "title": "Physics Canonical Domain Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "registry_id",
    "run_ref",
    "source_manifest_refs",
    "join_refs",
    "admission_policy_ref",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "PHYSICS"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^PHY-REG-[A-Z0-9][A-Z0-9_-]{4,}$"
    },
    "run_ref": {
      "type": "string",
      "minLength": 3
    },
    "source_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "join_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "admission_policy_ref": {
      "const": "PHY-CANONICAL-DOMAIN-REGISTRY-v1"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "assetType": {
      "enum": [
        "CONCEPT",
        "MODEL",
        "EQUATION",
        "DERIVATION",
        "CAPABILITY",
        "LEARNING_ATOM",
        "REPRESENTATION",
        "MISCONCEPTION",
        "PROBLEM_FAMILY",
        "SOURCE_QUESTION",
        "CANONICAL_SOLUTION",
        "EXAMPLE",
        "VERIFICATION_RULE"
      ]
    },
    "authorityClass": {
      "enum": [
        "CORE1_SEMANTIC",
        "CORE2_ASSESSMENT",
        "DUAL_VALIDATED",
        "SOURCE_FROZEN",
        "INDEPENDENT_VERIFICATION"
      ]
    },
    "semanticPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "prerequisite_refs",
        "implications"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 8
        },
        "prerequisite_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        },
        "implications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "boundary_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "equationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "mathematical_question",
        "parent_refs",
        "valid_when",
        "term_meanings",
        "inverse_uses"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 2
        },
        "mathematical_question": {
          "type": "string",
          "minLength": 8
        },
        "parent_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        },
        "valid_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "term_meanings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "inverse_uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "failure_cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "derivationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "justification"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 2
        },
        "justification": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "derivationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_refs",
        "steps",
        "result_ref"
      ],
      "properties": {
        "from_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/derivationStep"
          }
        },
        "result_ref": {
          "type": "string",
          "pattern": "^REG-PHY-"
        }
      }
    },
    "representationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation_type",
        "must_make_visible",
        "must_not_imply"
      ],
      "properties": {
        "representation_type": {
          "enum": [
            "FREE_BODY_DIAGRAM",
            "GEOMETRIC_VECTOR_DIAGRAM",
            "COORDINATE_SYSTEM",
            "CARTESIAN_COMPONENT_DECOMPOSITION",
            "SCHEMATIC_SYSTEM_BOUNDARY",
            "ALGEBRAIC_SUPERPOSITION",
            "CONSTRAINT_DIAGRAM",
            "KINEMATIC_GRAPH_PLOT",
            "RAY_OPTICS_DIAGRAM",
            "CIRCUIT_SCHEMATIC",
            "THERMODYNAMIC_PV_CYCLE",
            "WAVE_OSCILLATION_PLOT",
            "FIELD_LINE_EQUIPOTENTIAL_MAP",
            "DIAGRAM",
            "GRAPH",
            "TABLE",
            "NUMBER_LINE",
            "FLOW_DEPENDENCY",
            "OTHER"
          ]
        },
        "must_make_visible": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "must_not_imply": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "math_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        },
        "physics_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "math_bindings"
          ]
        },
        {
          "required": [
            "physics_bindings"
          ]
        }
      ]
    },
    "misconceptionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incorrect_model",
        "corrective_model",
        "trigger_conditions"
      ],
      "properties": {
        "incorrect_model": {
          "type": "string",
          "minLength": 5
        },
        "corrective_model": {
          "type": "string",
          "minLength": 5
        },
        "trigger_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "problemFamilyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognition_cues",
        "invariant_refs",
        "required_capability_refs",
        "safe_variations",
        "forbidden_variations"
      ],
      "properties": {
        "recognition_cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "invariant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        },
        "required_capability_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        },
        "safe_variations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "forbidden_variations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "sourceQuestionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_ref",
        "source_ref",
        "frozen_digest"
      ],
      "properties": {
        "question_ref": {
          "type": "string",
          "minLength": 2
        },
        "source_ref": {
          "type": "string",
          "minLength": 2
        },
        "frozen_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "solutionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_asset_ref",
        "answer_contract_ref",
        "verification_rule_refs"
      ],
      "properties": {
        "question_asset_ref": {
          "type": "string",
          "pattern": "^REG-PHY-"
        },
        "answer_contract_ref": {
          "type": "string",
          "minLength": 3
        },
        "verification_rule_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-"
          }
        }
      }
    },
    "examplePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_family_ref",
        "fingerprint_ref",
        "canonical_prompt_ref"
      ],
      "properties": {
        "problem_family_ref": {
          "type": "string",
          "pattern": "^REG-PHY-"
        },
        "fingerprint_ref": {
          "type": "string",
          "minLength": 3
        },
        "canonical_prompt_ref": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "verificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_type",
        "instruction",
        "uses_answer_key"
      ],
      "properties": {
        "verification_type": {
          "enum": [
            "SUBSTITUTION_BACK",
            "INVERSE_RELATION",
            "LIMITING_CASE",
            "UNITS",
            "SIGN",
            "GRAPH_CONSISTENCY",
            "GEOMETRIC_CONSISTENCY",
            "DIMENSIONAL_ANALYSIS",
            "ORDER_OF_MAGNITUDE",
            "BOUNDARY_VALUE",
            "CONSERVATION_CHECK",
            "IDENTITY_CHECK",
            "OTHER"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 3
        },
        "uses_answer_key": {
          "const": false
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "subtopic_id",
        "title",
        "authority_class",
        "admission_status",
        "confidence",
        "ground_truth_refs",
        "core1_refs",
        "core2_refs",
        "validation_refs",
        "join_ref",
        "depends_on",
        "payload",
        "provenance_note"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^REG-PHY-[A-Z0-9][A-Z0-9_-]{3,}$"
        },
        "asset_type": {
          "$ref": "#/$defs/assetType"
        },
        "subtopic_id": {
          "type": "string",
          "minLength": 3
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "authority_class": {
          "$ref": "#/$defs/authorityClass"
        },
        "admission_status": {
          "const": "ADMITTED"
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "ground_truth_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "core1_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "core2_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "validation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "join_ref": {
          "type": "string",
          "minLength": 3
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REG-PHY-[A-Z0-9][A-Z0-9_-]{3,}$"
          }
        },
        "payload": {
          "type": "object"
        },
        "provenance_note": {
          "type": "string",
          "minLength": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "asset_type": {
                "enum": [
                  "CONCEPT",
                  "MODEL",
                  "CAPABILITY",
                  "LEARNING_ATOM"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/semanticPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "EQUATION"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/equationPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "DERIVATION"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/derivationPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "REPRESENTATION"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/representationPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "MISCONCEPTION"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/misconceptionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "PROBLEM_FAMILY"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/problemFamilyPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "SOURCE_QUESTION"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/sourceQuestionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "CANONICAL_SOLUTION"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/solutionPayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "EXAMPLE"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/examplePayload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "asset_type": {
                "const": "VERIFICATION_RULE"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/verificationPayload"
              }
            }
          }
        }
      ]
    }
  }
}