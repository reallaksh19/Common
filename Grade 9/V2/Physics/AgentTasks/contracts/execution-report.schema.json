{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/common/schemas/grade9/physics/agent-tasks/execution-report.schema.json",
  "title": "StandaloneExecutionReport",
  "description": "Governing schema for machine completion report output generated by standalone execution agents.",
  "type": "object",
  "required": [
    "prompt_id",
    "task_instance_id",
    "start_head",
    "end_head",
    "result",
    "changed_files",
    "tests",
    "workflows",
    "blockers",
    "limitations",
    "architecture_findings",
    "memory_dependency_detected"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^SEP-[A-Za-z0-9_.-]+$",
      "description": "Identifier of the executed prompt."
    },
    "task_instance_id": {
      "type": "string",
      "minLength": 3,
      "description": "Instance ID of the completed task."
    },
    "start_head": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|UNKNOWN)$",
      "description": "Starting git commit HEAD."
    },
    "end_head": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|UNKNOWN)$",
      "description": "Ending git commit HEAD."
    },
    "result": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED"],
      "description": "Overall mission outcome disposition."
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason", "tier", "authority_impact"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative repository file path."
          },
          "reason": {
            "type": "string",
            "description": "Technical justification for the modification."
          },
          "tier": {
            "type": "string",
            "enum": [
              "DATA_ONLY",
              "SCHEMA",
              "GENERIC_ENGINE",
              "SUBJECT_ADAPTER",
              "BLUEPRINT",
              "TEST",
              "DOC",
              "SCHEMA_EXTENSION",
              "SUBJECT_ADAPTER_CHANGE",
              "GENERIC_ENGINE_CHANGE",
              "BLUEPRINT_CHANGE"
            ],
            "description": "Architectural layer of the changed file."
          },
          "authority_impact": {
            "type": "string",
            "description": "Declaration of how authority or custody was altered or preserved."
          }
        },
        "additionalProperties": false
      },
      "description": "List of files created, modified, or deleted during execution."
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "result", "evidence"],
        "properties": {
          "test": {
            "type": "string",
            "description": "Name or command of test or falsifier executed."
          },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "SKIPPED", "NOT_RUN"],
            "description": "Execution result. NOT_RUN must never be masked as PASS."
          },
          "evidence": {
            "type": "string",
            "description": "Concrete command output, exit code, or assertion trace."
          }
        },
        "additionalProperties": false
      },
      "description": "Test and falsifier results."
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow", "run", "result"],
        "properties": {
          "workflow": {
            "type": "string",
            "description": "CI workflow name or script identifier."
          },
          "run": {
            "type": "string",
            "description": "Execution trigger or run ID."
          },
          "result": {
            "type": "string",
            "description": "Workflow outcome or status."
          }
        },
        "additionalProperties": false
      },
      "description": "CI workflow execution records."
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific blocking conditions encountered if result is BLOCKED or PARTIAL."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Declared known limitations of the deliverable."
    },
    "architecture_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Architectural findings: reusable improvements, remaining case coupling, scalability concerns."
    },
    "memory_dependency_detected": {
      "type": "boolean",
      "description": "True if execution relied on unreproducible conversational memory rather than repository truth."
    },
    "recommended_next_task": {
      "type": "string",
      "description": "Proposed immediate follow-up task instance."
    }
  },
  "additionalProperties": false
}
