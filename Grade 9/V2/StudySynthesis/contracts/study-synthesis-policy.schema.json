{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-synthesis-policy.schema.json",
  "title": "V2 StudySynthesisPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "state_rules", "entry_point_rule", "requirement_rules"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 3},
    "version": {"type": "string", "minLength": 1},
    "state_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DEMONSTRATED", "DEVELOPING", "REPAIR_REQUIRED", "PROBE_REQUIRED", "AMBIGUOUS", "UNKNOWN"],
      "properties": {
        "DEMONSTRATED": {"type": "object", "additionalProperties": false, "required": ["engagement_mode", "readiness_mode"], "properties": {"engagement_mode": {"enum": ["VERIFY_ONLY", "COMPRESS", "USE_AS_ENTRY_POINT", "ACTIVE_STUDY"]}, "readiness_mode": {"enum": ["READY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}},
        "DEVELOPING": {"type": "object", "additionalProperties": false, "required": ["engagement_mode", "readiness_mode"], "properties": {"engagement_mode": {"enum": ["VERIFY_ONLY", "COMPRESS", "USE_AS_ENTRY_POINT", "ACTIVE_STUDY"]}, "readiness_mode": {"enum": ["READY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}},
        "REPAIR_REQUIRED": {"type": "object", "additionalProperties": false, "required": ["engagement_mode", "readiness_mode"], "properties": {"engagement_mode": {"enum": ["VERIFY_ONLY", "COMPRESS", "USE_AS_ENTRY_POINT", "ACTIVE_STUDY"]}, "readiness_mode": {"enum": ["READY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}},
        "PROBE_REQUIRED": {"type": "object", "additionalProperties": false, "required": ["engagement_mode", "readiness_mode"], "properties": {"engagement_mode": {"enum": ["VERIFY_ONLY", "COMPRESS", "USE_AS_ENTRY_POINT", "ACTIVE_STUDY"]}, "readiness_mode": {"enum": ["READY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}},
        "AMBIGUOUS": {"type": "object", "additionalProperties": false, "required": ["engagement_mode", "readiness_mode"], "properties": {"engagement_mode": {"enum": ["VERIFY_ONLY", "COMPRESS", "USE_AS_ENTRY_POINT", "ACTIVE_STUDY"]}, "readiness_mode": {"enum": ["READY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}},
        "UNKNOWN": {"type": "object", "additionalProperties": false, "required": ["engagement_mode", "readiness_mode"], "properties": {"engagement_mode": {"enum": ["VERIFY_ONLY", "COMPRESS", "USE_AS_ENTRY_POINT", "ACTIVE_STUDY"]}, "readiness_mode": {"enum": ["READY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}}
      }
    },
    "entry_point_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "from_state", "when_dependency_of_readiness"],
      "properties": {
        "enabled": {"type": "boolean"},
        "from_state": {"const": "DEMONSTRATED"},
        "when_dependency_of_readiness": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]}}
      }
    },
    "requirement_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST", "VERIFY_ONLY"],
      "properties": {
        "REPAIR_BEFORE": {"type": "array", "items": {"enum": ["CONCEPTUAL_BRIDGE", "RECONSTRUCTION", "REPRESENTATION_MEANING", "MISCONCEPTION_CONTRAST", "WORKED_REASONING", "VERIFICATION", "TRANSFER", "COMPLETION_EVIDENCE"]}},
        "REPAIR_IN_UNIT": {"type": "array", "items": {"enum": ["CONCEPTUAL_BRIDGE", "RECONSTRUCTION", "REPRESENTATION_MEANING", "MISCONCEPTION_CONTRAST", "WORKED_REASONING", "VERIFICATION", "TRANSFER", "COMPLETION_EVIDENCE"]}},
        "PROBE_FIRST": {"type": "array", "items": {"enum": ["COMPLETION_EVIDENCE", "VERIFICATION"]}},
        "VERIFY_ONLY": {"type": "array", "items": {"enum": ["VERIFICATION", "TRANSFER", "COMPLETION_EVIDENCE"]}}
      }
    }
  }
}
