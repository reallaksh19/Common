{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"learner-state-snapshot.schema.json","title":"Math LearnerStateSnapshot","type":"object","additionalProperties":false,"required":["snapshot_id","schema_version","subject","question_set_ref","attempt_mode","scope_fingerprint","evidence_ledger_digest","diagnostic_policy_version","capability_states","diagnostic_cases","verification_behavior","snapshot_digest"],"properties":{"snapshot_id":{"type":"string"},"schema_version":{"const":"1.0.0"},"subject":{"const":"MATHEMATICS"},"question_set_ref":{"type":"string"},"attempt_mode":{"enum":["PRESENT","ABSENT"]},"scope_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence_ledger_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"diagnostic_policy_version":{"const":"MATH-ME-DIAGNOSTIC-v1"},"capability_states":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["capability_ref","readiness","confidence","positive_independent_count","negative_independent_count","ambiguous_count","observation_refs"],"properties":{"capability_ref":{"type":"string"},"readiness":{"enum":["UNKNOWN","DEVELOPING","READY"]},"confidence":{"type":"number","minimum":0,"maximum":1},"positive_independent_count":{"type":"integer","minimum":0},"negative_independent_count":{"type":"integer","minimum":0},"ambiguous_count":{"type":"integer","minimum":0},"observation_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}}},"diagnostic_cases":{"type":"array","items":{"$ref":"diagnostic-case.schema.json"}},"verification_behavior":{"type":"object","additionalProperties":false,"required":["self_initiated_verification_observed","verification_failure_observed"],"properties":{"self_initiated_verification_observed":{"type":["boolean","null"]},"verification_failure_observed":{"type":["boolean","null"]}}},"snapshot_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}