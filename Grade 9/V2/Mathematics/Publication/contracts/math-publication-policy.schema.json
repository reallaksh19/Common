{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-publication-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "schema_version", "fixture_class", "page_size", "benchmark_inputs", "page_groups"],
  "properties": {
    "policy_id": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "fixture_class": {"const": "PUBLIC_SYNTHETIC"},
    "page_size": {"const": "A4"},
    "benchmark_inputs": {"type": "array", "maxItems": 0},
    "page_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "content_refs"],
        "properties": {
          "title": {"type": "string"},
          "content_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  }
}
