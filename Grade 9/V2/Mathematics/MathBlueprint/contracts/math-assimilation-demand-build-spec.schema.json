{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-assimilation-demand-build-spec.schema.json",
  "title": "Mathematics Assimilation Demand Build Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_ref",
    "bundle_ref",
    "learner_capability_state_ref",
    "obligations",
    "owner_constraints",
    "blocking_conflict_record_refs",
    "deferred_conflicts",
    "unresolved_issue_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_ref": {"type": "string", "pattern": "^MATH-MLR-[0-9a-f]{16}$"},
    "bundle_ref": {"type": "string", "pattern": "^MATH-HB-[0-9a-f]{16}$"},
    "learner_capability_state_ref": {"type": ["string", "null"], "pattern": "^MATH-LCS-[0-9a-f]{16}$"},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_key",
          "obligation_type",
          "statement",
          "origin_claim_refs",
          "capability_refs",
          "required_before_core2a",
          "notes"
        ],
        "properties": {
          "local_key": {"type": "string", "minLength": 1},
          "obligation_type": {
            "enum": [
              "SEMANTIC_UNDERSTANDING",
              "ASSESSMENT_RECOGNITION",
              "PREREQUISITE",
              "INFERENCE_BRIDGE",
              "EQUATION_ASSIMILATION",
              "REPRESENTATION",
              "MISCONCEPTION_CONTRAST",
              "TRANSFER"
            ]
          },
          "statement": {"type": "string", "minLength": 1},
          "origin_claim_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^MATH-CL-[0-9a-f]{16}$"}
          },
          "capability_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "required_before_core2a": {"type": "boolean"},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "owner_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "mode", "target", "instruction"],
        "properties": {
          "constraint_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["HARD", "SOFT"]},
          "target": {"type": "string", "minLength": 1},
          "instruction": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocking_conflict_record_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MATH-XR-[0-9a-f]{16}$"}
    },
    "deferred_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_ref", "reason"],
        "properties": {
          "record_ref": {"type": "string", "pattern": "^MATH-XR-[0-9a-f]{16}$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_issue_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
