{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-agent-context-manifest.schema.json",
  "title": "Mathematics Agent Context Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "schema_version",
    "subject",
    "run_ref",
    "bundle_ref",
    "work_order_ref",
    "work_order_digest",
    "role",
    "phase",
    "agent_instance_id",
    "context_mode",
    "ground_truth_items",
    "upstream_packages",
    "withheld_upstream_package_refs",
    "context_digest"
  ],
  "properties": {
    "context_id": {"type": "string", "pattern": "^MATH-CTX-[0-9a-f]{16}$"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "run_ref": {"type": "string", "pattern": "^MATH-MLR-[0-9a-f]{16}$"},
    "bundle_ref": {"type": "string", "pattern": "^MATH-HB-[0-9a-f]{16}$"},
    "work_order_ref": {"type": "string", "pattern": "^MATH-WO-[0-9a-f]{16}$"},
    "work_order_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {"enum": ["CORE1", "CORE2"]},
    "phase": {"enum": ["FIRST_ROLE_ANALYSIS", "SECOND_ROLE_INDEPENDENT", "SECOND_ROLE_VALIDATION"]},
    "agent_instance_id": {"type": "string", "minLength": 1},
    "context_mode": {"enum": ["GROUND_TRUTH_ONLY", "GROUND_TRUTH_PLUS_UPSTREAM_VALIDATION"]},
    "ground_truth_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type", "availability", "ref", "digest"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_type": {"type": "string", "minLength": 1},
          "availability": {"enum": ["PRESENT", "ABSENT", "PARTIAL", "UNRESOLVED", "CONFLICTED"]},
          "ref": {"type": ["string", "null"]},
          "digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "upstream_packages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_ref", "package_digest"],
        "properties": {
          "package_ref": {"type": "string", "pattern": "^MATH-SP-[0-9a-f]{16}$"},
          "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "withheld_upstream_package_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MATH-SP-[0-9a-f]{16}$"}
    },
    "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"enum": ["FIRST_ROLE_ANALYSIS", "SECOND_ROLE_INDEPENDENT"]}}},
      "then": {
        "properties": {
          "context_mode": {"const": "GROUND_TRUTH_ONLY"},
          "upstream_packages": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"phase": {"const": "SECOND_ROLE_VALIDATION"}}},
      "then": {
        "properties": {
          "context_mode": {"const": "GROUND_TRUTH_PLUS_UPSTREAM_VALIDATION"},
          "upstream_packages": {"minItems": 2},
          "withheld_upstream_package_refs": {"maxItems": 0}
        }
      }
    }
  ]
}
