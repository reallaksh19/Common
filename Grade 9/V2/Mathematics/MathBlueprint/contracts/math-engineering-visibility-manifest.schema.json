{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-engineering-visibility-manifest.schema.json",
  "title": "Mathematics Engineering Product Visibility Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "subject", "manifest_id", "view_class", "authority",
    "visibility_purpose", "visibility_notice", "technical_authorization",
    "publication_authorization", "source_domain_admission_digest",
    "source_release_gate_digest", "registry_digest", "validator_contract_digest",
    "authorization_count", "gate_count", "authorizations", "gates", "manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "manifest_id": {"type": "string", "pattern": "^MATH-ENG-VIS-"},
    "view_class": {"const": "DERIVED_ENGINEERING_PRODUCT_VISIBILITY"},
    "authority": {"const": "NON_AUTHORITATIVE_VIEW_OF_BOUND_ENGINEERING_AUTHORITY"},
    "visibility_purpose": {"const": "LEARNER_AND_AUTHOR_EXPLAINABILITY"},
    "visibility_notice": {"type": "string", "minLength": 20},
    "technical_authorization": {"const": "ALLOWED"},
    "publication_authorization": {"const": "NOT_IMPLIED"},
    "source_domain_admission_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_release_gate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "validator_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorization_count": {"type": "integer", "minimum": 1},
    "gate_count": {"type": "integer", "minimum": 1},
    "authorizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorization_id", "binding_id", "request_id", "engineering_depth",
          "direct_gate_ids", "transitive_gate_ids", "closure_receipt_digest", "passport_digest"
        ],
        "properties": {
          "authorization_id": {"type": "string", "pattern": "^MATH-ENG-AUTH-"},
          "binding_id": {"type": "string", "minLength": 3},
          "request_id": {"type": "string", "pattern": "^MATH-ENG-REQ-"},
          "engineering_depth": {"enum": ["FOUNDATION", "STANDARD", "RESEARCH"]},
          "direct_gate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^MATH-"}},
          "transitive_gate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^MATH-"}},
          "closure_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "passport_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id", "scope_roles", "authorization_refs", "requested_engineering_depths",
          "learner_title", "chapter", "technical_state", "failure_codes", "prerequisite_ids",
          "provenance", "structure_counts", "difficulty_profile", "release_checklist_pass",
          "representations", "misconceptions", "verification_obligations"
        ],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^MATH-"},
          "scope_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DIRECT", "PREREQUISITE_CLOSURE"]}},
          "authorization_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-ENG-AUTH-"}},
          "requested_engineering_depths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FOUNDATION", "STANDARD", "RESEARCH"]}},
          "learner_title": {"type": "string", "minLength": 1},
          "chapter": {"type": "string", "minLength": 1},
          "technical_state": {"const": "READY"},
          "failure_codes": {"type": "array", "maxItems": 0},
          "prerequisite_ids": {"type": "array", "items": {"type": "string", "pattern": "^MATH-"}},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["authority_tier", "source_scope", "claim_status", "source_reference"],
            "properties": {
              "authority_tier": {"type": ["string", "null"]},
              "source_scope": {"type": ["string", "null"]},
              "claim_status": {"type": ["string", "null"]},
              "source_reference": {"type": ["string", "null"]}
            }
          },
          "structure_counts": {"type": "object"},
          "difficulty_profile": {"type": "object"},
          "release_checklist_pass": {"const": true},
          "representations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["representation_id", "representation_type", "name", "verification_method"],
              "properties": {
                "representation_id": {"type": "string", "minLength": 3},
                "representation_type": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "verification_method": {"type": "string", "minLength": 1}
              }
            }
          },
          "misconceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["misconception_id", "incorrect_belief", "required_technical_repair"],
              "properties": {
                "misconception_id": {"type": "string", "minLength": 3},
                "incorrect_belief": {"type": "string", "minLength": 1},
                "required_technical_repair": {"type": "string", "minLength": 1}
              }
            }
          },
          "verification_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
