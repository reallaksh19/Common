{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-cross-validation.schema.json",
  "title": "Mathematics Cross-Validation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validation_id",
    "schema_version",
    "subject",
    "run_ref",
    "bundle_ref",
    "first_role",
    "second_role",
    "validator_agent_instance_id",
    "first_package_ref",
    "first_package_digest",
    "independent_package_ref",
    "independent_package_digest",
    "validation_work_order_ref",
    "validation_work_order_digest",
    "validation_context_ref",
    "validation_context_digest",
    "independent_package_sealed_before_validation",
    "records",
    "missing_findings",
    "validation_digest"
  ],
  "properties": {
    "validation_id": {"type": "string", "pattern": "^MATH-XV-[0-9a-f]{16}$"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "run_ref": {"type": "string", "pattern": "^MATH-MLR-[0-9a-f]{16}$"},
    "bundle_ref": {"type": "string", "pattern": "^MATH-HB-[0-9a-f]{16}$"},
    "first_role": {"enum": ["CORE1", "CORE2"]},
    "second_role": {"enum": ["CORE1", "CORE2"]},
    "validator_agent_instance_id": {"type": "string", "minLength": 1},
    "first_package_ref": {"type": "string", "pattern": "^MATH-SP-[0-9a-f]{16}$"},
    "first_package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independent_package_ref": {"type": "string", "pattern": "^MATH-SP-[0-9a-f]{16}$"},
    "independent_package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_work_order_ref": {"type": "string", "pattern": "^MATH-WO-[0-9a-f]{16}$"},
    "validation_work_order_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_context_ref": {"type": "string", "pattern": "^MATH-CTX-[0-9a-f]{16}$"},
    "validation_context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "independent_package_sealed_before_validation": {"const": true},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "missing_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/missingFinding"}
    },
    "validation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "first_claim_ref", "classification", "ground_truth_evidence_refs", "rationale", "refined_statement"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^MATH-XR-[0-9a-f]{16}$"},
        "first_claim_ref": {"type": "string", "pattern": "^MATH-CL-[0-9a-f]{16}$"},
        "classification": {"enum": ["CONFIRMED", "REFINED", "UNSUPPORTED", "CONTRADICTED", "OUT_OF_SCOPE", "UNKNOWN"]},
        "ground_truth_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1},
        "refined_statement": {"type": ["string", "null"]}
      }
    },
    "missingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "classification", "second_claim_ref", "ground_truth_evidence_refs", "rationale"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^MATH-XR-[0-9a-f]{16}$"},
        "classification": {"const": "MISSING"},
        "second_claim_ref": {"type": "string", "pattern": "^MATH-CL-[0-9a-f]{16}$"},
        "ground_truth_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
