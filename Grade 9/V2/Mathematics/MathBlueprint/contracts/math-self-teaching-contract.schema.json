{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-self-teaching-contract.schema.json",
  "title": "Mathematics Self-Teaching Stage Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "self_taught", "stage_profiles", "global_invariants"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "self_taught": {"const": true},
    "stage_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CORE1A", "CORE1B", "CORE2A", "CORE2B"],
      "properties": {
        "CORE1A": {"$ref": "#/$defs/stageProfile"},
        "CORE1B": {"$ref": "#/$defs/stageProfile"},
        "CORE2A": {"$ref": "#/$defs/stageProfile"},
        "CORE2B": {"$ref": "#/$defs/stageProfile"}
      }
    },
    "global_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_stages_close_the_help_loop",
        "answers_are_independently_verified",
        "visuals_have_cognitive_purpose",
        "frozen_core2_questions_are_not_rewritten",
        "generated_variants_have_new_identity",
        "static_products_do_not_claim_learner_mastery"
      ],
      "properties": {
        "all_stages_close_the_help_loop": {"const": true},
        "answers_are_independently_verified": {"const": true},
        "visuals_have_cognitive_purpose": {"const": true},
        "frozen_core2_questions_are_not_rewritten": {"const": true},
        "generated_variants_have_new_identity": {"const": true},
        "static_products_do_not_claim_learner_mastery": {"const": true}
      }
    }
  },
  "$defs": {
    "stageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "role", "governing_question", "attempt_before_explanation",
        "help_path", "answer_support", "visual_contract", "required_cognitive_moves"
      ],
      "properties": {
        "mode": {"enum": ["DECLARATIVE", "OPEN_ENDED"]},
        "role": {"type": "string", "minLength": 3},
        "governing_question": {"type": "string", "minLength": 10},
        "attempt_before_explanation": {"type": "boolean"},
        "help_path": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MEANING_HELP", "RECOGNITION_HELP", "REPRESENTATION_HELP", "CONCEPT_HELP",
              "FIRST_MOVE_HELP", "PROCEDURE_HELP", "METHOD_HELP", "FULL_WORKING",
              "ANSWER_VERIFICATION"
            ]
          }
        },
        "answer_support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "explanatory", "numeric_or_symbolic_check", "graphical_or_representation_check_when_useful"],
          "properties": {
            "present": {"const": true},
            "explanatory": {"const": true},
            "numeric_or_symbolic_check": {"const": true},
            "graphical_or_representation_check_when_useful": {"const": true}
          }
        },
        "visual_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cognitive_purpose", "must_make_visible", "symbol_bridge", "must_not_imply"],
          "properties": {
            "cognitive_purpose": {"type": "string", "minLength": 3},
            "must_make_visible": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
            "symbol_bridge": {"type": "string", "minLength": 3},
            "must_not_imply": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
          }
        },
        "required_cognitive_moves": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
