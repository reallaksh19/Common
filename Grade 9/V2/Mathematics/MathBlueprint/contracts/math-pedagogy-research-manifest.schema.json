{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-pedagogy-research-manifest.schema.json",
  "title": "Mathematics Pedagogy Research Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","subject","manifest_id","release_class","curriculum_authority","sources","decisions","manifest_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "manifest_id": {"type":"string","pattern":"^MATH-PED-RESEARCH-"},
    "release_class": {"enum":["PRODUCTION","TEST_ONLY"]},
    "curriculum_authority": {"const": false},
    "sources": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["research_ref","source_url","source_title","publisher","accessed_on","evidence_class","capture_ref","capture_digest","supports"],
        "properties": {
          "research_ref":{"type":"string","pattern":"^PED-WEB-"},
          "source_url":{"type":"string","format":"uri","pattern":"^https://"},
          "source_title":{"type":"string","minLength":8},
          "publisher":{"type":"string","minLength":2},
          "accessed_on":{"type":"string","format":"date"},
          "evidence_class":{"enum":["VERIFIED_WEB_CAPTURE","TEST_FIXTURE"]},
          "capture_ref":{"type":"string","minLength":3},
          "capture_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "supports":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["REPRESENTATION_DESIGN","SIGNALING_AND_COHERENCE","MULTIPLE_REPRESENTATION_MAPPING","WORKED_EXAMPLE_DESIGN","FADING","SELF_EXPLANATION","MISCONCEPTION_REPAIR","INFERENTIAL_DECOMPOSITION","TRANSFER_DESIGN"]}}
        }
      }
    },
    "decisions": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["decision_ref","subtopic_ref","research_depth","coverage","research_refs","decision_summary"],
        "properties": {
          "decision_ref":{"type":"string","pattern":"^PED-BRIEF-"},
          "subtopic_ref":{"type":"string","minLength":3},
          "research_depth":{"enum":["STANDARD","DEEP"]},
          "coverage":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["REPRESENTATION_DESIGN","MISCONCEPTION_REPAIR","INFERENTIAL_DECOMPOSITION","WORKED_EXAMPLE_DESIGN","FADING","TRANSFER_DESIGN"]}},
          "research_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^PED-WEB-"}},
          "decision_summary":{"type":"string","minLength":20}
        }
      }
    },
    "manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
