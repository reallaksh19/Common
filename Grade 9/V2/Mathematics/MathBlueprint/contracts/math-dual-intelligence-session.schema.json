{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-dual-intelligence-session.schema.json",
  "title": "Mathematics Dual Intelligence Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "schema_version",
    "subject",
    "run_ref",
    "bundle_ref",
    "first_role",
    "second_role",
    "first_agent_instance_id",
    "second_agent_instance_id",
    "first_work_order_ref",
    "first_context_ref",
    "first_package_ref",
    "second_independent_work_order_ref",
    "second_independent_context_ref",
    "second_independent_package_ref",
    "validation_work_order_ref",
    "validation_context_ref",
    "cross_validation_ref",
    "status",
    "session_digest"
  ],
  "properties": {
    "session_id": {"type": "string", "pattern": "^MATH-DIS-[0-9a-f]{16}$"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "run_ref": {"type": "string", "pattern": "^MATH-MLR-[0-9a-f]{16}$"},
    "bundle_ref": {"type": "string", "pattern": "^MATH-HB-[0-9a-f]{16}$"},
    "first_role": {"enum": ["CORE1", "CORE2"]},
    "second_role": {"enum": ["CORE1", "CORE2"]},
    "first_agent_instance_id": {"type": "string", "minLength": 1},
    "second_agent_instance_id": {"type": "string", "minLength": 1},
    "first_work_order_ref": {"type": "string", "pattern": "^MATH-WO-[0-9a-f]{16}$"},
    "first_context_ref": {"type": "string", "pattern": "^MATH-CTX-[0-9a-f]{16}$"},
    "first_package_ref": {"type": "string", "pattern": "^MATH-SP-[0-9a-f]{16}$"},
    "second_independent_work_order_ref": {"type": "string", "pattern": "^MATH-WO-[0-9a-f]{16}$"},
    "second_independent_context_ref": {"type": "string", "pattern": "^MATH-CTX-[0-9a-f]{16}$"},
    "second_independent_package_ref": {"type": "string", "pattern": "^MATH-SP-[0-9a-f]{16}$"},
    "validation_work_order_ref": {"type": "string", "pattern": "^MATH-WO-[0-9a-f]{16}$"},
    "validation_context_ref": {"type": "string", "pattern": "^MATH-CTX-[0-9a-f]{16}$"},
    "cross_validation_ref": {"type": "string", "pattern": "^MATH-XV-[0-9a-f]{16}$"},
    "status": {"const": "CROSS_VALIDATED"},
    "session_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
