{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mathematics-engineering-request.schema.json",
  "title": "MathematicsEngineeringRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","subject","request_id","scope_kind","scope_refs","engineering_depth","learning_purpose"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "request_id": {"type": "string", "pattern": "^MATH-ENG-REQ-[A-Z0-9_-]+$"},
    "scope_kind": {"enum": ["ENGINEERING_GATE","BUCKET"]},
    "scope_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "engineering_depth": {"enum": ["FOUNDATION","STANDARD","RESEARCH"]},
    "learning_purpose": {"enum": ["FIRST_STUDY","CONSOLIDATION","REVISION","COMPETITIVE_EXAM"]},
    "owner_decision_ref": {"type": ["string","null"], "minLength": 3}
  }
}
