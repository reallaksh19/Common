{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-routing-build-spec.schema.json",
  "title": "Mathematics Adaptive Routing Build Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","subject","ground_truth_ref","ground_truth_digest","candidate_subtopics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "ground_truth_ref": {"type": "string", "pattern": "^MATH-GT-[0-9a-f]{16}$"},
    "ground_truth_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_subtopics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subtopic"}}
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score","reason_codes","evidence_refs"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 4},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GT-[A-Z_]+-[0-9a-f]{16}$"}}
      }
    },
    "subtopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtopic_ref","display_name","sequence","coherence_group","scope_authority","semantic_source_strength","question_evidence","question_resolution","uncertainty","conflict_index","unresolved_issue_refs","conflict_refs"],
      "properties": {
        "subtopic_ref": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "coherence_group": {"type": "string", "minLength": 1},
        "scope_authority": {"$ref": "#/$defs/dimension"},
        "semantic_source_strength": {"$ref": "#/$defs/dimension"},
        "question_evidence": {"$ref": "#/$defs/dimension"},
        "question_resolution": {"$ref": "#/$defs/dimension"},
        "uncertainty": {"$ref": "#/$defs/dimension"},
        "conflict_index": {"$ref": "#/$defs/dimension"},
        "unresolved_issue_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "conflict_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
