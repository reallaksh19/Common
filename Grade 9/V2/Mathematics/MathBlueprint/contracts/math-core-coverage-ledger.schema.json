{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core-coverage-ledger.schema.json",
  "title": "Mathematics Cross-Core Coverage Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "ledger_id", "registry_ref", "coverage_scope", "subtopics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "ledger_id": {"type": "string", "pattern": "^MATH-COV-[A-Z0-9][A-Z0-9_-]{4,}$"},
    "registry_ref": {"type": "string", "pattern": "^MATH-REG-"},
    "coverage_scope": {"const": "FULL_REGISTRY"},
    "subtopics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subtopicCoverage"}}
  },
  "$defs": {
    "stage": {"enum": ["CORE1A", "CORE1B", "CORE2A", "CORE2B"]},
    "assetType": {"enum": ["CONCEPT","MODEL","EQUATION","DERIVATION","CAPABILITY","LEARNING_ATOM","REPRESENTATION","MISCONCEPTION","PROBLEM_FAMILY","SOURCE_QUESTION","CANONICAL_SOLUTION","EXAMPLE","VERIFICATION_RULE"]},
    "obligation": {"enum": ["REQUIRED", "CONDITIONAL", "OPTIONAL", "PROHIBITED", "NOT_APPLICABLE"]},
    "treatment": {"enum": ["EXPLAIN", "RECONSTRUCT", "REFERENCE", "USE_WHEN_REQUIRED", "HIDE_UNTIL_NEEDED", "EXEMPLIFY", "SOLVE", "TRANSFER", "VERIFY", "SOURCE_CUSTODY", "NONE"]},
    "disposition": {"enum": ["REALIZED", "RECONSTRUCTED", "REFERENCED", "USED", "PROHIBITED", "NOT_APPLICABLE", "INTENTIONALLY_OMITTED"]},
    "stageDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation", "treatment", "disposition", "realization_refs", "omission_reason", "owner_override_ref"],
      "properties": {
        "obligation": {"$ref": "#/$defs/obligation"},
        "treatment": {"$ref": "#/$defs/treatment"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "realization_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "omission_reason": {"type": ["string", "null"], "minLength": 8},
        "owner_override_ref": {"type": ["string", "null"], "minLength": 3}
      }
    },
    "assetCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_ref", "asset_type", "CORE1A", "CORE1B", "CORE2A", "CORE2B"],
      "properties": {
        "asset_ref": {"type": "string", "pattern": "^REG-MATH-"},
        "asset_type": {"$ref": "#/$defs/assetType"},
        "CORE1A": {"$ref": "#/$defs/stageDisposition"},
        "CORE1B": {"$ref": "#/$defs/stageDisposition"},
        "CORE2A": {"$ref": "#/$defs/stageDisposition"},
        "CORE2B": {"$ref": "#/$defs/stageDisposition"}
      }
    },
    "subtopicCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["subtopic_id", "asset_coverage"],
      "properties": {
        "subtopic_id": {"type": "string", "minLength": 3},
        "asset_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assetCoverage"}}
      }
    }
  }
}
