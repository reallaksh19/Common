{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mathematics-engineering-closure-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","subject","receipt_id","request_id","manifest_id","registry_id","registry_digest","invariant_profile_digest","direct_gate_ids","transitive_gate_ids","gate_states","counts","closure_status","publication_authorization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "receipt_id": {"type": "string", "pattern": "^MATH-ENG-CLOSURE-[A-Z0-9_-]+$"},
    "request_id": {"type": "string"},
    "manifest_id": {"type": "string"},
    "registry_id": {"const": "REG-MATH-TECH-GATE-V1"},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "invariant_profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "direct_gate_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "transitive_gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "gate_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id","derived_status","source_scope","declared_technical_readiness_ignored","declared_release_checklist_ignored"],
        "properties": {
          "gate_id": {"type": "string"},
          "derived_status": {"enum": ["ENGINEERING_GATE_READY","ENGINEERING_GATE_INCOMPLETE","SOURCE_SCOPE_HELD"]},
          "source_scope": {"type": "string"},
          "declared_technical_readiness_ignored": {"const": true},
          "declared_release_checklist_ignored": {"const": true},
          "failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_gate_count","transitive_gate_count","ready_gate_count","blocked_gate_count"],
      "properties": {
        "direct_gate_count": {"type": "integer", "minimum": 1},
        "transitive_gate_count": {"type": "integer", "minimum": 1},
        "ready_gate_count": {"type": "integer", "minimum": 0},
        "blocked_gate_count": {"type": "integer", "minimum": 0}
      }
    },
    "closure_status": {"enum": ["READY","BLOCKED"]},
    "publication_authorization": {"const": "NOT_IMPLIED"}
  }
}
