{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stem-learning-transition.candidate.schema.json",
  "title": "STEM Learning Transition Candidate",
  "description": "C5 design-only transition contract. Mathematical dependency remains subject-owned; instructional sequencing and repair remain pedagogy-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authority", "transition_id", "subject_id", "transition_authority_class", "transition_kind", "from_refs", "to_refs", "why_required", "new_cognitive_move", "basis_refs", "dependency_bindings", "transition_digest"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "DESIGN_CANDIDATE"},
    "authority": {"const": "NONE"},
    "transition_id": {"type": "string", "pattern": "^SIL-TRANS-[A-Z0-9][A-Z0-9_-]{3,}$"},
    "subject_id": {"type": "string", "minLength": 2},
    "transition_authority_class": {"enum": ["SUBJECT_REFERENCE_ONLY", "PEDAGOGY_GOVERNED", "ASSESSMENT_REFERENCE_ONLY", "OWNER_SEQUENCE"]},
    "transition_kind": {"enum": ["LOGICAL_DEPENDENCY_REFERENCE", "INSTRUCTIONAL_SEQUENCE", "REPRESENTATION_BRIDGE", "REPAIR_SEQUENCE", "ASSESSMENT_CAPABILITY_REFERENCE"]},
    "from_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "to_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "why_required": {"type": "string", "minLength": 8},
    "new_cognitive_move": {"type": "string", "minLength": 3},
    "representation_bridge_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "misconception_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "diagnostic_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "repair_transition_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "basis_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "pedagogy_claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "confidence": {"enum": ["LOW", "MODERATE", "HIGH"]},
    "contradiction_resolution_ref": {"type": ["string", "null"], "minLength": 3},
    "dependency_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "transition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"transition_kind": {"const": "LOGICAL_DEPENDENCY_REFERENCE"}}}, "then": {"properties": {"transition_authority_class": {"const": "SUBJECT_REFERENCE_ONLY"}}}},
    {"if": {"properties": {"transition_kind": {"const": "ASSESSMENT_CAPABILITY_REFERENCE"}}}, "then": {"properties": {"transition_authority_class": {"const": "ASSESSMENT_REFERENCE_ONLY"}}}},
    {"if": {"properties": {"transition_kind": {"enum": ["INSTRUCTIONAL_SEQUENCE", "REPRESENTATION_BRIDGE", "REPAIR_SEQUENCE"]}}}, "then": {"properties": {"transition_authority_class": {"enum": ["PEDAGOGY_GOVERNED", "OWNER_SEQUENCE"]}}}}
  ]
}
