{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stem-subtopic-intelligence-pack.candidate.schema.json",
  "title": "STEM Subtopic Intelligence Pack Candidate",
  "description": "C5 field-level design contract subordinate to the SIL contract-family candidate. The pack composes exact governed references; it cannot create technical, publication, learner-mastery, or subject-truth authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "view_class", "authority", "technical_authorization", "publication_authorization", "learner_mastery_claim", "pack_id", "subject_id", "canonical_subtopic_ref", "subject_adapter_ref", "authority_bindings", "subject_object_refs", "learning_transition_refs", "source_selection_profile_refs", "dependency_bindings", "known_gap_refs", "pack_digest"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "DESIGN_CANDIDATE"},
    "view_class": {"const": "COMPILED_SUBTOPIC_INTELLIGENCE_CONTEXT"},
    "authority": {"const": "COMPOSITION_OF_BOUND_GOVERNED_REFERENCES"},
    "technical_authorization": {"const": "NOT_GRANTED_BY_PACK"},
    "publication_authorization": {"const": "NOT_IMPLIED"},
    "learner_mastery_claim": {"const": "NOT_IMPLIED"},
    "pack_id": {"type": "string", "pattern": "^SIL-PACK-[A-Z0-9][A-Z0-9_-]{3,}$"},
    "subject_id": {"type": "string", "minLength": 2},
    "canonical_subtopic_ref": {"$ref": "#/$defs/exactRef"},
    "subject_adapter_ref": {"$ref": "#/$defs/exactRef"},
    "scope_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "authority_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependencyBinding"}},
    "subject_object_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "learning_transition_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "source_selection_profile_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "pedagogy_research_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "assessment_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "dependency_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependencyBinding"}},
    "known_gap_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/exactRef"}},
    "display_title": {"type": "string", "minLength": 1},
    "supported_learning_purpose_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "ref_type", "subject_id", "registry_ref", "registry_version_or_digest"],
      "properties": {
        "ref": {"type": "string", "minLength": 3},
        "ref_type": {"enum": ["SUBJECT_GATE", "CANONICAL_ASSET", "SCOPE_ITEM", "CAPABILITY", "PROBLEM_FAMILY", "SOURCE_QUESTION", "VERIFICATION_RULE", "RESEARCH_DECISION", "RESEARCH_CLAIM", "OWNER_DECISION", "SOURCE_CAPTURE", "SUBJECT_ADAPTER", "LEARNING_TRANSITION", "SOURCE_SELECTION_PROFILE", "LIBRARY_GAP", "COVERAGE_REPORT"]},
        "subject_id": {"type": "string", "minLength": 2},
        "registry_ref": {"type": "string", "minLength": 3},
        "registry_version_or_digest": {"type": "string", "minLength": 3},
        "authority_domain": {"enum": ["SUBJECT_ENGINEERING", "CANONICAL_DOMAIN", "SCOPE", "ASSESSMENT", "PEDAGOGY_RESEARCH", "OWNER_CONTROL", "SUBJECT_ADAPTER", "LEARNING_STRUCTURE", "SOURCE_SELECTION", "DERIVED_COVERAGE"]}
      }
    },
    "dependencyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "dependency_domain", "dependency_ref", "digest_or_version", "materiality", "staleness_action"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 3},
        "dependency_domain": {"enum": ["SUBJECT_TRUTH", "SCOPE", "LEARNING_STRUCTURE", "ASSESSMENT", "PEDAGOGY", "SOURCE_SELECTION", "OWNER_CONTROL", "ADAPTER"]},
        "dependency_ref": {"type": "string", "minLength": 3},
        "digest_or_version": {"type": "string", "minLength": 3},
        "materiality": {"enum": ["IDENTITY", "SUBJECT_TRUTH", "SCOPE", "LEARNING_STRUCTURE", "ASSESSMENT", "PEDAGOGY", "SOURCE_SELECTION", "OWNER_CONTROL", "ADAPTER"]},
        "staleness_action": {"enum": ["BLOCK_RECOMPILE_REQUIRED", "REVIEW_REQUIRED", "ADVISORY_REFRESH"]}
      }
    }
  }
}
