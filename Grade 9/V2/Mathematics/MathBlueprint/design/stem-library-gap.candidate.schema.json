{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stem-library-gap.candidate.schema.json",
  "title": "STEM Library Gap Candidate",
  "description": "C5 design-only first-class unresolved state. A gap routes work; it never auto-creates subject truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status_class", "authority", "gap_id", "subject_id", "gap_class", "severity", "affected_refs", "description", "owning_authority_domain", "recommended_action_class", "resolution_status"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status_class": {"const": "DESIGN_CANDIDATE"},
    "authority": {"const": "NONE"},
    "gap_id": {"type": "string", "pattern": "^SIL-GAP-[A-Z0-9][A-Z0-9_-]{3,}$"},
    "subject_id": {"type": "string", "minLength": 2},
    "pack_ref": {"type": ["string", "null"], "minLength": 3},
    "gap_class": {"enum": ["MISSING_SUBJECT_TRUTH", "MISSING_LOGICAL_PREREQUISITE", "MISSING_INSTRUCTIONAL_BRIDGE", "MISSING_REPRESENTATION_SUPPORT", "MISSING_MISCONCEPTION_REPAIR", "MISSING_ASSESSMENT_EVIDENCE", "MISSING_SOURCE_PROFILE", "MISSING_PEDAGOGY_EVIDENCE", "MISSING_SCOPE_AUTHORITY", "MISSING_CALIBRATION_POLICY", "RIGHTS_REVIEW", "ADAPTER_CAPABILITY_GAP"]},
    "severity": {"enum": ["ADVISORY", "REVIEW_REQUIRED", "BLOCKING"]},
    "affected_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "description": {"type": "string", "minLength": 8},
    "detected_by_ref": {"type": ["string", "null"], "minLength": 3},
    "owning_authority_domain": {"enum": ["SUBJECT_ENGINEERING", "CANONICAL_DOMAIN", "SCOPE", "ASSESSMENT", "LEARNING_STRUCTURE", "SOURCE_SELECTION", "PEDAGOGY_RESEARCH", "LAU_CALIBRATION", "SUBJECT_ADAPTER", "OWNER_CONTROL"]},
    "recommended_action_class": {"enum": ["ENRICH_ENGINEERING", "ADD_OR_REVIEW_SCOPE", "AUTHOR_LEARNING_TRANSITION", "CURATE_SOURCE_PROFILE", "ADD_ASSESSMENT_EVIDENCE", "VERIFY_ANSWER", "RUN_PEDAGOGY_RESEARCH", "RESOLVE_RIGHTS", "ADD_CALIBRATION_POLICY", "EXTEND_SUBJECT_ADAPTER", "OWNER_ADJUDICATION"]},
    "resolution_status": {"enum": ["OPEN", "UNDER_REVIEW", "BLOCKED_EXTERNAL", "RESOLVED", "WONT_FIX_WITH_REASON", "SUPERSEDED"]},
    "resolution_ref": {"type": ["string", "null"], "minLength": 3}
  },
  "allOf": [
    {"if": {"properties": {"resolution_status": {"const": "RESOLVED"}}}, "then": {"required": ["resolution_ref"], "properties": {"resolution_ref": {"type": "string", "minLength": 3}}}}
  ]
}
