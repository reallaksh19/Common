{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common.local/mathblueprint/design/mathematics-architecture-documentation-drift-audit.schema.json",
  "title": "Mathematics Architecture and Documentation Drift Audit (Design Evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "semantic_change",
    "audit_scope",
    "method",
    "snapshot",
    "classification_vocabulary",
    "findings",
    "confirmed_current_doctrine",
    "c1_catalog_comparison",
    "owner_decision_required_count",
    "c2_gate"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "C0_AUDIT_COMPLETE"},
    "authority": {"const": "NONE"},
    "semantic_change": {"const": "NONE"},
    "audit_scope": {"const": "ARCHITECTURE_AND_DOCUMENTATION_DRIFT"},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_basis",
        "comparison_order",
        "c1_catalog_used_as_authority",
        "independence_scope",
        "resolution_rule"
      ],
      "properties": {
        "primary_basis": {"const": "EXECUTABLE_FIRST"},
        "comparison_order": {"const": "EXECUTABLE_MODEL_THEN_NORMATIVE_DOCS_THEN_C1_CATALOG"},
        "c1_catalog_used_as_authority": {"const": false},
        "independence_scope": {"const": "INDEPENDENT_OF_C1_CATALOG_NOT_EXTERNAL_THIRD_PARTY"},
        "resolution_rule": {"type": "string", "minLength": 20}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "audited_head_sha"],
      "properties": {
        "repository": {"const": "reallaksh19/Common"},
        "branch": {"const": "v2-math-core1a-textbook-quality"},
        "audited_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "classification_vocabulary": {
      "const": [
        "CURRENT + EXECUTABLE",
        "CURRENT + DOCUMENTED ONLY",
        "STALE",
        "ROADMAP",
        "CONFLICTED / OWNER DECISION REQUIRED"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    },
    "confirmed_current_doctrine": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/doctrine"}
    },
    "c1_catalog_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_path",
        "comparison_stage",
        "catalog_authority",
        "component_count",
        "supported_component_count",
        "unsupported_component_ids",
        "comparison_result",
        "notes"
      ],
      "properties": {
        "catalog_path": {"const": "design/mathematics-architecture-catalog.candidate.json"},
        "comparison_stage": {"const": "AFTER_INDEPENDENT_EXECUTABLE_MODEL"},
        "catalog_authority": {"const": "NONE"},
        "component_count": {"type": "integer", "minimum": 1},
        "supported_component_count": {"type": "integer", "minimum": 0},
        "unsupported_component_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MATH-ARCH-"}
        },
        "comparison_result": {"enum": ["CONSISTENT_WITH_RECONCILIATION_NOTES", "GAPS_FOUND"]},
        "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}}
      }
    },
    "owner_decision_required_count": {"type": "integer", "minimum": 0},
    "c2_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_finding_ids", "required_remediations"],
      "properties": {
        "status": {"enum": ["READY_WITH_DOCUMENTATION_REMEDIATIONS", "BLOCKED_OWNER_DECISION_REQUIRED"]},
        "blocking_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C0-F[0-9]{3}$"}
        },
        "required_remediations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "evidence_kind", "observation"],
      "properties": {
        "path": {"type": "string", "minLength": 2, "pattern": "^(?!/)(?!.*\\.\\./\\.\\.).+"},
        "evidence_kind": {"enum": ["EXECUTABLE", "SCHEMA", "POLICY", "NORMATIVE_DOCUMENT", "DESIGN_DOCUMENT", "CI_EVIDENCE"]},
        "observation": {"type": "string", "minLength": 12}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "finding_kind",
        "classification",
        "severity",
        "affected_paths",
        "evidence",
        "current_doctrine",
        "c2_action",
        "owner_decision_required"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^C0-F[0-9]{3}$"},
        "title": {"type": "string", "minLength": 8},
        "finding_kind": {"enum": ["STALE_TOPOLOGY", "POLICY_CONFLICT", "ROOT_OMISSION", "PUBLICATION_TOPOLOGY_LAG", "SNAPSHOT_CUSTODY_WEAKNESS", "IMPLEMENTATION_GAP"]},
        "classification": {"enum": ["CURRENT + EXECUTABLE", "CURRENT + DOCUMENTED ONLY", "STALE", "ROADMAP", "CONFLICTED / OWNER DECISION REQUIRED"]},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "affected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidence"}},
        "current_doctrine": {"type": "string", "minLength": 20},
        "c2_action": {"type": "string", "minLength": 20},
        "owner_decision_required": {"type": "boolean"}
      }
    },
    "doctrine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doctrine_id", "statement", "classification", "evidence_paths"],
      "properties": {
        "doctrine_id": {"type": "string", "pattern": "^C0-D[0-9]{3}$"},
        "statement": {"type": "string", "minLength": 20},
        "classification": {"const": "CURRENT + EXECUTABLE"},
        "evidence_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      }
    }
  }
}
