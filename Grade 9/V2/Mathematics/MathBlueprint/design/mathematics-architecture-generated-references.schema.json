{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common.local/mathblueprint/design/mathematics-architecture-generated-references.schema.json",
  "title": "Mathematics Architecture Generated References (Design Only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "semantic_change",
    "view_class",
    "publication_authorization",
    "generation_rule",
    "source_custody",
    "component_count",
    "reference_counts",
    "components",
    "references"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "GENERATED_NON_AUTHORITATIVE_REFERENCE"},
    "authority": {"const": "NONE"},
    "semantic_change": {"const": "NONE"},
    "view_class": {"const": "DERIVED_ARCHITECTURE_REFERENCE_ONLY"},
    "publication_authorization": {"const": "NOT_IMPLIED"},
    "generation_rule": {"const": "CATALOG_DECLARED_EVIDENCE_PATHS_ONLY"},
    "source_custody": {"$ref": "#/$defs/source_custody"},
    "component_count": {"type": "integer", "minimum": 1},
    "reference_counts": {"$ref": "#/$defs/reference_counts"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SCHEMA", "POLICY", "VALIDATOR", "TEST"],
      "properties": {
        "SCHEMA": {"$ref": "#/$defs/reference_rows"},
        "POLICY": {"$ref": "#/$defs/reference_rows"},
        "VALIDATOR": {"$ref": "#/$defs/reference_rows"},
        "TEST": {"$ref": "#/$defs/reference_rows"}
      }
    }
  },
  "$defs": {
    "source_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_path",
        "catalog_git_blob_sha",
        "catalog_schema_path",
        "catalog_schema_git_blob_sha",
        "c2_receipt_path",
        "c2_receipt_git_blob_sha",
        "generator_path",
        "generator_git_blob_sha"
      ],
      "properties": {
        "catalog_path": {"const": "design/mathematics-architecture-catalog.candidate.json"},
        "catalog_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "catalog_schema_path": {"const": "design/mathematics-architecture-catalog.candidate.schema.json"},
        "catalog_schema_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "c2_receipt_path": {"const": "design/mathematics-normative-root-consolidation.json"},
        "c2_receipt_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generator_path": {"const": "design/generate_mathematics_architecture_references.py"},
        "generator_git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "reference_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SCHEMA", "POLICY", "VALIDATOR", "TEST"],
      "properties": {
        "SCHEMA": {"type": "integer", "minimum": 0},
        "POLICY": {"type": "integer", "minimum": 0},
        "VALIDATOR": {"type": "integer", "minimum": 0},
        "TEST": {"type": "integer", "minimum": 0}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "architecture_role",
        "primary_authority_class",
        "runtime_authority_effect",
        "publication_authority_effect"
      ],
      "properties": {
        "component_id": {"type": "string", "pattern": "^MATH-ARCH-[A-Z0-9-]+$"},
        "architecture_role": {"type": "string", "minLength": 2},
        "primary_authority_class": {"type": "string", "minLength": 2},
        "runtime_authority_effect": {"type": "string", "minLength": 2},
        "publication_authority_effect": {"type": "string", "minLength": 2}
      }
    },
    "reference_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "path"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^MATH-ARCH-[A-Z0-9-]+$"},
          "path": {"type": "string", "minLength": 2, "pattern": "^(?!/)(?!.*\\.\\./\\.\\.).+"}
        }
      }
    }
  }
}
