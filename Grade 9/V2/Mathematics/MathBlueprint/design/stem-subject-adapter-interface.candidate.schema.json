{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common.local/mathblueprint/design/stem-subject-adapter-interface.candidate.schema.json",
  "title": "STEM Subject Adapter Interface Candidate (Design Only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "semantic_change",
    "runtime_migration_authorized",
    "production_consumers_allowed",
    "source_stage",
    "generic_kernel_boundary",
    "interface_operations",
    "mathematics_projection",
    "chemistry_stress_target",
    "tracked_runtime_gap",
    "next_stage"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "C4_SUBJECT_ADAPTER_INTERFACE_CANDIDATE"},
    "authority": {"const": "NONE"},
    "semantic_change": {"const": "NONE"},
    "runtime_migration_authorized": {"const": false},
    "production_consumers_allowed": {"const": false},
    "source_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c3_receipt_path", "required_status", "required_next_stage"],
      "properties": {
        "c3_receipt_path": {"const": "design/mathematics-generated-references.receipt.json"},
        "required_status": {"const": "C3_GENERATED_REFERENCES_COMPLETE"},
        "required_next_stage": {"const": "C4_SUBJECT_ADAPTER_INTERFACE_READY"}
      }
    },
    "generic_kernel_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "must_not_encode_subject_truth", "topic_specific_dispatch_forbidden"],
      "properties": {
        "owns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IDENTITY",
              "SCOPE_MEMBERSHIP",
              "PROVENANCE",
              "MATURITY",
              "EXACT_REFERENCE_CUSTODY",
              "DISCOVERY_NON_AUTHORITY",
              "RESEARCH_EVIDENCE_PROMOTION",
              "LEARNER_CALIBRATION",
              "LEARNING_PURPOSE_CONTROL",
              "PREREQUISITE_TRANSITION_COMPOSITION",
              "ASSESSMENT_CUSTODY",
              "TTU_LIFECYCLE",
              "PUBLICATION_LIFECYCLE",
              "VERSIONING_INVALIDATION",
              "RISK_LIMITATION_REPORTING"
            ]
          }
        },
        "must_not_encode_subject_truth": {"const": true},
        "topic_specific_dispatch_forbidden": {"const": true}
      }
    },
    "interface_operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/interfaceOperation"}
    },
    "mathematics_projection": {"$ref": "#/$defs/mathematicsProjection"},
    "chemistry_stress_target": {"$ref": "#/$defs/chemistryStressTarget"},
    "tracked_runtime_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "classification", "runtime_auto_materialization_executable"],
      "properties": {
        "finding_id": {"const": "C0-F007"},
        "classification": {"const": "CURRENT + DOCUMENTED ONLY"},
        "runtime_auto_materialization_executable": {"const": false}
      }
    },
    "next_stage": {"const": "C5_SUBTOPIC_INTELLIGENCE_LIBRARY_CONTRACTS_READY"}
  },
  "$defs": {
    "operationId": {
      "enum": [
        "DISCOVER_CANDIDATES",
        "RESOLVE_EXACT_IDENTITY",
        "VALIDATE_SUBJECT_AUTHORITY",
        "COMPUTE_PREREQUISITE_CLOSURE",
        "RETURN_CANONICAL_OBJECTS",
        "VALIDATE_TRANSFORMATION",
        "VALIDATE_REPRESENTATION",
        "VALIDATE_VERIFICATION_RULE",
        "VALIDATE_SUBJECT_SAFETY"
      ]
    },
    "interfaceOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "requirement", "authority_semantics", "contract"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "requirement": {"enum": ["CORE", "CONDITIONAL_SUBJECT_CAPABILITY"]},
        "authority_semantics": {
          "enum": [
            "NON_AUTHORITATIVE_DISCOVERY_ONLY",
            "CONSUMES_EXISTING_SUBJECT_AUTHORITY",
            "DERIVES_FROM_EXISTING_SUBJECT_AUTHORITY"
          ]
        },
        "contract": {"type": "string", "minLength": 16}
      }
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "binding_status", "component_ids", "evidence_paths"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/operationId"},
        "binding_status": {"const": "CURRENT_BEHAVIOR_REFERENCE_ONLY"},
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MATH-ARCH-[A-Z0-9-]+$"}
        },
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/).+"}
        }
      }
    },
    "mathematicsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "projection_status",
        "authority",
        "runtime_path_unchanged",
        "validation_weakened",
        "authority_owner",
        "canonical_object_schema_path",
        "canonical_object_types",
        "operation_bindings"
      ],
      "properties": {
        "subject_id": {"const": "MATHEMATICS"},
        "projection_status": {"const": "DESIGN_PROJECTION_OF_CURRENT_EXECUTABLE_BEHAVIOR"},
        "authority": {"const": "NONE"},
        "runtime_path_unchanged": {"const": true},
        "validation_weakened": {"const": false},
        "authority_owner": {"const": "MATHEMATICS_ENGINEERING_AND_GOVERNED_DOMAIN_DATA"},
        "canonical_object_schema_path": {"const": "contracts/math-canonical-domain-registry.schema.json"},
        "canonical_object_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        },
        "operation_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operationBinding"}
        }
      }
    },
    "chemistryStressTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "status",
        "authority",
        "runtime_binding_present",
        "production_registry_ref",
        "production_validator_ref",
        "candidate_object_types",
        "required_subject_specific_controls"
      ],
      "properties": {
        "subject_id": {"const": "CHEMISTRY"},
        "status": {"const": "DESIGN_STRESS_TARGET_ONLY"},
        "authority": {"const": "NONE"},
        "runtime_binding_present": {"const": false},
        "production_registry_ref": {"type": "null"},
        "production_validator_ref": {"type": "null"},
        "candidate_object_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        },
        "required_subject_specific_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "MACRO_PARTICLE_SYMBOLIC_COORDINATION",
              "CHEMICAL_IDENTITY_AND_NOMENCLATURE",
              "MEASUREMENT_UNIT_UNCERTAINTY",
              "REACTION_CONDITION_CUSTODY",
              "LAB_SAFETY_AUTHORITY"
            ]
          }
        }
      }
    }
  }
}
