{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common.local/mathblueprint/design/stem-subtopic-intelligence-contract-family.candidate.schema.json",
  "title": "STEM Subtopic Intelligence Contract Family Candidate (Design Only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority",
    "semantic_change",
    "runtime_migration_authorized",
    "production_consumers_allowed",
    "source_stage",
    "central_doctrine",
    "contract_objects",
    "dependency_classes",
    "exact_reference_contract",
    "compiled_pack_locks",
    "mathematics_reference_projection",
    "pr395_integration",
    "promotion_requirements",
    "tracked_runtime_gap",
    "next_stage"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "status": {"const": "C5_SUBTOPIC_INTELLIGENCE_CONTRACT_FAMILY_CANDIDATE"},
    "authority": {"const": "NONE"},
    "semantic_change": {"const": "NONE"},
    "runtime_migration_authorized": {"const": false},
    "production_consumers_allowed": {"const": false},
    "source_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c4_receipt_path", "required_status", "required_next_stage"],
      "properties": {
        "c4_receipt_path": {"const": "design/mathematics-subject-adapter-equivalence.receipt.json"},
        "required_status": {"const": "C4_SUBJECT_ADAPTER_INTERFACE_EXTRACTED"},
        "required_next_stage": {"const": "C5_SUBTOPIC_INTELLIGENCE_LIBRARY_CONTRACTS_READY"}
      }
    },
    "central_doctrine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_model",
        "subject_truth_owner",
        "pack_may_define_subject_truth",
        "exact_authority_resolution_required",
        "topic_specific_dispatch_forbidden",
        "learner_state_is_run_specific",
        "coverage_may_authorize"
      ],
      "properties": {
        "pack_model": {"const": "COMPILED_DIGEST_BOUND_CONTEXT_VIEW"},
        "subject_truth_owner": {"const": "SUBJECT_ENGINEERING_AND_CANONICAL_DOMAIN"},
        "pack_may_define_subject_truth": {"const": false},
        "exact_authority_resolution_required": {"const": true},
        "topic_specific_dispatch_forbidden": {"const": true},
        "learner_state_is_run_specific": {"const": true},
        "coverage_may_authorize": {"const": false}
      }
    },
    "contract_objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contractObject"}
    },
    "dependency_classes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependencyClass"}
    },
    "exact_reference_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "free_text_may_promote", "unresolved_ref_action"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["ref", "ref_type", "subject_id", "registry_ref", "registry_version_or_digest"]}
        },
        "free_text_may_promote": {"const": false},
        "unresolved_ref_action": {"const": "EMIT_GAP_AND_BLOCK_DEPENDENT_CLAIM"}
      }
    },
    "compiled_pack_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_class", "authority", "technical_authorization", "publication_authorization", "learner_mastery_claim"],
      "properties": {
        "view_class": {"const": "COMPILED_SUBTOPIC_INTELLIGENCE_CONTEXT"},
        "authority": {"const": "COMPOSITION_OF_BOUND_GOVERNED_REFERENCES"},
        "technical_authorization": {"const": "NOT_GRANTED_BY_PACK"},
        "publication_authorization": {"const": "NOT_IMPLIED"},
        "learner_mastery_claim": {"const": "NOT_IMPLIED"}
      }
    },
    "mathematics_reference_projection": {"$ref": "#/$defs/mathematicsProjection"},
    "pr395_integration": {"$ref": "#/$defs/pr395Integration"},
    "promotion_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXACT_ID_RESOLUTION",
          "CURRENT_AUTHORITY_REVALIDATION",
          "DIGEST_BOUND_DEPENDENCIES",
          "NO_INLINE_SUBJECT_TRUTH",
          "NO_DISCOVERY_TO_AUTHORITY",
          "EXPLICIT_GAP_ON_MISSING",
          "PRODUCTION_RUNTIME_SEPARATION",
          "DETERMINISTIC_COMPILATION",
          "LEARNER_STATE_SEPARATION"
        ]
      }
    },
    "tracked_runtime_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "classification", "runtime_auto_materialization_executable"],
      "properties": {
        "finding_id": {"const": "C0-F007"},
        "classification": {"const": "CURRENT + DOCUMENTED ONLY"},
        "runtime_auto_materialization_executable": {"const": false}
      }
    },
    "next_stage": {"const": "C6_MATHEMATICS_SIL_PILOT_READY"}
  },
  "$defs": {
    "contractId": {
      "enum": [
        "STEM-SIL-SUBTOPIC-PACK",
        "STEM-SIL-LEARNING-TRANSITION",
        "STEM-SIL-SOURCE-SELECTION-PROFILE",
        "STEM-SIL-LIBRARY-GAP",
        "STEM-SIL-COVERAGE-REPORT"
      ]
    },
    "ownershipClass": {
      "enum": [
        "COMPOSITION_VIEW",
        "GOVERNED_LEARNING_STRUCTURE",
        "GOVERNED_SOURCE_SELECTION",
        "GAP_TRACKING",
        "DERIVED_AUDIT"
      ]
    },
    "referenceClass": {
      "enum": [
        "EXACT_SUBJECT_REFERENCE",
        "EXACT_SCOPE_REFERENCE",
        "ASSESSMENT_REFERENCE",
        "PEDAGOGY_EVIDENCE_REFERENCE",
        "OWNER_DECISION_REFERENCE",
        "DEPENDENCY_BINDING",
        "KNOWN_GAP_REFERENCE"
      ]
    },
    "contractObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "ownership_class",
        "may_inline_subject_truth",
        "may_grant_technical_authority",
        "may_grant_publication_authority",
        "required_reference_classes"
      ],
      "properties": {
        "contract_id": {"$ref": "#/$defs/contractId"},
        "ownership_class": {"$ref": "#/$defs/ownershipClass"},
        "may_inline_subject_truth": {"const": false},
        "may_grant_technical_authority": {"const": false},
        "may_grant_publication_authority": {"const": false},
        "required_reference_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/referenceClass"}
        }
      }
    },
    "dependencyClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_class", "owner_domain", "sil_may_define", "required_support_class"],
      "properties": {
        "dependency_class": {
          "enum": [
            "LOGICAL_DEPENDENCY",
            "ASSESSMENT_CAPABILITY_DEPENDENCY",
            "INSTRUCTIONAL_SEQUENCE",
            "REPRESENTATION_BRIDGE",
            "REPAIR_SEQUENCE"
          ]
        },
        "owner_domain": {
          "enum": ["SUBJECT_ENGINEERING", "ASSESSMENT", "LEARNING_STRUCTURE"]
        },
        "sil_may_define": {"type": "boolean"},
        "required_support_class": {"$ref": "#/$defs/referenceClass"}
      }
    },
    "mathematicsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "projection_status", "canonical_object_schema_path", "canonical_object_types"],
      "properties": {
        "subject_id": {"const": "MATHEMATICS"},
        "projection_status": {"const": "CURRENT_REFERENCE_VOCABULARY_ONLY_NOT_GENERIC_KERNEL"},
        "canonical_object_schema_path": {"const": "contracts/math-canonical-domain-registry.schema.json"},
        "canonical_object_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha", "source_role", "disposition"],
      "properties": {
        "path": {"type": "string", "minLength": 3, "pattern": "^(?!/).+"},
        "git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_role": {
          "enum": [
            "CANDIDATE_PACKET_CORPUS",
            "CANDIDATE_STRUCTURAL_VALIDATOR",
            "NON_AUTHORITATIVE_RESEARCH_INPUT",
            "DERIVED_OBSERVABILITY_GENERATOR"
          ]
        },
        "disposition": {
          "enum": [
            "ADAPT_TO_REFERENCE_NORMALIZED_CANDIDATES",
            "REPLACE_WITH_EXACT_REFERENCE_VALIDATION",
            "RETAIN_AS_NON_AUTHORITATIVE_RESEARCH_INPUT",
            "DEFER_UNTIL_NORMALIZED_CATALOG"
          ]
        }
      }
    },
    "layerMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_layer", "normalized_disposition", "automatic_authority_promotion"],
      "properties": {
        "source_layer": {
          "enum": [
            "LAYER_1_MATHEMATICAL_CORE",
            "LAYER_2_COGNITIVE_TRANSFORMATIONS",
            "LAYER_3_RECONSTRUCTABLE_TTU",
            "LAYER_4_PROBLEM_FAMILIES"
          ]
        },
        "normalized_disposition": {
          "enum": [
            "EXACT_SUBJECT_REFERENCE_OR_GAP",
            "EXACT_DOMAIN_REFERENCE_PLUS_GOVERNED_LEARNING_TRANSITION_OR_GAP",
            "NON_AUTHORITATIVE_TTU_CANDIDATE_INPUT_ONLY",
            "EXACT_PROBLEM_FAMILY_OR_ASSESSMENT_REFERENCE_OR_GAP"
          ]
        },
        "automatic_authority_promotion": {"const": false}
      }
    },
    "pr395Integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_pr",
        "source_head_sha",
        "merge_base_with_c4",
        "source_relation",
        "import_mode",
        "candidate_packet_count",
        "packet_authority",
        "direct_runtime_import_allowed",
        "direct_normative_import_allowed",
        "source_artifacts",
        "layer_mapping"
      ],
      "properties": {
        "source_repository": {"const": "reallaksh19/Common"},
        "source_pr": {"const": 395},
        "source_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "merge_base_with_c4": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_relation": {"const": "DIVERGED_21_AHEAD_9_BEHIND_AT_C5_AUDIT"},
        "import_mode": {"const": "DIGEST_PINNED_CANDIDATE_SOURCE_ONLY"},
        "candidate_packet_count": {"const": 15},
        "packet_authority": {"const": "NONE"},
        "direct_runtime_import_allowed": {"const": false},
        "direct_normative_import_allowed": {"const": false},
        "source_artifacts": {
          "type": "array",
          "minItems": 4,
          "items": {"$ref": "#/$defs/sourceArtifact"}
        },
        "layer_mapping": {
          "type": "array",
          "minItems": 4,
          "items": {"$ref": "#/$defs/layerMapping"}
        }
      }
    }
  }
}
