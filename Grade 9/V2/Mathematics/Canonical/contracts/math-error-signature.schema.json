{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-error-signature.schema.json",
  "title": "MathErrorSignature V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["error_signature_id","subject","description","observable_pattern","candidate_capability_refs"],
  "properties": {
    "error_signature_id": {"type":"string","pattern":"^MATH-ERR-[A-Z0-9-]+$"},
    "subject": {"const":"MATHEMATICS"},
    "description": {"type":"string","minLength":1},
    "observable_pattern": {"type":"string","minLength":1},
    "candidate_capability_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^MATH-[A-Z0-9-]+$"}},
    "must_not_imply": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
