{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-reasoning-contract.schema.json",
  "title": "MathReasoningContract V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["reasoning_contract_id","subject","question_family_ref","concept_refs","checkpoints","validation_rules"],
  "properties": {
    "reasoning_contract_id": {"type":"string","pattern":"^MATH-RC-[A-Z0-9-]+$"},
    "subject": {"const":"MATHEMATICS"},
    "question_family_ref": {"type":"string","minLength":1},
    "concept_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "prerequisite_capability_refs": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "checkpoints": {"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["checkpoint_id","stage","required_capability_refs","success_evidence"],"properties":{"checkpoint_id":{"type":"string","minLength":1},"stage":{"enum":["UNDERSTAND_OBJECT","SELECT_REPRESENTATION","RECOGNIZE_STRUCTURE","SELECT_OPERATION","TRANSFORM","PRESERVE_INVARIANT","CHECK_CONDITIONS","VERIFY_RESULT"]},"required_capability_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^MATH-[A-Z0-9-]+$"}},"invariant_to_preserve":{"type":"string","minLength":1},"success_evidence":{"type":"string","minLength":1},"error_signature_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^MATH-ERR-[A-Z0-9-]+$"}}}}},
    "validation_rules": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
