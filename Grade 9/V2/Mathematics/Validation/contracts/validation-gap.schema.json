{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"validation-gap.schema.json",
  "type":"object","additionalProperties":false,
  "required":["gap_id","candidate_sha256","reference_sha256","dimensions","findings","required_action","upstream_mutation"],
  "properties":{
    "gap_id":{"type":"string"},
    "candidate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "reference_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "dimensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "findings":{"type":"array","minItems":1,"items":{"type":"string"}},
    "required_action":{"const":"REVISION_CYCLE"},
    "upstream_mutation":{"const":false}
  }
}
