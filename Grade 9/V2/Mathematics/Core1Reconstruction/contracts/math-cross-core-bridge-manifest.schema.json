{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-cross-core-bridge-manifest.schema.json",
  "title": "Mathematics Cross-Core Bridge Manifest",
  "description": "Makes the release invariant machine-falsifiable: Core2 required reasoning evidence minus Core1 realized teaching evidence must be the empty set. A lesson reference is not sufficient evidence - the linkage is at the level of the individual reasoning state, because the stress test found Core2 exposing six-state chains while the lesson that supposedly prepared the learner contained a theorem statement and one exercise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bridge_id", "schema_version", "subject", "topic_ref", "rows", "unresolved",
               "bridge_digest"],
  "properties": {
    "bridge_id": {"type": "string", "pattern": "^MATH-CCB-[0-9a-f]{16}$"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "topic_ref": {"type": "string", "minLength": 3},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["core2_question_ref", "atomic_ask_ref", "concept_refs",
                     "prerequisite_refs", "reasoning_states", "representation_requirements",
                     "verification_witness", "core1_evidence_refs",
                     "first_recovery_evidence_ref"],
        "properties": {
          "core2_question_ref": {"type": "string", "minLength": 2},
          "atomic_ask_ref": {"type": "string", "minLength": 2},
          "concept_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "prerequisite_refs": {"type": "array", "items": {"type": "string"}},
          "reasoning_states": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "trivial", "core1_evidence_ref"],
              "properties": {
                "role": {"type": "string", "minLength": 3},
                "trivial": {"type": "boolean"},
                "uses_converse": {"type": "boolean"},
                "core1_evidence_ref": {"type": ["string", "null"]}
              }
            }
          },
          "representation_requirements": {"type": "array", "items": {"type": "string"}},
          "verification_witness": {"type": "string", "minLength": 10},
          "core1_evidence_refs": {"type": "array", "minItems": 1,
                                  "items": {"type": "string"}},
          "first_recovery_evidence_ref": {"type": "string", "minLength": 4}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "bridge_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
