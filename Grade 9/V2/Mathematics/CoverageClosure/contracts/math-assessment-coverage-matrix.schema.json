{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-assessment-coverage-matrix.schema.json",
  "title":"MathAssessmentCoverageMatrix",
  "type":"object","additionalProperties":false,
  "required":["matrix_id","schema_version","subject","question_set_ref","scope_binding_registry_ref","core2_plan_ref","rows","matrix_digest"],
  "properties":{
    "matrix_id":{"type":"string","pattern":"^MATH-COV-[0-9a-f]{16}$"},"schema_version":{"const":"1.0.0"},"subject":{"const":"MATHEMATICS"},
    "question_set_ref":{"type":"string"},"scope_binding_registry_ref":{"type":"string"},"core2_plan_ref":{"type":"string"},
    "rows":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["item_ref","question_ref","part_ref","mapping_state","topic_refs","concept_refs","capability_refs","prerequisite_refs","problem_family_refs","core1_links","core1_problem_authoring_obligation_refs","core2_page_ref","core2_page_digest","source_question_digest","hint_levels","reasoning_route_ref","verification_obligation_refs","treatment_decisions","evidence_contract_ref","longitudinal_owner_refs"],
      "properties":{
        "item_ref":{"type":"string"},"question_ref":{"type":"string"},"part_ref":{"type":["string","null"]},"mapping_state":{"type":"string"},
        "topic_refs":{"type":"array","items":{"type":"string"}},"concept_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"capability_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"prerequisite_refs":{"type":"array","items":{"type":"string"}},"problem_family_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "core1_links":{"type":"array","minItems":1,"items":{"type":"object","required":["stable_id","learner_title","capability_ref","linkage_state"],"properties":{"stable_id":{"type":"string"},"learner_title":{"type":"string"},"capability_ref":{"type":"string"},"linkage_state":{"type":"string"}}}},
        "core1_problem_authoring_obligation_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^MATH-C1-PROBLEM-OBL-"}},
        "core2_page_ref":{"type":"string","pattern":"^Q[0-9]+$"},"core2_page_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_question_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "hint_levels":{"type":"array","minItems":3,"maxItems":3,"items":{"enum":["H1","H2","H3"]}},"reasoning_route_ref":{"type":"string"},"verification_obligation_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^VERIFY_"}},
        "treatment_decisions":{"type":"array","minItems":1,"items":{"type":"object","required":["capability_ref","treatment"],"properties":{"capability_ref":{"type":"string"},"treatment":{"type":"string"}}}},
        "evidence_contract_ref":{"const":"MATH-TRANSFER-EVIDENCE-v1"},"longitudinal_owner_refs":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^MATH-"}}
      }
    }},
    "matrix_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
