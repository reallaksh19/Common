{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-coverage-closure-package.schema.json",
  "title":"MathCoverageClosurePackage",
  "type":"object","additionalProperties":false,
  "required":["package_id","schema_version","subject","assessment_coverage_matrix","publication_coverage_closure","transfer_evidence_events","learner_state_updates","longitudinal_updates","package_digest"],
  "properties":{
    "package_id":{"type":"string","pattern":"^MATH-MJ-[0-9a-f]{16}$"},"schema_version":{"const":"1.0.0"},"subject":{"const":"MATHEMATICS"},
    "assessment_coverage_matrix":{"$ref":"math-assessment-coverage-matrix.schema.json"},
    "publication_coverage_closure":{"$ref":"math-publication-coverage-closure.schema.json"},
    "transfer_evidence_events":{"type":"array","items":{"$ref":"math-transfer-evidence-event.schema.json"}},
    "learner_state_updates":{"type":"array","items":{"$ref":"math-learner-state-update.schema.json"}},
    "longitudinal_updates":{"type":"array","items":{"$ref":"math-longitudinal-update.schema.json"}},
    "package_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
