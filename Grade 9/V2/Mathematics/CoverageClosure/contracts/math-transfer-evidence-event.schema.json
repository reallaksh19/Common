{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-transfer-evidence-event.schema.json",
  "title":"MathTransferEvidenceEvent",
  "type":"object","additionalProperties":false,
  "required":["event_id","schema_version","subject","question_ref","core2_page_digest","source_question_digest","support_consumed","evidence_state","verification_state","response_correctness","reasoning_validity","capability_refs","assessment_validity_state","diagnostic_use","negative_inference_allowed","mastery_evidence_allowed","event_digest"],
  "properties":{
    "event_id":{"type":"string","pattern":"^MATH-TEV-[0-9a-f]{16}$"},
    "schema_version":{"const":"1.0.0"},"subject":{"const":"MATHEMATICS"},
    "question_ref":{"type":"string","pattern":"^Q[0-9]+$"},
    "core2_page_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_question_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "support_consumed":{"enum":["NONE","H1","H2","H3","SOLUTION"]},
    "evidence_state":{"enum":["INDEPENDENT_SUCCESS","H1_SUCCESS","H2_SUCCESS","H3_SUCCESS","SOLUTION_EXPOSED","CORRECT_ANSWER_INVALID_REASONING","INCORRECT_AFTER_SUPPORT","NO_ATTEMPT"]},
    "verification_state":{"enum":["VERIFICATION_SUCCESS","VERIFICATION_FAILURE","VERIFICATION_NOT_ATTEMPTED","VERIFICATION_NOT_APPLICABLE"]},
    "response_correctness":{"enum":["CORRECT","INCORRECT","NO_RESPONSE"]},
    "reasoning_validity":{"enum":["VALID","INVALID","NOT_REVIEWED","NO_REASONING"]},
    "capability_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^MATH-"}},
    "assessment_validity_state":{"type":"string"},"diagnostic_use":{"type":"string"},
    "negative_inference_allowed":{"type":"boolean"},"mastery_evidence_allowed":{"type":"boolean"},
    "event_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
