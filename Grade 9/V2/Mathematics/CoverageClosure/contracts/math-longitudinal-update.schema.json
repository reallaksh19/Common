{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-longitudinal-update.schema.json",
  "title":"MathLongitudinalUpdate",
  "type":"object","additionalProperties":false,
  "required":["longitudinal_update_id","schema_version","subject","event_ref","capability_obligations","invariant","update_digest"],
  "properties":{
    "longitudinal_update_id":{"type":"string","pattern":"^MATH-LONG-[0-9a-f]{16}$"},
    "schema_version":{"const":"1.0.0"},"subject":{"const":"MATHEMATICS"},"event_ref":{"type":"string","pattern":"^MATH-TEV-"},
    "capability_obligations":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["capability_ref","dimensions"],
      "properties":{"capability_ref":{"type":"string","pattern":"^MATH-"},"dimensions":{"type":"array","minItems":8,"maxItems":8,"items":{
        "type":"object","additionalProperties":false,
        "required":["dimension","prior_status","resulting_status","evidence_needed","owner_capability_ref","closed_by_event"],
        "properties":{"dimension":{"enum":["acquisition","independent_reconstruction","delayed_retention","near_transfer","far_transfer","mixed_discrimination","fluency","timed_performance"]},"prior_status":{"type":"string"},"resulting_status":{"enum":["NOT_EVIDENCED","PARTIAL_CURRENT_EVIDENCE","CURRENT_EVIDENCE","OPEN_FUTURE_EVIDENCE"]},"evidence_needed":{"type":"string","minLength":8},"owner_capability_ref":{"type":"string","pattern":"^MATH-"},"closed_by_event":{"type":"boolean"}}
      }}}}
    },
    "invariant":{"const":"CURRENT_SUCCESS_DOES_NOT_CLOSE_DELAYED_OR_TRANSFER_OBLIGATIONS"},
    "update_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
