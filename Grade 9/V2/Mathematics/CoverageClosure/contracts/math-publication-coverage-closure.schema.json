{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-publication-coverage-closure.schema.json",
  "title":"MathPublicationCoverageClosure",
  "type":"object","additionalProperties":false,
  "required":["closure_id","schema_version","subject","matrix_ref","matrix_digest","semantic_closure_status","publication_closure_status","publication_blockers","gap_report","closure_digest"],
  "properties":{
    "closure_id":{"type":"string","pattern":"^MATH-PUBC-[0-9a-f]{16}$"},"schema_version":{"const":"1.0.0"},"subject":{"const":"MATHEMATICS"},"matrix_ref":{"type":"string"},"matrix_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "semantic_closure_status":{"const":"PASS"},"publication_closure_status":{"enum":["PASS","BLOCKED_UPSTREAM_PCK_PROMOTION"]},
    "publication_blockers":{"type":"array","items":{"type":"string"}},
    "gap_report":{"type":"object","additionalProperties":false,"required":["question_without_core1_coverage","question_without_core2_transfer","capability_without_instructional_treatment","core2_page_without_source_custody","reasoning_route_without_problem_family_authority","transfer_event_without_learner_state_update_semantics","future_obligation_without_longitudinal_owner"],"properties":{
      "question_without_core1_coverage":{"type":"array"},"question_without_core2_transfer":{"type":"array"},"capability_without_instructional_treatment":{"type":"array"},"core2_page_without_source_custody":{"type":"array"},"reasoning_route_without_problem_family_authority":{"type":"array"},"transfer_event_without_learner_state_update_semantics":{"type":"array"},"future_obligation_without_longitudinal_owner":{"type":"array"}
    }},
    "closure_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
