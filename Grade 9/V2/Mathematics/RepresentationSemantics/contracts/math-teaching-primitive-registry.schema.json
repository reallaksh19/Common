{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-teaching-primitive-registry.schema.json",
  "title": "Mathematics Teaching Primitive Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "schema_version",
    "subject",
    "primitives",
    "registry_digest"
  ],
  "properties": {
    "registry_id": {
      "const": "MATH-TEACHING-PRIMITIVES-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "MATHEMATICS"
    },
    "primitives": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "math-teaching-primitive.schema.json"
      }
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
