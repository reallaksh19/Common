{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core1a-bucket-plan.schema.json",
  "title": "Mathematics Core1A Bucket Plan",
  "description": "Canonical Core1A semantic contract. Groups capability-level Core1 lessons into coherent teaching buckets while preserving the learner state/treatment already decided by M-E/M-F.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bucket_plan_id",
    "schema_version",
    "subject",
    "source_core1_study_plan_ref",
    "source_core1_plan_digest",
    "source_study_model_ref",
    "source_study_model_digest",
    "release_class",
    "buckets",
    "coverage",
    "plan_digest"
  ],
  "properties": {
    "bucket_plan_id": {"type": "string", "pattern": "^MATH-C1ABP-[0-9a-f]{16}$"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "source_core1_study_plan_ref": {"type": "string", "pattern": "^MATH-C1SP-"},
    "source_core1_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_study_model_ref": {"type": "string", "minLength": 3},
    "source_study_model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_class": {"enum": ["PRODUCTION", "PROVISIONAL_PENDING_EXPERT_REVIEW", "TEST_ONLY"]},
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bucket_id",
          "title",
          "bucket_invariant",
          "member_capability_refs",
          "primary_capability_refs",
          "supporting_capability_refs",
          "source_core1_lesson_refs",
          "assessment_question_refs",
          "core2_question_refs",
          "problem_family_refs",
          "pck_asset_refs",
          "learner_treatment_by_capability",
          "dependency_edges",
          "learning_atoms",
          "representation_requirements",
          "verification_requirements"
        ],
        "properties": {
          "bucket_id": {"type": "string", "pattern": "^MATH-C1AB-[0-9a-f]{16}$"},
          "title": {"type": "string", "minLength": 5},
          "bucket_invariant": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "source_type", "source_ref"],
            "properties": {
              "text": {"type": "string", "minLength": 8},
              "source_type": {"enum": ["PROBLEM_FAMILY_TARGET_JOB", "PCK_ANCHOR"]},
              "source_ref": {"type": "string", "minLength": 3}
            }
          },
          "member_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
          "primary_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
          "supporting_capability_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
          "source_core1_lesson_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-C1L-"}},
          "assessment_question_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "core2_question_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "problem_family_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-PF-"}},
          "pck_asset_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-PCK-"}},
          "learner_treatment_by_capability": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability_ref", "learner_state_readiness", "learner_state_confidence", "learner_state_observation_refs", "treatment", "priority_band"],
              "properties": {
                "capability_ref": {"type": "string", "pattern": "^MATH-"},
                "learner_state_readiness": {"enum": ["UNKNOWN", "DEVELOPING", "READY"]},
                "learner_state_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "learner_state_observation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "treatment": {"enum": ["VERIFY_ONLY", "ACTIVE_STUDY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]},
                "priority_band": {"enum": ["EARLY_REPAIR", "EARLY_PROBE", "CORE_STUDY", "EMBEDDED_REPAIR", "VERIFY_AND_MOVE_ON"]}
              }
            }
          },
          "dependency_edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prerequisite_ref", "dependent_ref", "inside_bucket"],
              "properties": {
                "prerequisite_ref": {"type": "string", "pattern": "^MATH-"},
                "dependent_ref": {"type": "string", "pattern": "^MATH-"},
                "inside_bucket": {"type": "boolean"}
              }
            }
          },
          "learning_atoms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["atom_id", "capability_ref", "role", "text", "source_ref"],
              "properties": {
                "atom_id": {"type": "string", "pattern": "^MATH-C1A-ATOM-[0-9a-f]{16}$"},
                "capability_ref": {"type": "string", "pattern": "^MATH-"},
                "role": {"enum": ["ANCHOR", "RECONSTRUCTION_STEP"]},
                "text": {"type": "string", "minLength": 3},
                "source_ref": {"type": "string", "pattern": "^MATH-PCK-"}
              }
            }
          },
          "representation_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "verification_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_capability_refs", "bucketed_capability_refs", "duplicate_capability_refs", "omitted_capability_refs", "status"],
      "properties": {
        "required_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
        "bucketed_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
        "duplicate_capability_refs": {"type": "array", "items": {"type": "string", "pattern": "^MATH-"}},
        "omitted_capability_refs": {"type": "array", "items": {"type": "string", "pattern": "^MATH-"}},
        "status": {"const": "PASS"}
      }
    },
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
