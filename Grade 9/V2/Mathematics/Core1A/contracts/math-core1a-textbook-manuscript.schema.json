{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core1a-textbook-manuscript.schema.json",
  "title": "Mathematics Core1A Bucket-Centric Textbook Manuscript",
  "description": "Learner realization of a governed Core1A bucket plan. Buckets are the teaching unit; capability units retain exact Core1/M-F treatment trace inside each bucket.",
  "type": "object",
  "additionalProperties": false,
  "required": ["core1a_book_id","schema_version","subject","source_bucket_plan_ref","source_bucket_plan_digest","release_class","buckets","quality_audit","book_digest"],
  "properties": {
    "core1a_book_id": {"type": "string", "pattern": "^MATH-C1A-[0-9a-f]{16}$"},
    "schema_version": {"const": "2.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "source_bucket_plan_ref": {"type": "string", "pattern": "^MATH-C1ABP-"},
    "source_bucket_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_class": {"enum": ["PRODUCTION","PROVISIONAL_PENDING_EXPERT_REVIEW","TEST_ONLY"]},
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bucket_id","title","bucket_invariant","member_capability_refs","learner_treatment_by_capability","learning_atoms","capability_units","verification"],
        "properties": {
          "bucket_id": {"type": "string", "pattern": "^MATH-C1AB-"},
          "title": {"type": "string", "minLength": 5},
          "bucket_invariant": {"type": "object", "required": ["text","source_type","source_ref"], "additionalProperties": false, "properties": {"text": {"type": "string", "minLength": 8}, "source_type": {"enum": ["PROBLEM_FAMILY_TARGET_JOB","PCK_ANCHOR"]}, "source_ref": {"type": "string"}}},
          "member_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
          "learner_treatment_by_capability": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "additionalProperties": false, "required": ["capability_ref","learner_state_readiness","learner_state_confidence","learner_state_observation_refs","treatment","priority_band"], "properties": {"capability_ref": {"type": "string", "pattern": "^MATH-"}, "learner_state_readiness": {"enum": ["UNKNOWN","DEVELOPING","READY"]}, "learner_state_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "learner_state_observation_refs": {"type": "array", "items": {"type": "string"}}, "treatment": {"enum": ["VERIFY_ONLY","ACTIVE_STUDY","REPAIR_BEFORE","REPAIR_IN_UNIT","PROBE_FIRST"]}, "priority_band": {"enum": ["EARLY_REPAIR","EARLY_PROBE","CORE_STUDY","EMBEDDED_REPAIR","VERIFY_AND_MOVE_ON"]}}}
          },
          "learning_atoms": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "additionalProperties": false, "required": ["atom_id","capability_ref","role","text","source_ref"], "properties": {"atom_id": {"type": "string", "pattern": "^MATH-C1A-ATOM-"}, "capability_ref": {"type": "string", "pattern": "^MATH-"}, "role": {"enum": ["ANCHOR","RECONSTRUCTION_STEP"]}, "text": {"type": "string"}, "source_ref": {"type": "string", "pattern": "^MATH-PCK-"}}}
          },
          "capability_units": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["lesson_id","capability_ref","title","treatment","family_ref","opening","concept_explanation","what_to_notice","why_it_works","common_mistake","repair","worked_examples","practice","verification","source_trace"],
              "properties": {
                "lesson_id": {"type": "string"}, "capability_ref": {"type": "string", "pattern": "^MATH-"}, "title": {"type": "string", "minLength": 5},
                "treatment": {"enum": ["VERIFY_ONLY","ACTIVE_STUDY","REPAIR_BEFORE","REPAIR_IN_UNIT","PROBE_FIRST"]}, "family_ref": {"type": ["string","null"]},
                "opening": {"type": "string"}, "concept_explanation": {"type": "string"}, "what_to_notice": {"type": "array", "items": {"type": "string"}}, "why_it_works": {"type": "array", "items": {"type": "string"}},
                "common_mistake": {"type": "string"}, "repair": {"type": "array", "items": {"type": "string"}},
                "worked_examples": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["prompt","steps","answer"], "properties": {"prompt": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}}, "answer": {"type": "string"}, "governed_example_asset_ref": {"type": "string", "pattern": "^GEX-MATH-"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
                "practice": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["prompt","solution_steps","answer","hints","source_class"], "properties": {"prompt": {"type": "string"}, "solution_steps": {"type": "array", "items": {"type": "string"}}, "answer": {"type": "string"}, "hints": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}, "source_class": {"enum": ["NEW_AUTHORED_CORE1A","GOVERNED_CORE1A_EXAMPLE"]}, "governed_example_asset_ref": {"type": "string", "pattern": "^GEX-MATH-"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
                "verification": {"type": "array", "items": {"type": "string"}}, "source_trace": {"type": "object"}
              }
            }
          },
          "verification": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quality_audit": {"type": "object"},
    "book_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}