{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core1a-textbook-manuscript.schema.json",
  "title": "Mathematics Core1A Textbook Manuscript",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core1a_book_id",
    "schema_version",
    "subject",
    "source_core1_study_plan_ref",
    "source_core1_plan_digest",
    "release_class",
    "lessons",
    "quality_audit",
    "book_digest"
  ],
  "properties": {
    "core1a_book_id": {
      "type": "string",
      "pattern": "^MATH-C1A-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "MATHEMATICS"
    },
    "source_core1_study_plan_ref": {
      "type": "string",
      "pattern": "^MATH-C1SP-"
    },
    "source_core1_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_class": {
      "enum": [
        "PRODUCTION",
        "PROVISIONAL_PENDING_EXPERT_REVIEW",
        "TEST_ONLY"
      ]
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lesson_id",
          "title",
          "treatment",
          "family_ref",
          "opening",
          "concept_explanation",
          "what_to_notice",
          "why_it_works",
          "common_mistake",
          "repair",
          "worked_examples",
          "practice",
          "verification",
          "source_trace"
        ],
        "properties": {
          "lesson_id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "treatment": {
            "type": "string"
          },
          "family_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "opening": {
            "type": "string"
          },
          "concept_explanation": {
            "type": "string"
          },
          "what_to_notice": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why_it_works": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "common_mistake": {
            "type": "string"
          },
          "repair": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "worked_examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "prompt",
                "steps",
                "answer"
              ],
              "properties": {
                "prompt": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "answer": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "practice": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "prompt",
                "solution_steps",
                "answer",
                "hints",
                "source_class"
              ],
              "properties": {
                "prompt": {
                  "type": "string"
                },
                "solution_steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "answer": {
                  "type": "string"
                },
                "hints": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "string"
                  }
                },
                "source_class": {
                  "const": "NEW_AUTHORED_CORE1A"
                }
              },
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_trace": {
            "type": "object",
            "required": [
              "core1_lesson_ref",
              "assessment_question_refs",
              "pck_asset_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "core1_lesson_ref": {
                "type": "string"
              },
              "assessment_question_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pck_asset_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "quality_audit": {
      "type": "object"
    },
    "book_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
