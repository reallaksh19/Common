  "blocks": [
    {"block_id":"LS-METHODS","kind":"METHOD_COMPARISON","title":"Same system — two methods","capability_refs":["MATH-LINEAR-SYSTEM-SOLVE","MATH-SUBSTITUTION"],"new_math_refs":[],"learner_text":"Compare substitution and elimination for x + y = 9 and x - y = 3.","math_lines":["Elimination: add the equations -> 2x = 12 -> x = 6, y = 3","Substitution: x = 9 - y -> 9 - y - y = 3 -> y = 3, x = 6"]},
