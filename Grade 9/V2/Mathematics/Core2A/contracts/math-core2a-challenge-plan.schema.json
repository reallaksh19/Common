{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core2a-challenge-plan.schema.json",
  "title": "Mathematics Core2A Challenge Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "schema_version",
    "subject",
    "source_core2_plan_ref",
    "source_core2_plan_digest",
    "source_core1a_bucket_plan_ref",
    "source_core1a_bucket_plan_digest",
    "execution_policy_ref",
    "learner_language_policy_ref",
    "question_citation_policy",
    "questions",
    "quality_audit",
    "plan_digest"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^MATH-C2A-[0-9a-f]{16}$"},
    "schema_version": {"const": "2.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "source_core2_plan_ref": {"type": "string", "pattern": "^MATH-C2TP-"},
    "source_core2_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_core1a_bucket_plan_ref": {"type": "string", "pattern": "^MATH-C1ABP-"},
    "source_core1a_bucket_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_policy_ref": {"const": "MATH-CORE2A-EXECUTION-v1"},
    "learner_language_policy_ref": {"const": "MATH-LEARNER-LANGUAGE-v1"},
    "question_citation_policy": {"const": "INLINE_WITH_EACH_QUESTION"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "quality_audit": {"type": "object"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_kind", "label", "locator", "use", "text_relation"],
      "properties": {
        "citation_kind": {
          "enum": ["CORE2_SOURCE", "CORE1_TEACHING", "CORE1A_TEACHING", "COMPETITION_BENCHMARK", "GENERATED_ORIGINAL"]
        },
        "label": {"type": "string", "minLength": 3},
        "locator": {"type": "string", "minLength": 2},
        "url": {"type": ["string", "null"], "format": "uri"},
        "use": {"enum": ["SOURCE_TEXT", "CONCEPT_SUPPORT", "STYLE_BENCHMARK", "ORIGIN_DISCLOSURE"]},
        "text_relation": {"enum": ["EXACT_SOURCE", "FRESH_ORIGINAL", "STYLE_ONLY"]}
      }
    },
    "source_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_with_question", "learner_label", "citations", "official_attribution_claim"],
      "properties": {
        "display_with_question": {"const": true},
        "learner_label": {"const": "Where this question came from"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "official_attribution_claim": {"enum": ["NONE", "VERIFIED_SOURCE_ONLY"]}
      }
    },
    "help": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small_clue", "bigger_clue", "how_do_i_start"],
      "properties": {
        "small_clue": {"type": "string", "minLength": 8},
        "bigger_clue": {"type": "string", "minLength": 8},
        "how_do_i_start": {"type": "string", "minLength": 8}
      }
    },
    "help_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["small_clue_atom_refs", "bigger_clue_atom_refs", "how_do_i_start_atom_refs"],
      "properties": {
        "small_clue_atom_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "bigger_clue_atom_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "how_do_i_start_atom_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "challenge_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_slot", "archetype_refs", "novelty_mechanisms", "difficulty_basis", "near_copy_check"],
      "properties": {
        "challenge_slot": {"enum": ["NEAR_TRANSFER", "STRUCTURAL_VARIATION", "MIXED_SYNTHESIS"]},
        "archetype_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-CA-"}},
        "novelty_mechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["HIDDEN_INFORMATION", "REVERSED_TARGET", "REPRESENTATION_SHIFT", "PARAMETER_CONSTRAINT", "MIXED_CONCEPT_SYNTHESIS", "SYMMETRIC_REWRITE", "INVARIANT_RECOGNITION", "CASE_SPLIT_WHEN_TAUGHT"]}
        },
        "difficulty_basis": {"type": "string", "minLength": 12},
        "near_copy_check": {"const": "PASS"}
      }
    },
    "math_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independently_solved", "answer_verified", "domain_checked", "multiplicity_checked", "status"],
      "properties": {
        "independently_solved": {"const": true},
        "answer_verified": {"const": true},
        "domain_checked": {"type": "boolean"},
        "multiplicity_checked": {"type": "boolean"},
        "status": {"const": "PASS"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_class",
        "learner_title",
        "topic_bucket_ref",
        "taught_capability_refs",
        "prompt",
        "source_note",
        "attempt_first",
        "help",
        "help_bindings",
        "think_it_through",
        "full_working",
        "quick_check",
        "math_check",
        "core_links"
      ],
      "properties": {
        "question_id": {"type": "string", "minLength": 2},
        "question_class": {"enum": ["SOURCE_CORE2", "GENERATED_CHALLENGE"]},
        "learner_title": {"type": "string", "minLength": 4},
        "topic_bucket_ref": {"type": "string", "minLength": 3},
        "taught_capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
        "prompt": {"type": "string", "minLength": 8},
        "source_note": {"$ref": "#/$defs/source_note"},
        "attempt_first": {"const": true},
        "help": {"$ref": "#/$defs/help"},
        "help_bindings": {"$ref": "#/$defs/help_bindings"},
        "think_it_through": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 5}},
        "full_working": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "quick_check": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "math_check": {"$ref": "#/$defs/math_check"},
        "challenge_design": {"$ref": "#/$defs/challenge_design"},
        "core_links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["core1_refs", "core1a_bucket_refs", "core2_question_refs"],
          "properties": {
            "core1_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "core1a_bucket_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "core2_question_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"question_class": {"const": "GENERATED_CHALLENGE"}}, "required": ["question_class"]},
          "then": {"required": ["challenge_design"]}
        }
      ]
    }
  }
}
