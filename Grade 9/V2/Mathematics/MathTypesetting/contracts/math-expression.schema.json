{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-expression.schema.json",
  "title": "Mathematics Expression (semantic AST)",
  "description": "Subject-wide generic semantic model for a mathematical expression. Every learner-visible mathematical object in the Mathematics V2 pipeline is expressed as this AST rather than as an opaque string, so that structure (scripts, radicals, fractions, relations, set membership, aligned transformations) survives publication instead of being flattened to ASCII at render time.",
  "$defs": {
    "node": {
      "type": "object",
      "required": ["node"],
      "properties": {
        "node": {
          "enum": [
            "NUMBER",
            "SYMBOL",
            "TEXT",
            "OPERATOR",
            "RELATION",
            "GROUP",
            "SEQUENCE",
            "FRACTION",
            "RADICAL",
            "POWER",
            "SUBSCRIPT",
            "SUPERSCRIPT",
            "FUNCTION_CALL",
            "SET_NOTATION",
            "ALIGNED_EQUATION",
            "TRANSFORMATION_CHAIN"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"node": {"const": "NUMBER"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "value"],
            "properties": {"node": {}, "value": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {"properties": {"node": {"const": "SYMBOL"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "name"],
            "properties": {"node": {}, "name": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {"properties": {"node": {"const": "TEXT"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "text"],
            "properties": {"node": {}, "text": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {"properties": {"node": {"const": "OPERATOR"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "operator"],
            "properties": {
              "node": {},
              "operator": {
                "enum": ["PLUS", "MINUS", "TIMES", "DIVIDE", "DOT", "PLUS_MINUS", "MINUS_PLUS"]
              }
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "RELATION"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "relation"],
            "properties": {
              "node": {},
              "relation": {
                "enum": [
                  "EQ", "NE", "LT", "LE", "GT", "GE", "APPROX", "EQUIV",
                  "CONGRUENT", "SIMILAR", "PARALLEL", "PERPENDICULAR",
                  "IMPLIES", "IFF", "THEREFORE", "BECAUSE"
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "GROUP"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "child", "fence"],
            "properties": {
              "node": {},
              "child": {"$ref": "#/$defs/node"},
              "fence": {"enum": ["PAREN", "BRACKET", "BRACE", "ABS", "NONE"]}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "SEQUENCE"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "items"],
            "properties": {
              "node": {},
              "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "FRACTION"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "numerator", "denominator"],
            "properties": {
              "node": {},
              "numerator": {"$ref": "#/$defs/node"},
              "denominator": {"$ref": "#/$defs/node"}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "RADICAL"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "radicand"],
            "properties": {
              "node": {},
              "radicand": {"$ref": "#/$defs/node"},
              "index": {"oneOf": [{"$ref": "#/$defs/node"}, {"type": "null"}]}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "POWER"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "base", "exponent"],
            "properties": {
              "node": {},
              "base": {"$ref": "#/$defs/node"},
              "exponent": {"$ref": "#/$defs/node"}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "SUBSCRIPT"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "base", "subscript"],
            "properties": {
              "node": {},
              "base": {"$ref": "#/$defs/node"},
              "subscript": {"$ref": "#/$defs/node"}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "SUPERSCRIPT"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "base", "superscript"],
            "properties": {
              "node": {},
              "base": {"$ref": "#/$defs/node"},
              "superscript": {"$ref": "#/$defs/node"}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "FUNCTION_CALL"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "name", "arguments"],
            "properties": {
              "node": {},
              "name": {"type": "string", "minLength": 1},
              "arguments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "SET_NOTATION"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "relation", "operands"],
            "properties": {
              "node": {},
              "relation": {
                "enum": ["SUBSET", "SUBSET_EQ", "NOT_SUBSET", "ELEMENT", "NOT_ELEMENT", "UNION", "INTERSECT"]
              },
              "operands": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/node"}}
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "ALIGNED_EQUATION"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "lines"],
            "properties": {
              "node": {},
              "lines": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lhs", "relation", "rhs"],
                  "properties": {
                    "lhs": {"$ref": "#/$defs/node"},
                    "relation": {"$ref": "#/$defs/node"},
                    "rhs": {"$ref": "#/$defs/node"},
                    "annotation": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"node": {"const": "TRANSFORMATION_CHAIN"}}, "required": ["node"]},
          "then": {
            "additionalProperties": false,
            "required": ["node", "steps"],
            "properties": {
              "node": {},
              "steps": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["expression", "justification"],
                  "properties": {
                    "expression": {"$ref": "#/$defs/node"},
                    "justification": {"type": "string", "minLength": 3}
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/node"
}
