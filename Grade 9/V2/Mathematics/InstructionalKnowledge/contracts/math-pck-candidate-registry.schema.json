{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-pck-candidate-registry.schema.json",
  "title": "Mathematics PCK Candidate Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id","schema_version","subject","registry_class","asset_documents","registry_digest"],
  "properties": {
    "registry_id": {"type":"string","pattern":"^MATH-PCK-CANDIDATE-REGISTRY-v[0-9]+$"},
    "schema_version": {"const":"1.0.0"},
    "subject": {"const":"MATHEMATICS"},
    "registry_class": {"const":"CANDIDATE"},
    "asset_documents": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["asset_id","path","asset_digest"],
        "properties": {
          "asset_id":{"type":"string","pattern":"^MATH-PCK-"},
          "path":{"type":"string","pattern":"^assets/[a-z0-9-]+\\.json$"},
          "asset_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        }
      }
    },
    "registry_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
