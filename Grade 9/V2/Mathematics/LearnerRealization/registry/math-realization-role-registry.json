{
  "registry_id": "MATH-REALIZATION-ROLE-v1",
  "schema_version": "1.0.0",
  "subject": "MATHEMATICS",
  "purpose": "Subject-wide vocabulary for learner mathematical realization. Declares which route-state roles must demonstrate a mathematical state transition, which operations may be merely named, and what counts as generic (non-item-grounded) learner copy.",
  "principle": "Naming an operation is not equivalent to demonstrating the operation.",
  "roles": {
    "INTERPRET": {"substantive": false, "requires_state_change": false, "note": "reads the givens; may restate without transforming"},
    "CLASSIFY": {"substantive": false, "requires_state_change": false, "note": "names the structure/problem family"},
    "SELECT_THEOREM": {"substantive": false, "requires_state_change": false, "note": "chooses the licensed fact; the application is a separate state"},
    "REPRESENT": {"substantive": true, "requires_state_change": true, "note": "re-expresses the same object in another representation"},
    "MODEL": {"substantive": true, "requires_state_change": true, "note": "turns a situation into mathematics"},
    "SETUP": {"substantive": true, "requires_state_change": true, "note": "writes the governing relation with the actual data in it"},
    "TRANSFORM": {"substantive": true, "requires_state_change": true, "note": "an equivalence-preserving algebraic move"},
    "EXECUTE": {"substantive": true, "requires_state_change": true, "note": "carries out the arithmetic/algebra"},
    "COMPARE": {"substantive": true, "requires_state_change": false, "note": "compares two realized states"},
    "INFER": {"substantive": true, "requires_state_change": false, "note": "draws the conclusion from realized states"},
    "CHECK_CONDITION": {"substantive": true, "requires_state_change": false, "note": "tests whether a declared precondition holds"},
    "CHECK_SUFFICIENCY": {"substantive": true, "requires_state_change": false, "note": "UNIQUE | MULTIPLE | UNDERDETERMINED | INCONSISTENT for parameterized items"},
    "VERIFY": {"substantive": true, "requires_state_change": true, "note": "an executable independent check with its own realized result"}
  },
  "demonstration_required_operations": [
    "SUBSTITUTE",
    "SIMPLIFY",
    "EXPAND",
    "FACTOR",
    "FACTORISE",
    "SOLVE",
    "EVALUATE",
    "RATIONALISE",
    "APPLY_IDENTITY",
    "APPLY_THEOREM",
    "COMPUTE",
    "CONSTRUCT",
    "REARRANGE",
    "DIVIDE",
    "MULTIPLY",
    "SQUARE",
    "TAKE_ROOT",
    "COMPARE_VALUES",
    "CHECK"
  ],
  "generic_learner_copy_patterns": [
    "carry out the algebra",
    "carry out the algebra in the structured workspace",
    "construct the formal result",
    "apply the relevant formula",
    "apply the standard method",
    "use the appropriate identity",
    "do the necessary calculation",
    "perform the computation",
    "simplify as required",
    "verify the answer",
    "check your answer",
    "state one independent check",
    "answers may vary",
    "as required",
    "proceed as usual"
  ],
  "uninstantiated_patterns": [
    "author a new instance",
    "author a fresh instance",
    "source reuse is forbidden",
    "to be authored",
    "to be supplied",
    "placeholder",
    "tbd",
    "todo"
  ],
  "unresolved_template_token_patterns": [
    "\\{[a-z_]+\\}",
    "\\{\\{[^}]*\\}\\}",
    "<[a-z_]+>",
    "\\bPARAM[0-9]*\\b",
    "\\bXXX\\b"
  ],
  "non_reversible_operations": [
    "SQUARE_BOTH_SIDES",
    "MULTIPLY_BOTH_SIDES",
    "CLEAR_DENOMINATOR",
    "TAKE_ROOT"
  ],
  "falsifiers": [
    "WORKED_EXAMPLE_UNINSTANTIATED",
    "MATH_OPERATION_NAMED_BUT_NOT_DEMONSTRATED",
    "LEARNER_STEP_WITHOUT_MATHEMATICAL_STATE_TRANSITION",
    "LEARNER_ROUTE_GENERIC_ACROSS_UNRELATED_ITEMS",
    "LEARNER_SUPPORT_NOT_GROUNDED_IN_CURRENT_ITEM",
    "INTERNAL_REASONING_LABEL_EXPOSED_AS_LEARNER_COPY",
    "SCAFFOLD_DISCLOSES_SOLUTION",
    "EQUIVALENCE_TRANSFORMATION_WITHOUT_INVARIANT_WITNESS",
    "EQUIVALENCE_TRANSFORMATION_PRECONDITION_MISSING",
    "SOLUTION_SET_NOT_PRESERVED_WITHOUT_CHECK",
    "PARAMETERIZED_ITEM_WITHOUT_SUFFICIENCY_CHECK",
    "LEARNER_REALIZATION_GATE_FAILED"
  ]
}
