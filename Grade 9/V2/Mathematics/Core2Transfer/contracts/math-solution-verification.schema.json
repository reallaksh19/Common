{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-solution-verification.schema.json",
  "title": "Mathematics Core2 Solution and Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps", "final_answer", "verification_checks"],
  "properties": {
    "steps": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}},
    "final_answer": {"type": "object"},
    "verification_checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "obligation_ref", "check_type", "mathematical_target", "acceptance_condition"],
        "properties": {
          "check_id": {"type": "string"},
          "obligation_ref": {"type": "string", "pattern": "^VERIFY_"},
          "check_type": {"type": "string"},
          "mathematical_target": {"type": "string", "minLength": 4},
          "acceptance_condition": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
