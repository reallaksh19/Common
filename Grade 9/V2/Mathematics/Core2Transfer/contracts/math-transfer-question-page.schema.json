{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-transfer-question-page.schema.json",
  "title": "Mathematics Transfer Question Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_ref", "source_ref", "source_order", "source_stem", "source_subparts", "source_options", "source_givens", "source_units", "assessment_safety", "concept_refs", "capability_refs", "problem_family_ref", "demand_vector_ref", "guide_demand_badge", "core1_lesson_refs", "workspace_spec", "hint_ladder", "reasoning_route", "solution_route", "representation_plan", "attempt_policy", "page_digest"],
  "properties": {
    "question_ref": {"type": "string", "pattern": "^Q[0-9]+$"},
    "source_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_order": {"type": "integer", "minimum": 1},
    "source_stem": {"type": "string", "minLength": 5},
    "source_subparts": {"type": "array"},
    "source_options": {"type": "array"},
    "source_givens": {"type": "array"},
    "source_units": {"type": "array"},
    "assessment_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["validity_state", "diagnostic_use", "negative_inference_allowed", "canonical_answer"],
      "properties": {
        "validity_state": {"type": "string"},
        "diagnostic_use": {"type": "string"},
        "negative_inference_allowed": {"type": "boolean"},
        "canonical_answer": {"type": "object"}
      }
    },
    "concept_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
    "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^MATH-"}},
    "problem_family_ref": {"type": "string", "pattern": "^MATH-PF-"},
    "demand_vector_ref": {"type": "string", "pattern": "^MATH-DV-"},
    "guide_demand_badge": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "badge_class", "psychometric_claim", "policy_ref", "vector_ref", "basis"],
      "properties": {
        "label": {"enum": ["EASY", "MEDIUM", "HARD"]},
        "badge_class": {"const": "GUIDE_ASSIGNED_REASONING_DEMAND"},
        "psychometric_claim": {"const": false},
        "policy_ref": {"type": "string"},
        "vector_ref": {"type": "string"},
        "basis": {"type": "string", "minLength": 8}
      }
    },
    "core1_lesson_refs": {"type": "array", "minItems": 1, "items": {"$ref": "math-core1-core2-linkage.schema.json"}},
    "workspace_spec": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_type", "fields"],
      "properties": {
        "workspace_type": {"type": "string", "pattern": "^MATH-PF-"},
        "fields": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 4}}
      }
    },
    "hint_ladder": {"$ref": "math-hint-ladder.schema.json"},
    "reasoning_route": {"type": "object"},
    "solution_route": {"$ref": "math-solution-verification.schema.json"},
    "representation_plan": {"type": "object"},
    "attempt_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_original_first", "support_hidden_initially", "item_validity_notice"],
      "properties": {
        "attempt_original_first": {"const": true},
        "support_hidden_initially": {"const": true},
        "item_validity_notice": {"type": ["string", "null"]}
      }
    },
    "page_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
