{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core2-transfer-plan.schema.json",
  "title": "Mathematics Core2 Transfer Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "schema_version", "subject", "release_class", "question_set_ref", "question_set_digest", "problem_semantics_ref", "problem_semantics_digest", "representation_authority_ref", "core1_linkage_mode", "pages", "summary", "plan_digest"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^MATH-C2TP-[0-9a-f]{16}$"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "MATHEMATICS"},
    "release_class": {"enum": ["SEMANTIC_TEST", "PRODUCTION_READY"]},
    "question_set_ref": {"type": "string"},
    "question_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "problem_semantics_ref": {"type": "string"},
    "problem_semantics_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representation_authority_ref": {"const": "MATH-TEACHING-PRIMITIVES-v1"},
    "core1_linkage_mode": {"enum": ["PLANNED_UNTIL_PCK_PROMOTED", "MATERIALIZED"]},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "math-transfer-question-page.schema.json"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["question_count", "attempt_first", "source_fidelity", "psychometric_claims", "publication_ready"],
      "properties": {
        "question_count": {"type": "integer", "minimum": 1},
        "attempt_first": {"const": true},
        "source_fidelity": {"const": true},
        "psychometric_claims": {"const": false},
        "publication_ready": {"type": "boolean"}
      }
    },
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
