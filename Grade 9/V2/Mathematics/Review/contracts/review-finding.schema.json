{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"review-finding.schema.json",
  "type":"object","additionalProperties":false,
  "required":["finding_id","artifact_sha256","candidate_id","reviewer_class","dimensions","severity","page_refs","content_refs","evidence","required_action","status"],
  "properties":{
    "finding_id":{"type":"string","minLength":1},
    "artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "candidate_id":{"type":"string","minLength":1},
    "reviewer_class":{"enum":["AI_PRE_REVIEW","HUMAN_SUBJECT","HUMAN_PEDAGOGY","HUMAN_VISUAL"]},
    "dimensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["SUBJECT","PEDAGOGY","VISUAL"]}},
    "severity":{"enum":["CRITICAL","MAJOR","MODERATE","MINOR"]},
    "page_refs":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1}},
    "content_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "evidence":{"type":"string","minLength":1},
    "required_action":{"type":"string","minLength":1},
    "status":{"enum":["OPEN","CLOSED_FIXED","WAIVED"]},
    "revision_ref":{"type":"string"},
    "revised_artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
