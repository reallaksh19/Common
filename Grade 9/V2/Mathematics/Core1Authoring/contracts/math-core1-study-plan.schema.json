{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core1-study-plan.schema.json",
  "title": "Mathematics Core1 Study Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core1_study_plan_id",
    "schema_version",
    "subject",
    "release_class",
    "pck_authority",
    "study_model_ref",
    "study_model_digest",
    "pck_candidate_registry_ref",
    "pck_promotion_registry_ref",
    "lessons",
    "scope_completeness",
    "input_digest",
    "plan_digest"
  ],
  "properties": {
    "core1_study_plan_id": {
      "type": "string",
      "pattern": "^MATH-C1SP-[0-9a-f]{16}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "subject": {
      "const": "MATHEMATICS"
    },
    "release_class": {
      "description": "PROVISIONAL_PENDING_EXPERT_REVIEW is authoring-legal but never release-legal: at least one bound PCK asset carries only AI-assisted reference review.",
      "enum": [
        "PRODUCTION",
        "PROVISIONAL_PENDING_EXPERT_REVIEW",
        "TEST_ONLY"
      ]
    },
    "pck_authority": {
      "description": "Which PCK promotion authority this plan actually rests on. Expressed over asset refs, generically; topic instances are data on the bound assets.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_registry_ref",
        "promotion_registry_digest",
        "bound_asset_refs",
        "provisional_asset_refs",
        "producer_legal_asset_refs",
        "expert_review_state",
        "release_legal"
      ],
      "properties": {
        "promotion_registry_ref": {
          "type": "string",
          "minLength": 3
        },
        "promotion_registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bound_asset_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MATH-PCK-"
          }
        },
        "provisional_asset_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MATH-PCK-"
          }
        },
        "producer_legal_asset_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MATH-PCK-"
          }
        },
        "expert_review_state": {
          "enum": [
            "PENDING",
            "PASS",
            "NOT_REQUIRED"
          ]
        },
        "release_legal": {
          "type": "boolean"
        }
      }
    },
    "study_model_ref": {
      "type": "string",
      "minLength": 3
    },
    "study_model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pck_candidate_registry_ref": {
      "type": "string",
      "minLength": 3
    },
    "pck_promotion_registry_ref": {
      "type": "string",
      "minLength": 3
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "math-core1-lesson.schema.json"
      }
    },
    "scope_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_capability_refs",
        "covered_capability_refs",
        "omitted_capability_refs",
        "status"
      ],
      "properties": {
        "required_capability_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MATH-"
          }
        },
        "covered_capability_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MATH-"
          }
        },
        "omitted_capability_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MATH-"
          }
        },
        "status": {
          "const": "PASS"
        }
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
