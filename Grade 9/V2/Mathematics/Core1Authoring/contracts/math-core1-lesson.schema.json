{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-core1-lesson.schema.json",
  "title": "Mathematics Core1 Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lesson_id",
    "learner_title",
    "capability_ref",
    "treatment",
    "scope_role",
    "assessment_question_refs",
    "pck_asset_refs",
    "required_pck_jobs",
    "instructional_sequence",
    "representation_requirements",
    "problem_authoring_plans",
    "verification_requirements",
    "future_evidence_obligations",
    "scope_trace"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^MATH-C1L-[0-9a-f]{16}$"
    },
    "learner_title": {
      "type": "string",
      "minLength": 5
    },
    "capability_ref": {
      "type": "string",
      "pattern": "^MATH-"
    },
    "treatment": {
      "enum": [
        "VERIFY_ONLY",
        "ACTIVE_STUDY",
        "REPAIR_BEFORE",
        "REPAIR_IN_UNIT",
        "PROBE_FIRST"
      ]
    },
    "scope_role": {
      "enum": [
        "DIRECT_ASSESSED",
        "PREREQUISITE_SUPPORT",
        "DIRECT_AND_PREREQUISITE"
      ]
    },
    "assessment_question_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "pck_asset_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MATH-PCK-"
      }
    },
    "required_pck_jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "instructional_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ACTIVATE",
          "PROBE",
          "ANCHOR",
          "REPRESENT",
          "EXPLAIN",
          "RECONSTRUCT",
          "CONTRAST",
          "WORKED",
          "GUIDED",
          "FADED",
          "INDEPENDENT",
          "VERIFY",
          "TRANSFER"
        ]
      }
    },
    "representation_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "problem_authoring_plans": {
      "type": "array",
      "items": {
        "$ref": "math-problem-authoring-plan.schema.json"
      }
    },
    "verification_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "future_evidence_obligations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object"
      }
    },
    "scope_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_scope_ref",
        "study_model_capability_ref"
      ],
      "properties": {
        "study_scope_ref": {
          "type": "string",
          "minLength": 3
        },
        "study_model_capability_ref": {
          "type": "string",
          "pattern": "^MATH-"
        }
      }
    }
  }
}
