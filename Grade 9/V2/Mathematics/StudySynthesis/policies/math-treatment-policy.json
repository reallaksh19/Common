{"policy_id":"MATH-MF-TREATMENT-v1","version":"1.0.0","subject":"MATHEMATICS","governing_invariant":"ASSESSMENT_SCOPE_DECIDES_WHAT_LEARNER_INTELLIGENCE_DECIDES_TREATMENT","decision_table":[{"when":{"readiness":"READY"},"treatment":"VERIFY_ONLY","priority_band":"VERIFY_AND_MOVE_ON"},{"when":{"readiness":"DEVELOPING","is_prerequisite_bottleneck":true},"treatment":"REPAIR_BEFORE","priority_band":"EARLY_REPAIR"},{"when":{"readiness":"DEVELOPING","is_prerequisite_bottleneck":false},"treatment":"REPAIR_IN_UNIT","priority_band":"EMBEDDED_REPAIR"},{"when":{"readiness":"UNKNOWN","unresolved_diagnostic_case":true},"treatment":"PROBE_FIRST","priority_band":"EARLY_PROBE"},{"when":{"readiness":"UNKNOWN","unresolved_diagnostic_case":false},"treatment":"ACTIVE_STUDY","priority_band":"CORE_STUDY"}],"prerequisite_bottleneck_rule":{"minimum_dependent_assessed_capabilities":2,"note":"Graph reach prioritizes demonstrated developing prerequisites; it is not a mastery or probability score."},"no_attempt_rule":{"required":"UNKNOWN maps to ACTIVE_STUDY unless another authorized learner-state source exists","forbidden":["NO_ATTEMPT_TO_REPAIR","NO_ATTEMPT_TO_WEAKNESS"]},"ready_rule":{"required":"READY maps to VERIFY_ONLY; do not expand to full reteaching merely for page density."},"probe_rule":{"required":"PROBE_FIRST requires an unresolved diagnostic case; Study Synthesis may not invent a diagnosis."},"scope_rule":{"required":"Learner treatment cannot remove a capability from LearnerStudyScope."},"pck_jobs":{"VERIFY_ONLY":["ACTIVATE_AND_VERIFY"],"ACTIVE_STUDY":["COMPLETE_CONCEPT_RECONSTRUCTION","REPRESENTATION_TRANSLATION","WORKED_TO_INDEPENDENT_PROGRESSION","TRANSFER_VARIATION"],"REPAIR_BEFORE":["PREREQUISITE_RECONSTRUCTION","ERROR_CONTRAST","VERIFICATION_LOOP"],"REPAIR_IN_UNIT":["EMBEDDED_REPAIR","ERROR_CONTRAST","GUIDED_TO_INDEPENDENT_EXECUTION"],"PROBE_FIRST":["DECISIVE_DIAGNOSTIC_PROBE","BRANCH_AFTER_PROBE"]}}