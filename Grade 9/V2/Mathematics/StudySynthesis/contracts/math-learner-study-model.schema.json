{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-learner-study-model.schema.json",
  "title":"Math LearnerStudyModel",
  "type":"object",
  "additionalProperties":false,
  "required":["study_model_id","schema_version","goal_ref","canonical_target_scope_ref","canonical_knowledge_set_ref","research_learner_view_ref","study_synthesis_policy_version","target_decisions","input_digest"],
  "properties":{
    "study_model_id":{"type":"string","pattern":"^MATH-LSM-[0-9a-f]{16}$"},
    "schema_version":{"const":"1.0.0"},
    "goal_ref":{"type":"string","minLength":3},
    "canonical_target_scope_ref":{"type":"string","minLength":3},
    "canonical_knowledge_set_ref":{"type":"string","minLength":3},
    "research_learner_view_ref":{"type":"string","minLength":3},
    "study_synthesis_policy_version":{"type":"string","minLength":1},
    "input_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target_decisions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["target_id","engagement_mode","readiness_mode","canonical_refs","learner_state_reason_refs","decision_basis","study_requirements"],"properties":{"target_id":{"type":"string","minLength":3},"engagement_mode":{"enum":["VERIFY_ONLY","COMPRESS","USE_AS_ENTRY_POINT","ACTIVE_STUDY"]},"readiness_mode":{"enum":["READY","REPAIR_BEFORE","REPAIR_IN_UNIT","PROBE_FIRST"]},"canonical_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},"learner_state_reason_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},"decision_basis":{"type":"object","additionalProperties":false,"required":["capability_state","policy_rule"],"properties":{"capability_state":{"enum":["READY","DEVELOPING","UNKNOWN"]},"policy_rule":{"type":"string","minLength":3}}},"study_requirements":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["requirement_id","requirement_type","canonical_refs","learner_state_reason_refs","completion_evidence"],"properties":{"requirement_id":{"type":"string","minLength":3},"requirement_type":{"enum":["VERIFY_STRENGTH","ENTRY_POINT","RECONSTRUCTION","REPRESENTATION_MEANING","DIAGNOSTIC_PROBE","VERIFICATION","TRANSFER","COMPLETION_EVIDENCE"]},"canonical_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},"learner_state_reason_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":3}},"required_probe_ref":{"type":"string","minLength":3},"completion_evidence":{"type":"string","minLength":3}}}}}}}
  }
}
