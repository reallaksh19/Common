{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"math-learning-representation.schema.json",
  "title":"Mathematics Learning Representation Plan",
  "type":"object",
  "additionalProperties":false,
  "required":["representation_id","bucket_ref","purpose","stages","covered_atom_refs","status"],
  "properties":{"representation_id":{"type":"string","pattern":"^MATH-REP-[0-9a-f]{16}$"},"bucket_ref":{"type":"string","minLength":2},"purpose":{"enum":["CORE1A_TEACHING","STARTER","PRACTICE","REVISION","COMPETITION"]},"stages":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/stage"}},"covered_atom_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"status":{"const":"PASS"}},
  "$defs":{"stage":{"type":"object","additionalProperties":false,"required":["stage","status","learner_job","content","atom_refs","not_applicable_reason"],"properties":{"stage":{"enum":["SEE_THE_OBJECT","SEPARATE_THE_PARTS","SHOW_INFORMATION_FLOW","MAP_TO_SYMBOLS","REBUILD_THE_MODEL","CHECK_UNDERSTANDING","CONNECT_TO_CORE2"]},"status":{"enum":["REQUIRED","NOT_APPLICABLE"]},"learner_job":{"type":"string","minLength":3},"content":{"type":"string","minLength":3},"atom_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"not_applicable_reason":{"type":["string","null"]}}}}
}
