{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "math-answer-contract.schema.json",
  "title": "Mathematics Answer Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_ref","answer_type","canonical_answer","accepted_equivalents","solution_paths","verification_checks","domain_conditions","solution_multiplicity","independent_solver_status"],
  "properties": {
    "question_ref":{"type":"string","minLength":2},
    "answer_type":{"enum":["EXACT_VALUE","EXPRESSION","SET","MULTIPLE_CHOICE","PROOF","CONSTRUCTION","OPEN_RESPONSE"]},
    "canonical_answer":{},
    "accepted_equivalents":{"type":"array"},
    "solution_paths":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path_id","steps"],"properties":{"path_id":{"type":"string","minLength":1},"steps":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}}}}},
    "verification_checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["method","status","evidence"],"properties":{"method":{"type":"string","minLength":3},"status":{"const":"PASS"},"evidence":{"type":"string","minLength":3}}}},
    "domain_conditions":{"type":"array","items":{"type":"string"}},
    "solution_multiplicity":{"enum":["SINGLE_CANONICAL","MULTIPLE_EQUIVALENT","MULTIPLE_DISTINCT","UNDERDETERMINED"]},
    "independent_solver_status":{"const":"PASS"}
  }
}
