  "properties":{"bundle_id":{"type":"string","pattern":"^MATH-SRC-[0-9a-f]{16}$"},"subject":{"const":"MATHEMATICS"},"authority_items":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["role","ref","digest","digest_kind","required","release_state"],"properties":{"role":{"enum":["QUESTION_SET","DECLARED_TOPIC_SCOPE","LEARNER_STUDY_MODEL","CORE1_PLAN","CORE1A_BUCKET_PLAN","CORE2_PLAN","PCK_CANDIDATE_REGISTRY","PCK_PROMOTION_REGISTRY","PROBLEM_FAMILY_REGISTRY","REPRESENTATION_AUTHORITY","COMPETITIVE_BENCHMARK_REGISTRY","COMPETITIVE_ARCHETYPE_REGISTRY","CORE1_AUTHORING_PROFILE","CORE1_SCOPE_POLICY","CORE1A_EXECUTION_POLICY","CORE2_AUTHORING_PROFILE","CORE2A_EXECUTION_POLICY","QUESTION_PROVENANCE_POLICY","LEARNER_LANGUAGE_POLICY","ASSESSMENT_REVIEW_REGISTRY","ASSESSMENT_REVIEW_POLICY","SCOPE_BINDINGS","CANONICAL_MATH_AUTHORITY","PROBLEM_SEMANTICS","VERIFICATION_REGISTRY","TEACHING_PRIMITIVE_REGISTRY","PAGE_INTENT_PROFILE"]},"ref":{"type":["string","null"]},"digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"digest_kind":{"enum":["EMBEDDED_AUTHORITY_DIGEST","CANONICAL_JSON_SHA256"]},"required":{"type":"boolean"},"release_state":{"enum":["PRODUCTION","PROVISIONAL_PENDING_EXPERT_REVIEW","TEST_ONLY","NOT_APPLICABLE"]},"path":{"type":["string","null"]}}}}}
}
