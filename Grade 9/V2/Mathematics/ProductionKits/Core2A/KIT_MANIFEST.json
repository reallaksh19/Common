  "scaffold_profiles": "Grade 9/V2/Mathematics/ProductionKits/common/profiles/scaffold-profiles.json",
  "knowledge_support_profiles": "Grade 9/V2/Mathematics/ProductionKits/common/profiles/knowledge-support-profiles.json",
  "benchmark_registry": "Grade 9/V2/Mathematics/ProductionKits/common/registry/benchmark-source-registry.json",
  "candidate_contract": "Grade 9/V2/Mathematics/ProductionKits/Core2A/contracts/math-core2a-candidate-set.schema.json",
