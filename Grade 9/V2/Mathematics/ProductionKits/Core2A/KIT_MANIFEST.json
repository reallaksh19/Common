  "outputs": ["core2a_product_blueprint.json", "core2a_kit_audit.json", "routing_result.json"],
  "mode_rules": {
    "STARTER": "one Core2 anchor per bucket + one GUIDED_DIRECT fresh item per bucket + full/visual scaffold + explicit solution anatomy",
    "PRACTICE": "all Core2 source items + fresh practice items within the Core2A demand ceiling + solution apprenticeship",
    "REVISION": "one representative/high-demand Core2 item per bucket + invariant recall + method discrimination where the demand ceiling permits; no competition benchmark",
    "COMPETITION": "one representative Core2 anchor per bucket + near/structural challenge within the Core2A demand ceiling; official benchmark/archetype role explicit"
  },
  "fail_closed": [
    "CORE2A_USER_PURPOSE_REQUIRED",
    "MATH_CORE2_CALIBRATION_EXACTLY_ONE_REQUIRED",
