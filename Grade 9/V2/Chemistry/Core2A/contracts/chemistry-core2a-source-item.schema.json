{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-core2a-source-item.schema.json",
  "title": "Chemistry Core2A Source Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "schema_version",
    "subject",
    "lane",
    "question_ref",
    "source_snapshot",
    "core1a_binding",
    "learner_support",
    "answer_path",
    "provenance",
    "internal_source_custody",
    "item_digest"
  ],
  "properties": {
    "item_id": {"type": "string", "pattern": "^CHEM-C2A-SRC-"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "CHEMISTRY"},
    "lane": {"const": "SOURCE_CORE2"},
    "question_ref": {"type": "string", "minLength": 1},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_qc_status",
        "stem",
        "options",
        "subparts",
        "figure_required",
        "figure_semantic",
        "condition_text",
        "states",
        "units",
        "source_badges",
        "source_fidelity"
      ],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_qc_status": {"type": "string", "minLength": 1},
        "stem": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "subparts": {"type": "array"},
        "figure_required": {"type": "boolean"},
        "figure_semantic": {"type": ["object", "null"]},
        "condition_text": {"type": ["string", "null"]},
        "states": {"type": "array", "items": {"type": "string"}},
        "units": {"type": "array", "items": {"type": "string"}},
        "source_badges": {"type": "object"},
        "source_fidelity": {"type": "object"}
      }
    },
    "core1a_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_id",
        "primary_problem_family_ref",
        "primary_capability_ref",
        "supporting_capability_refs",
        "h1_evidence_refs",
        "h2_evidence_refs",
        "h3_evidence_refs"
      ],
      "properties": {
        "bucket_id": {"type": "string", "pattern": "^CHEM-C1A-SBA-[0-9]{2}$"},
        "primary_problem_family_ref": {"type": "string", "pattern": "^PF-"},
        "primary_capability_ref": {"type": "string", "minLength": 1},
        "supporting_capability_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "h1_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "h2_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "h3_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "learner_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_initially_hidden",
        "try_it_first",
        "see_the_idea",
        "write_this_first",
        "small_clue",
        "bigger_clue",
        "how_do_i_start",
        "watch_for_this",
        "think_it_through",
        "check_your_chemistry"
      ],
      "properties": {
        "support_initially_hidden": {"const": true},
        "try_it_first": {"type": "string", "minLength": 1},
        "see_the_idea": {
          "type": "object",
          "additionalProperties": false,
          "required": ["learner_label", "source_visual_refs", "pre_taught_representation_refs"],
          "properties": {
            "learner_label": {"const": "SEE THE IDEA"},
            "source_visual_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "pre_taught_representation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "write_this_first": {"type": "string", "minLength": 1},
        "small_clue": {"type": "string", "minLength": 1},
        "bigger_clue": {"type": "string", "minLength": 1},
        "how_do_i_start": {"type": "string", "minLength": 1},
        "watch_for_this": {"type": "string", "minLength": 1},
        "think_it_through": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "check_your_chemistry": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "answer_path": {"type": "object"},
    "provenance": {"type": "object"},
    "internal_source_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_link_internal", "display_url_allowed", "core2_page_digest"],
      "properties": {
        "source_link_internal": {"type": "string", "minLength": 1},
        "display_url_allowed": {"type": "boolean"},
        "core2_page_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "item_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
