{
  "policy_id": "CHEM-LEARNER-RENDER-v1",
  "schema_version": "1.0.0",
  "subject": "CHEMISTRY",
  "page": {
    "size": "A4_PORTRAIT",
    "margin_pt": 42,
    "minimum_visible_font_pt": 9.0,
    "body_font_pt": 10.5,
    "body_leading_pt": 14.0,
    "question_font_pt": 12.5,
    "question_leading_pt": 16.0,
    "small_label_font_pt": 9.25,
    "section_heading_font_pt": 13.5,
    "chapter_heading_font_pt": 19.0
  },
  "learner_flow": {
    "core1a": [
      "SEE THE IDEA",
      "EXPLAIN",
      "WATCH ONE",
      "WORKED EXAMPLE",
      "TRY WITH LESS HELP",
      "TRY ALONE",
      "EXPECTED RESPONSE",
      "READY TO MOVE ON?"
    ],
    "core2a": [
      "TRY IT FIRST",
      "SEE THE IDEA",
      "WRITE THIS FIRST",
      "SMALL CLUE",
      "BIGGER CLUE",
      "HOW DO I START?",
      "WATCH FOR THIS",
      "THINK IT THROUGH",
      "CHECK YOUR CHEMISTRY",
      "QUICK CHECK",
      "FULL WORKING",
      "WHERE THIS QUESTION CAME FROM"
    ]
  },
  "answer_visibility": {
    "attempt_first_required": true,
    "core1a_open_response_answer_location": "NEXT_PAGE_OR_LATER",
    "core2a_quick_check_location": "NEXT_PAGE_OR_LATER",
    "core2a_full_working_location": "AFTER_QUICK_CHECK",
    "no_question_without_answer_path": true
  },
  "visuals": {
    "representation_selection_authority": "C_H_ONLY",
    "renderer_may_invent_chemistry": false,
    "at_least_one_realized_reasoning_visual_per_teaching_section_when_supported": true,
    "unavailable_secondary_representation_must_be_recorded": true,
    "semantic_color_dependency_forbidden": true,
    "accessibility_text_required_for_visual_primitives": true
  },
  "preflight": {
    "pdf_parse_required": true,
    "a4_geometry_required": true,
    "placement_bounds_required": true,
    "placement_overlap_fail_threshold_pt2": 1.0,
    "internal_identifier_leaks_allowed": 0,
    "blank_pages_allowed": 0,
    "raster_dpi": 144,
    "raster_sample_strategy": "FIRST_MIDDLE_LAST",
    "minimum_nonwhite_pixel_ratio": 0.002,
    "question_answer_count_closure_required": true,
    "content_first_pagination": {
      "products": ["CORE1A", "CORE2A"],
      "cover_page_exempt": true,
      "minimum_noncover_active_height_ratio": 0.18,
      "sparse_semantic_fragments_forbidden": true,
      "page_count_is_quality_metric": false
    }
  },
  "release_boundary": {
    "machine_render_pass_is_not_human_release": true,
    "human_subject_correctness": "PENDING",
    "human_pedagogical_design": "PENDING",
    "human_assessment_design": "PENDING",
    "human_visual_usability": "PENDING",
    "human_mature_design_quality": "PENDING"
  },
  "stop_conditions": [
    "CHEM_LP_RENDER_FONT_FLOOR_FAILURE",
    "CHEM_LP_RENDER_CLIPPING",
    "CHEM_LP_RENDER_OVERLAP",
    "CHEM_LP_RENDER_INTERNAL_ID_LEAK",
    "CHEM_LP_RENDER_REQUIRED_VISUAL_MISSING",
    "CHEM_LP_RENDER_BLANK_PAGE",
    "CHEM_LP_RENDER_PAGE_GEOMETRY_FAILURE",
    "CHEM_LP_RENDER_ANSWER_NAVIGATION_MISSING",
    "CHEM_LP_RENDER_SPARSE_SEMANTIC_FRAGMENT"
  ]
}
