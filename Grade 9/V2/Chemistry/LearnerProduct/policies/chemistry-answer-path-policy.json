{
  "policy_id": "CHEM-ANSWER-PATH-v1",
  "schema_version": "1.0.0",
  "subject": "CHEMISTRY",
  "governing_rule": "NO_LEARNER_FACING_QUESTION_WITHOUT_A_CHECKABLE_ANSWER_PATH",
  "objective_items": {
    "required": ["QUICK_CHECK", "FULL_WORKING"],
    "quick_check_role": "CONCISE_FINAL_RESULT_OR_MARKING_POINTS",
    "full_working_role": "COMPLETE_METHOD_WITH_CHEMISTRY_REASONING_AND_VERIFICATION"
  },
  "open_items": {
    "required": ["EXPECTED_RESPONSE_RUBRIC"],
    "rubric_role": "EXPLICIT_CRITERIA_THE_LEARNER_CAN_USE_TO_CHECK_THE_RESPONSE"
  },
  "applies_to": [
    "CORE1A_GUIDED_PRACTICE",
    "CORE1A_FADED_PRACTICE",
    "CORE1A_INDEPENDENT_PRACTICE",
    "CORE1A_RETRIEVAL_GATE",
    "CORE1A_READINESS_GATE",
    "CORE2A_SOURCE_ITEMS",
    "CORE2A_GENERATED_CHALLENGES"
  ],
  "closure_invariants": [
    "CLOSED_QUESTIONS_TOTAL_EQUALS_QUICK_CHECKS_TOTAL",
    "CLOSED_QUESTIONS_TOTAL_EQUALS_FULL_WORKINGS_TOTAL",
    "OPEN_QUESTIONS_TOTAL_EQUALS_EXPECTED_RESPONSE_RUBRICS_TOTAL"
  ],
  "stop_conditions": [
    "ANSWER_CHECK_MISSING",
    "FULL_WORKING_MISSING",
    "OPEN_ITEM_RUBRIC_MISSING",
    "QUESTION_ANSWER_CLOSURE_MISMATCH"
  ]
}
