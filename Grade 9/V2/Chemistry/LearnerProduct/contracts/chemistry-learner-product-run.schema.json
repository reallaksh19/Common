{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-learner-product-run.schema.json",
  "title": "Chemistry Learner Product Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "contract_version",
    "subject",
    "inputs",
    "policy_refs",
    "execution_sequence",
    "requested_products",
    "outputs",
    "run_digest"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^CHEM-LPR-[0-9a-f]{16}$"},
    "contract_version": {"const": "1.0.0"},
    "subject": {"const": "CHEMISTRY"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_study_model_ref",
        "learner_study_model_digest",
        "core1_plan_ref",
        "core1_plan_digest",
        "representation_bundle_ref",
        "representation_bundle_digest",
        "core2_plan_ref",
        "core2_plan_digest",
        "coverage_closure_ref",
        "coverage_closure_digest"
      ],
      "properties": {
        "learner_study_model_ref": {"type": "string", "minLength": 3},
        "learner_study_model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "core1_plan_ref": {"type": "string", "minLength": 3},
        "core1_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "representation_bundle_ref": {"type": "string", "minLength": 3},
        "representation_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "core2_plan_ref": {"type": "string", "minLength": 3},
        "core2_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_closure_ref": {"type": "string", "minLength": 3},
        "coverage_closure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "competitive_registry_ref": {"type": ["string", "null"]},
        "competitive_registry_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "production_topic_id": {"type": ["string", "null"]},
        "production_baseline_ref": {"type": ["string", "null"]},
        "production_baseline_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core1a_execution_policy",
        "core2a_execution_policy",
        "learner_language_policy",
        "question_citation_policy",
        "competitive_challenge_policy",
        "answer_path_policy"
      ],
      "properties": {
        "core1a_execution_policy": {"const": "CHEM-CORE1A-EXECUTION-v1"},
        "core2a_execution_policy": {"const": "CHEM-CORE2A-EXECUTION-v1"},
        "learner_language_policy": {"const": "CHEM-LEARNER-LANGUAGE-v1"},
        "question_citation_policy": {"const": "CHEM-QUESTION-CITATION-v1"},
        "competitive_challenge_policy": {"const": "CHEM-COMPETITIVE-CHALLENGE-v1"},
        "answer_path_policy": {"const": "CHEM-ANSWER-PATH-v1"}
      }
    },
    "execution_sequence": {
      "const": [
        "VALIDATE_UPSTREAM_BINDINGS",
        "FREEZE_SOURCE_DENOMINATOR",
        "CLASSIFY_SOURCE_INTEGRITY",
        "SYNTHESIZE_CORE1A_BUCKETS",
        "BIND_LEARNER_TREATMENT",
        "DECOMPOSE_LEARNING_ATOMS",
        "BUILD_REPRESENTATION_SEQUENCE",
        "BUILD_PROBLEM_FAMILIES",
        "CLOSE_CORE2_HINT_PRETEACH",
        "REALIZE_CORE1A",
        "MAP_CORE2_TO_CORE1A",
        "REALIZE_SOURCE_CORE2A_ITEMS",
        "SELECT_CHALLENGE_TARGETS",
        "GENERATE_CHALLENGE_CANDIDATES",
        "VALIDATE_CHEMISTRY",
        "VALIDATE_TAUGHT_SCOPE",
        "VALIDATE_NEAR_COPY",
        "BIND_PROVENANCE",
        "AUTHOR_STAGED_HELP",
        "AUTHOR_QUICK_CHECK",
        "AUTHOR_FULL_WORKING",
        "VALIDATE_ANSWER_CLOSURE",
        "RENDER_LEARNER_PRODUCTS",
        "VISUAL_PREFLIGHT",
        "FINAL_AUDIT",
        "FREEZE_HANDOFF"
      ]
    },
    "requested_products": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core1a", "core2a_source", "core2a_challenges"],
      "properties": {
        "core1a": {"type": "boolean"},
        "core2a_source": {"type": "boolean"},
        "core2a_challenges": {"type": "boolean"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core1a_bucket_plan_ref",
        "core1a_manuscript_ref",
        "core2a_source_plan_ref",
        "core2a_challenge_plan_ref",
        "answer_closure_audit_ref",
        "artifact_manifest_ref",
        "handoff_manifest_ref"
      ],
      "properties": {
        "core1a_bucket_plan_ref": {"type": ["string", "null"]},
        "core1a_manuscript_ref": {"type": ["string", "null"]},
        "core2a_source_plan_ref": {"type": ["string", "null"]},
        "core2a_challenge_plan_ref": {"type": ["string", "null"]},
        "answer_closure_audit_ref": {"type": ["string", "null"]},
        "artifact_manifest_ref": {"type": ["string", "null"]},
        "handoff_manifest_ref": {"type": ["string", "null"]}
      }
    },
    "run_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
