    {"object_id":"OBJ-ID-MEAN","object_class":"MEANING","learning_atom_id":"LA-REDOX-TRACK-001","learner_payload":"A Redox label is earned by tracking what happens to the same element or species across the reaction.","source_ref":"CHEM-NCERT-REDOX-PRODUCTION-v1","ccbom_asset_id":"CON-REDOX-SPECIES-TRACK"},
