    {"object_id":"OBJ-E-GUIDED","object_class":"GUIDED_PRACTICE","learning_atom_id":"LA-REDOX-ELECTRON-002","learner_payload":"Complete the electron ledger: Zn → Zn²⁺ + ____ ; Cu²⁺ + ____ → Cu. Then check whether loss and gain balance.","source_ref":"CT-C1A-REDOX-001","ccbom_asset_id":"Q-REDOX-ELECTRON-GUIDED","practice_level":"GUIDED"},
    {"object_id":"OBJ-E-GUIDED-ANS","object_class":"ANSWER","learning_atom_id":"LA-REDOX-ELECTRON-002","learner_payload":"Both blanks are 2e⁻; electrons lost and gained are equal.","source_ref":"CT-C1A-REDOX-001","ccbom_asset_id":"ANS-REDOX-ELECTRON-GUIDED"},
    {"object_id":"OBJ-AG-MEAN","object_class":"MEANING","learning_atom_id":"LA-REDOX-AGENT-003","learner_payload":"An oxidising or reducing agent is named only after you prove what happens to that reactant itself and what effect it has on the other reactant.","source_ref":"CHEM-NCERT-REDOX-PRODUCTION-v1","ccbom_asset_id":"CON-REDOX-AGENT-ROLE"},
    {"object_id":"OBJ-AG-RULE","object_class":"RULE","learning_atom_id":"LA-REDOX-AGENT-003","learner_payload":"Oxidised reactant = reducing agent. Reduced reactant = oxidising agent.","source_ref":"GRADE9-REDOX-SUBTOPIC-BOOK-BUILDER","ccbom_asset_id":"CON-REDOX-AGENT-ROLE"},
    {"object_id":"OBJ-AG-MAP","object_class":"REPRESENTATION","learning_atom_id":"LA-REDOX-AGENT-003","learner_payload":{"Zn":"oxidised → gives electrons → reducing agent","Cu²⁺":"reduced → accepts electrons → oxidising agent"},"source_ref":"CT-C1A-REDOX-001","ccbom_asset_id":"REP-REDOX-SELF-OTHER","representation_type":"SELF_OTHER_AGENT_MAP"},
    {"object_id":"OBJ-AG-CHAIN","object_class":"REASONING_CHAIN","learning_atom_id":"LA-REDOX-AGENT-003","learner_payload":["State the reactant's self-change.","State its electron action.","State the effect on the other reactant.","Attach the agent role last."],"source_ref":"CHEM-NCERT-REDOX-PRODUCTION-v1","ccbom_asset_id":"REP-REDOX-SELF-OTHER"},
