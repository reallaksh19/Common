{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/g9-v2/learning-blueprint/specialist-pass.schema.json",
  "title": "Blind-grounded Core1/Core2 specialist pass",
  "type": "object",
  "additionalProperties": false,
  "required": ["pass_id", "packet_id", "packet_type", "role", "instance_id", "sequence_role", "grounding_phase", "access_state", "ground_truth_manifest_id", "ground_truth_manifest_digest", "subtopic_refs", "upstream_packet_refs", "claims", "unresolved"],
  "properties": {
    "pass_id": {"type": "string", "minLength": 3},
    "packet_id": {"type": "string", "minLength": 3},
    "packet_type": {"enum": ["K", "D"]},
    "role": {"enum": ["CORE1", "CORE2"]},
    "instance_id": {"type": "string", "minLength": 3},
    "sequence_role": {"enum": ["FIRST_SPECIALIST", "SECOND_SPECIALIST"]},
    "grounding_phase": {"const": "BLIND_GROUNDING"},
    "access_state": {"const": "ORIGINAL_EVIDENCE_ONLY"},
    "ground_truth_manifest_id": {"type": "string", "minLength": 3},
    "ground_truth_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subtopic_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "upstream_packet_refs": {"type": "array", "maxItems": 0},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_domain", "claim_kind", "statement", "capability_refs", "evidence_refs", "confidence", "required_for_assessment"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "claim_domain": {"enum": ["SEMANTIC", "ASSESSMENT"]},
          "claim_kind": {"type": "string", "minLength": 2},
          "statement": {"type": "string", "minLength": 5},
          "capability_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
          "required_for_assessment": {"type": "boolean"}
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
