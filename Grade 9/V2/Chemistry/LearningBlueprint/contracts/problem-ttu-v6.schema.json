{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-problem-ttu-v6.schema.json",
  "title": "Chemistry Problem TTU v6",
  "type": "object",
  "required": [
    "schema_version",
    "ttu_family",
    "ttu_id",
    "product_mode",
    "question_id",
    "question_authority_ref",
    "problem_family",
    "canonical_truth_refs",
    "recognition",
    "model_selection",
    "constraint",
    "first_move",
    "solution_path",
    "verification",
    "transfer",
    "reconstructable_ttu_refs",
    "self_help_closure_ref",
    "support_band_ref",
    "realization_contract",
    "differentiation_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "6.0.0"},
    "ttu_family": {"const": "PROBLEM_TTU"},
    "ttu_id": {"type": "string", "minLength": 1},
    "product_mode": {"enum": ["CORE2A", "CORE2B"]},
    "question_id": {"type": "string", "minLength": 1},
    "question_authority_ref": {"type": "string", "minLength": 1},
    "problem_family": {"type": "string", "minLength": 1},
    "canonical_truth_refs": {"type": "array", "minItems": 1},
    "recognition": {"type": "object"},
    "model_selection": {"type": "object"},
    "constraint": {"type": "object"},
    "first_move": {"type": "object"},
    "solution_path": {"type": "array", "minItems": 1},
    "verification": {"type": "object"},
    "transfer": {"type": "object"},
    "reconstructable_ttu_refs": {"type": "array", "minItems": 1},
    "self_help_closure_ref": {"type": "string", "minLength": 1},
    "support_band_ref": {"type": "string", "minLength": 1},
    "realization_contract": {"type": "object", "required": ["identity", "exposure_mode", "learner_actions"]},
    "tutor_dialogue_ref": {"type": "string"},
    "differentiation_fingerprint": {
      "type": "object",
      "required": ["example", "representation", "sequence", "solution", "learner_action"]
    }
  },
  "additionalProperties": true
}
