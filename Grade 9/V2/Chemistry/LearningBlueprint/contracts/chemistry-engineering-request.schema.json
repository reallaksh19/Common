{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"chemistry-engineering-request.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","subject","requested_topic","requested_scope","engineering_depth","requested_action","requested_for"],
  "properties":{
    "schema_version":{"const":"2.0.0"},
    "request_id":{"type":"string","pattern":"^CHEM-ENG-REQ-[A-Z0-9-]+$"},
    "subject":{"const":"CHEMISTRY"},
    "requested_topic":{"type":"string","minLength":2},
    "requested_scope":{"type":"string","minLength":2},
    "engineering_depth":{"enum":["FOUNDATION","STANDARD","RESEARCH"]},
    "requested_action":{"const":"DECLARE_DIRECT_GATES"},
    "curriculum_scope":{"type":"object","additionalProperties":false,"properties":{"grades":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":13}},"curriculum":{"type":"string"},"exam_family":{"type":"string"}}},
    "requested_for":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["CORE1","CORE1A","CORE1B","CORE2","CORE2A","CORE2B","CDAU","SDU","LAU","TTU","PAL","PUBLICATION"]}},
    "notes":{"type":"string"}
  }
}
