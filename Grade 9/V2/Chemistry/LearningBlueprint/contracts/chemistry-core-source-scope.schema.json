{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-core-source-scope.schema.json",
  "title": "Chemistry Unified Core Source Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scope_contract_id", "product_mode", "gate_id", "subtopic_id",
    "source_audit_ref", "source_audit_digest", "learner_grade", "program_context",
    "authorized_scope_tiers", "held_scope_tiers", "extension_authority_ref", "extension_reason",
    "scope_unit_assignments", "held_transformation_guards", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scope_contract_id": {"type": "string", "pattern": "^CHEM-CORE-SCOPE-[A-Z0-9-]+$"},
    "product_mode": {"enum": ["CORE1A", "CORE1B", "CORE2A", "CORE2B"]},
    "gate_id": {"type": "string"},
    "subtopic_id": {"type": "string", "minLength": 1},
    "source_audit_ref": {"type": "string", "minLength": 3},
    "source_audit_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "learner_grade": {"type": "integer", "minimum": 1, "maximum": 13},
    "program_context": {"enum": ["GRADE_LEVEL", "COMPETITIVE_FOUNDATION_EXTENSION", "REVISION_EXTENSION"]},
    "authorized_scope_tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "held_scope_tiers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "extension_authority_ref": {"type": "string"},
    "extension_reason": {"type": "string"},
    "scope_unit_assignments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope_unit_id", "scope_unit_kind", "scope_tier"],
        "properties": {
          "scope_unit_id": {"type": "string", "minLength": 1},
          "scope_unit_kind": {"enum": ["ATOM", "MODULE", "ITEM"]},
          "scope_tier": {"type": "string", "minLength": 1}
        }
      }
    },
    "held_transformation_guards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fingerprint", "detection_tokens"],
        "properties": {
          "fingerprint": {"type": "string", "minLength": 3},
          "detection_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
        }
      }
    },
    "status": {"const": "CORE_SCOPE_READY"}
  }
}
