{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"chemistry-engineering-passport.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","passport_id","request_id","manifest_id","closure_receipt_id","closure_receipt_digest","requested_topic","requested_scope","engineering_depth","technical_state","counts","gate_states","source_audit_states","external_dependency_states","source_item_status","cdau_technical_authorization","next_action"],
  "properties":{
    "schema_version":{"const":"2.0.0"},"passport_id":{"type":"string","pattern":"^CHEM-ENG-PASS-[A-Z0-9-]+$"},"request_id":{"type":"string"},"manifest_id":{"type":"string"},"closure_receipt_id":{"type":"string"},"closure_receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"requested_topic":{"type":"string"},"requested_scope":{"type":"string"},"engineering_depth":{"enum":["FOUNDATION","STANDARD","RESEARCH"]},"technical_state":{"enum":["ENGINEERING_READY","BLOCKED_PENDING_ENGINEERING"]},"counts":{"type":"object"},"gate_states":{"type":"array"},
    "source_audit_states":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["gate_id","audit_ref","audit_digest","status","scope_policy","audit_role","authority_effect"],"properties":{"gate_id":{"type":"string"},"audit_ref":{"type":"string"},"audit_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"status":{"enum":["SOURCE_HARDENED","SOURCE_HELD"]},"scope_policy":{"type":"string"},"audit_role":{"enum":["PRODUCTION_SOURCE_AUDIT","STRESS_TEST_SOURCE_AUDIT"]},"authority_effect":{"enum":["NONE_STRESS_TEST_ONLY","SOURCE_SCOPE_EVIDENCE_ONLY"]}}}},
    "external_dependency_states":{"type":"array"},"source_item_status":{"enum":["INDEPENDENT_OF_TECHNICAL_GATE","SOURCE_HELD","SOURCE_READY"]},"cdau_technical_authorization":{"enum":["ALLOWED","BLOCKED"]},"next_action":{"type":"string","minLength":1}
  }
}
