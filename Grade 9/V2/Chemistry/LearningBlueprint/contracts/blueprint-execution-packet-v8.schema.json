{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/chemistry/blueprint-execution-packet-v8.schema.json",
  "title": "Chemistry Blueprint-only execution packet v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "subject",
    "task_type",
    "product_mode",
    "authority_refs",
    "authority_sources_used",
    "output_bindings",
    "missing_authority_action",
    "execution_status"
  ],
  "properties": {
    "schema_version": {"const": "8.0.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "subject": {"const": "CHEMISTRY"},
    "task_type": {
      "enum": [
        "TOPIC_SELECTION",
        "CONTENT_AUDIT",
        "CORE_GENERATION",
        "QUESTION_SELECTION",
        "EXAMPLE_SELECTION",
        "EQUATION_SELECTION",
        "DIFFICULTY_DECISION",
        "LEARNER_FIT",
        "TTU_DESIGN",
        "SIMILARITY_AUDIT",
        "RELEASE"
      ]
    },
    "product_mode": {
      "enum": ["NONE", "CORE1", "CORE1A", "CORE1B", "CORE2", "CORE2A", "CORE2B"]
    },
    "subtopic_id": {"type": ["string", "null"]},
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_type", "ref"],
        "properties": {
          "authority_type": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "authority_sources_used": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "output_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_id", "object_class", "authority_ref"],
        "properties": {
          "output_id": {"type": "string", "minLength": 1},
          "object_class": {"type": "string", "minLength": 1},
          "authority_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing_authority_action": {"const": "BLOCK"},
    "execution_status": {"enum": ["READY", "BLOCKED"]},
    "blocked_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
