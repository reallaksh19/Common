{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"chemistry-engineering-topic-manifest.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","manifest_id","request_id","scope_kind","scope_ref","topic_id","title","registry_ref","required_gate_ids","optional_gate_ids","out_of_scope_gate_ids","external_prerequisite_resolutions","source_item_status","downstream_consumers"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "manifest_id":{"type":"string","pattern":"^CHEM-ENG-MAN-[A-Z0-9-]+$"},
    "request_id":{"type":"string","pattern":"^CHEM-ENG-REQ-[A-Z0-9-]+$"},
    "scope_kind":{"enum":["TOPIC","SUBTOPIC","BUCKET"]},
    "scope_ref":{"type":"string","minLength":1},
    "topic_id":{"type":"string","pattern":"^CHEM-[A-Z0-9-]+$"},
    "title":{"type":"string","minLength":3},
    "registry_ref":{"const":"policies/chemistry-technical-engineering-gates.v1.json"},
    "required_gate_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^CHEM-[A-Z0-9]+-[A-Z0-9-]+$"}},
    "optional_gate_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^CHEM-[A-Z0-9]+-[A-Z0-9-]+$"}},
    "out_of_scope_gate_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^CHEM-[A-Z0-9]+-[A-Z0-9-]+$"}},
    "external_prerequisite_resolutions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["dependency_id","status","evidence_ref"],"properties":{"dependency_id":{"type":"string","minLength":1},"status":{"enum":["RESOLVED_BY_AUTHORITY","RESOLVED_BY_OWNER_SCOPE","BLOCKED"]},"evidence_ref":{"type":"string","minLength":1},"note":{"type":"string"}}}},
    "research_dossier_ref":{"type":"string","minLength":1},
    "claim_ledger_ref":{"type":"string","minLength":1},
    "source_item_status":{"enum":["INDEPENDENT_OF_TECHNICAL_GATE","SOURCE_HELD","SOURCE_READY"]},
    "downstream_consumers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["CDAU","SDU","LAU","TTU","PAL","PUBLICATION"]}},
    "notes":{"type":"string"}
  }
}
