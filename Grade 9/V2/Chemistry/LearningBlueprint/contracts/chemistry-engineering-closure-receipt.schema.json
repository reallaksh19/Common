{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"chemistry-engineering-closure-receipt.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","receipt_id","request_id","manifest_id","registry_ref","registry_digest","source_audit_states","closure_digest","direct_gate_ids","closure_gate_ids","gate_states","external_dependency_states","blockers","counts","closure_status","source_item_status","authority_note"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"receipt_id":{"type":"string","pattern":"^CHEM-ENG-CLOSURE-[A-Z0-9-]+$"},"request_id":{"type":"string"},"manifest_id":{"type":"string"},"registry_ref":{"const":"policies/chemistry-technical-engineering-gates.v1.json"},"registry_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_audit_states":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["gate_id","audit_ref","audit_digest","status","scope_policy"],"properties":{"gate_id":{"type":"string"},"audit_ref":{"type":"string"},"audit_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"status":{"const":"SOURCE_HARDENED"},"scope_policy":{"const":"GRADE_BANDED"}}}},
    "closure_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "direct_gate_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"closure_gate_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "gate_states":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["gate_id","status","direct"],"properties":{"gate_id":{"type":"string"},"status":{"enum":["ENGINEERING_GATE_READY","ENGINEERING_GATE_INCOMPLETE","SOURCE_SCOPE_HELD","MISSING"]},"direct":{"type":"boolean"}}}},
    "external_dependency_states":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["dependency_id","status","evidence_ref"],"properties":{"dependency_id":{"type":"string"},"status":{"enum":["RESOLVED_BY_AUTHORITY","RESOLVED_BY_OWNER_SCOPE","BLOCKED","UNRESOLVED"]},"evidence_ref":{"type":"string"}}}},
    "blockers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string"},"gate_id":{"type":"string"},"dependency_id":{"type":"string"},"message":{"type":"string"}}}},
    "counts":{"type":"object","additionalProperties":false,"required":["direct_gate_count","closure_gate_count","ready_gate_count","blocked_gate_count","external_dependency_count","external_blocked_count"],"properties":{"direct_gate_count":{"type":"integer","minimum":1},"closure_gate_count":{"type":"integer","minimum":1},"ready_gate_count":{"type":"integer","minimum":0},"blocked_gate_count":{"type":"integer","minimum":0},"external_dependency_count":{"type":"integer","minimum":0},"external_blocked_count":{"type":"integer","minimum":0}}},
    "closure_status":{"enum":["READY","BLOCKED"]},"source_item_status":{"enum":["INDEPENDENT_OF_TECHNICAL_GATE","SOURCE_HELD","SOURCE_READY"]},"authority_note":{"type":"string","minLength":1}
  }
}
