{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chemistry Scientific Fact Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_id",
    "subject",
    "authority_scope",
    "adapter_authored_facts_forbidden",
    "representation_layer_owns_scientific_facts",
    "fact_packets"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "authority_id": {"type": "string", "pattern": "^CHEM-SCI-FACT-AUTH-[A-Za-z0-9-]+-v[0-9]+$"},
    "subject": {"const": "CHEMISTRY"},
    "authority_scope": {"const": "ENGINEERING_AND_BLUEPRINT_SCIENTIFIC_FACTS"},
    "adapter_authored_facts_forbidden": {"const": true},
    "representation_layer_owns_scientific_facts": {"const": false},
    "fact_packets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact_packet"}
    }
  },
  "$defs": {
    "oxidation_state_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "before", "after", "before_species", "after_species", "electron_count"],
      "properties": {
        "element": {"type": "string", "minLength": 1},
        "before": {"type": "integer"},
        "after": {"type": "integer"},
        "before_species": {"type": "string", "minLength": 1},
        "after_species": {"type": "string", "minLength": 1},
        "electron_count": {"type": "integer", "minimum": 1}
      }
    },
    "electron_transfer_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oxidation_states"],
      "properties": {
        "oxidation_states": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/oxidation_state_row"}
        },
        "chemical_entities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fact_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_packet_id",
        "semantic_instance_ref",
        "source_authority_kind",
        "source_gate_id",
        "source_representation_ref",
        "fact_kind",
        "parameters"
      ],
      "properties": {
        "fact_packet_id": {"type": "string", "pattern": "^CHEM-REP-FACT-[A-Z0-9-]+-v[0-9]+$"},
        "semantic_instance_ref": {"type": "string", "pattern": "^CHEM-SEM-INSTANCE-[A-Z0-9-]+-v[0-9]+$"},
        "source_authority_kind": {"enum": ["ENGINEERING_OBLIGATION", "BLUEPRINT_CONTENT_AUTHORITY"]},
        "source_gate_id": {"type": "string", "pattern": "^CHEM-[A-Z0-9]+-[A-Z0-9-]+$"},
        "source_representation_ref": {"type": "string", "minLength": 1},
        "source_equation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_authority_ref": {"type": "string", "minLength": 1},
        "source_content_object_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "fact_kind": {"type": "string", "pattern": "^[A-Z0-9_]+_V[0-9]+$"},
        "parameters": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_authority_kind": {"const": "ENGINEERING_OBLIGATION"}}},
          "then": {"required": ["source_equation_refs"]}
        },
        {
          "if": {"properties": {"source_authority_kind": {"const": "BLUEPRINT_CONTENT_AUTHORITY"}}},
          "then": {"required": ["source_authority_ref", "source_content_object_refs"]}
        },
        {
          "if": {"properties": {"fact_kind": {"const": "ELECTRON_TRANSFER_STATE_LEDGER_V1"}}},
          "then": {"properties": {"parameters": {"$ref": "#/$defs/electron_transfer_parameters"}}}
        }
      ]
    }
  }
}
