{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/g9-v2/learning-blueprint/routing-input.schema.json",
  "title": "Adaptive routing evidence input",
  "type": "object",
  "additionalProperties": false,
  "required": ["routing_request_id", "ground_truth_manifest_id", "subtopic_refs", "metrics", "evidence_notes", "unresolved"],
  "properties": {
    "routing_request_id": {"type": "string", "minLength": 1},
    "ground_truth_manifest_id": {"type": "string", "minLength": 1},
    "subtopic_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SA", "SS", "QE", "QR", "UA", "CI"],
      "properties": {
        "SA": {"type": "integer", "minimum": 0, "maximum": 4},
        "SS": {"type": "integer", "minimum": 0, "maximum": 4},
        "QE": {"type": "integer", "minimum": 0, "maximum": 4},
        "QR": {"type": "integer", "minimum": 0, "maximum": 4},
        "UA": {"type": "integer", "minimum": 0, "maximum": 4},
        "CI": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "evidence_notes": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}}
  }
}
