{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"chemistry-engineering-claim-ledger.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","ledger_id","request_id","claims","status"],
  "properties":{
    "schema_version":{"const":"2.0.0"},"ledger_id":{"type":"string","pattern":"^CHEM-ENG-CLAIMS-[A-Z0-9-]+$"},"request_id":{"type":"string","pattern":"^CHEM-ENG-REQ-[A-Z0-9-]+$"},
    "claims":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["claim_id","statement","authority_class","evidence_ref","scope_status"],"properties":{"claim_id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":8},"authority_class":{"enum":["SOURCE_DEFINED","STANDARD_CHEMISTRY_DERIVED","AUTHORING_RECOMMENDATION","SOURCE_SCOPE_HELD"]},"evidence_ref":{"type":"string","minLength":1},"scope_status":{"enum":["IN_SCOPE","PREREQUISITE_SCOPE","HELD_SCOPE"]}}}},
    "status":{"enum":["CLAIM_LEDGER_IN_PROGRESS","CLAIM_LEDGER_READY"]}
  }
}
