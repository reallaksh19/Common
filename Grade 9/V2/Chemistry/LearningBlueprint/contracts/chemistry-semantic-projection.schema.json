{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-semantic-projection.schema.json",
  "title": "Chemistry Engineering Semantic Projection Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "subject",
    "obligation_packet_id",
    "obligation_packet_digest",
    "policy_ref",
    "policy_digest",
    "semantic_atoms",
    "counts",
    "status",
    "projection_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "projection_id": {"type": "string", "pattern": "^CHEM-BP-SEM-[A-Z0-9-]+$"},
    "subject": {"const": "CHEMISTRY"},
    "obligation_packet_id": {"type": "string", "pattern": "^CHEM-BP-OBL-[A-Z0-9-]+$"},
    "obligation_packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_ref": {"const": "policies/chemistry-semantic-projection.v1.json"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semantic_atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_id",
          "source_gate_id",
          "source_obligation_id",
          "source_asset_ref",
          "source_kind",
          "source_field",
          "semantic_role",
          "content",
          "direct",
          "authorized_modes",
          "required_realization_modes",
          "source_authority_tier",
          "source_payload_digest"
        ],
        "properties": {
          "semantic_id": {"type": "string", "pattern": "^CHEM-SEM-[A-Z0-9]+$"},
          "source_gate_id": {"type": "string", "minLength": 1},
          "source_obligation_id": {"type": "string", "pattern": "^CHEM-OBL-[A-Z0-9-]+$"},
          "source_asset_ref": {"type": "string", "minLength": 1},
          "source_kind": {
            "enum": [
              "CONCEPT",
              "EQUATION",
              "REPRESENTATION",
              "MODEL_CONDITION",
              "REASONING_STEP",
              "TRANSFORMATION",
              "MISCONCEPTION",
              "VERIFICATION",
              "PROBLEM_FAMILY",
              "DIFFICULTY_PROFILE"
            ]
          },
          "source_field": {"type": "string", "minLength": 1},
          "semantic_role": {
            "enum": [
              "CONCEPT_RULE",
              "EQUATION_MODEL",
              "VALIDITY_BOUNDARY",
              "REPRESENTATION_REQUIREMENT",
              "VERIFICATION",
              "BOUNDARY_CONSEQUENCE",
              "REASONING_MOVE",
              "TRANSFORMATION_REQUIREMENT",
              "MISCONCEPTION",
              "COUNTEREXAMPLE",
              "MISCONCEPTION_REPAIR",
              "RECOGNITION_SIGNAL",
              "METHOD_STEP",
              "ERROR_TO_AVOID",
              "TARGET_UNKNOWN",
              "DIFFICULTY_EVIDENCE"
            ]
          },
          "content": {"type": "string", "minLength": 1},
          "direct": {"type": "boolean"},
          "authorized_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["CORE1A", "CORE1B", "CORE2A", "CORE2B"]}
          },
          "required_realization_modes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["CORE1A", "CORE1B", "CORE2A", "CORE2B"]}
          },
          "source_authority_tier": {"type": "string", "minLength": 1},
          "source_payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_obligation_count", "semantic_atom_count", "role_counts"],
      "properties": {
        "source_obligation_count": {"type": "integer", "minimum": 1},
        "semantic_atom_count": {"type": "integer", "minimum": 1},
        "role_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "status": {"const": "SEMANTIC_PROJECTION_READY"},
    "projection_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
