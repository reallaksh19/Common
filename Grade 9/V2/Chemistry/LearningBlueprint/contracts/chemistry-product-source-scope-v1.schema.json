{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-product-source-scope-v1.schema.json",
  "title": "Chemistry Product Source Scope Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_contract_id",
    "gate_id",
    "subtopic_id",
    "learner_grade",
    "program_context",
    "authorized_scope_tiers",
    "held_scope_tiers",
    "extension_authority_ref",
    "extension_reason",
    "learning_atom_scope_assignments",
    "held_transformation_guards",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scope_contract_id": {"type": "string", "pattern": "^CHEM-PRODUCT-SCOPE-[A-Z0-9-]+$"},
    "gate_id": {"type": "string", "pattern": "^CHEM-[A-Z0-9]+-[A-Z0-9-]+$"},
    "subtopic_id": {"type": "string", "minLength": 1},
    "learner_grade": {"type": "integer", "minimum": 9, "maximum": 11},
    "program_context": {"enum": ["GRADE_LEVEL", "COMPETITIVE_FOUNDATION_EXTENSION", "REVISION_EXTENSION"]},
    "authorized_scope_tiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["FOUNDATION_G10", "FORMAL_G11", "EXTENDED_G11"]}
    },
    "held_scope_tiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["FOUNDATION_G10", "FORMAL_G11", "EXTENDED_G11"]}
    },
    "extension_authority_ref": {"type": "string"},
    "extension_reason": {"type": "string"},
    "learning_atom_scope_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["learning_atom_id", "scope_tier"],
        "properties": {
          "learning_atom_id": {"type": "string", "minLength": 1},
          "scope_tier": {"enum": ["FOUNDATION_G10", "FORMAL_G11", "EXTENDED_G11"]}
        }
      }
    },
    "held_transformation_guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "detection_tokens"],
        "properties": {
          "fingerprint": {"type": "string", "minLength": 5},
          "detection_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
        }
      }
    },
    "status": {"const": "SCOPE_CONTRACT_READY"}
  }
}
