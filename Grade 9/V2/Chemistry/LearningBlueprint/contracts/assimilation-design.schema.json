{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/g9-v2/chemistry/learning-blueprint/assimilation-design.schema.json",
  "title": "Chemistry Core1A assimilation reasoning design",
  "$defs": {
    "cognitiveTransformation": {"type":"object","additionalProperties":false,"required":["transformation_id","learner_before","required_change","learner_after"],"properties":{"transformation_id":{"type":"string"},"learner_before":{"type":"string","minLength":5},"required_change":{"type":"string","minLength":5},"learner_after":{"type":"string","minLength":5}}},
    "atom": {"type":"object","additionalProperties":false,"required":["atom_id","transition_kind","statement","prerequisite_refs","inferential_moves_to_next"],"properties":{"atom_id":{"type":"string"},"transition_kind":{"enum":["ENTITY_OR_STATE","CAUSE_OR_LAW","REPRESENTATION","FRAME_OR_SIGN","CONSTRAINT_OR_EVENT","EQUATION_RELATION","ALGEBRAIC_TRANSFORMATION","INTERPRETATION","SPECIAL_CASE","MISCONCEPTION_BOUNDARY"]},"statement":{"type":"string","minLength":5},"prerequisite_refs":{"type":"array","items":{"type":"string"}},"inferential_moves_to_next":{"type":"integer","minimum":0,"maximum":1}}},
    "inferenceStep": {"type":"object","additionalProperties":false,"required":["step_id","statement","learner_status","bridge_required","bridge","compression_allowed"],"properties":{"step_id":{"type":"string"},"statement":{"type":"string","minLength":5},"learner_status":{"enum":["SECURE","PARTIAL","FRAGILE","UNKNOWN"]},"bridge_required":{"type":"boolean"},"bridge":{"type":"string"},"compression_allowed":{"type":"boolean"}}},
    "equation": {"type":"object","additionalProperties":true,"required":["equation_id","importance"],"properties":{"equation_id":{"type":"string"},"importance":{"enum":["IMPORTANT","SUPPORTING"]}}},
    "representation": {"type":"object","additionalProperties":false,"required":["requirement","candidates","decision","single_candidate_waiver"],"properties":{"requirement":{"type":"object","additionalProperties":false,"required":["requirement_id","learning_problem","knowledge_type","must_make_visible","notice_before_math","must_not_imply"],"properties":{"requirement_id":{"type":"string"},"learning_problem":{"type":"string","minLength":5},"knowledge_type":{"type":"string","minLength":2},"must_make_visible":{"type":"array","minItems":1,"items":{"type":"string"}},"notice_before_math":{"type":"string","minLength":5},"must_not_imply":{"type":"string","minLength":5}}},"candidates":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["candidate_id","representation_type","strengths","risks"],"properties":{"candidate_id":{"type":"string"},"representation_type":{"type":"string"},"strengths":{"type":"array","minItems":1,"items":{"type":"string"}},"risks":{"type":"array","minItems":1,"items":{"type":"string"}}}}},"decision":{"type":"object","additionalProperties":false,"required":["primary_candidate_id","secondary_candidate_ids","selection_reason"],"properties":{"primary_candidate_id":{"type":"string"},"secondary_candidate_ids":{"type":"array","items":{"type":"string"}},"selection_reason":{"type":"string","minLength":5}}},"single_candidate_waiver":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["reason"],"properties":{"reason":{"type":"string","minLength":5}}}]}}}
  },
  "type":"object","additionalProperties":false,"required":["assimilation_request_id","capability_treatments"],
  "properties":{"assimilation_request_id":{"type":"string","minLength":2},"capability_treatments":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["capability_ref","obligation_ref","cognitive_transformation","learning_atoms","inference_chain","equations","representations","misconception_contrasts","symbol_bridge","fading_plan"],"properties":{"capability_ref":{"type":"string"},"obligation_ref":{"type":"string"},"cognitive_transformation":{"$ref":"#/$defs/cognitiveTransformation"},"learning_atoms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/atom"}},"inference_chain":{"type":"object","additionalProperties":false,"required":["chain_id","steps"],"properties":{"chain_id":{"type":"string"},"steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/inferenceStep"}}}},"equations":{"type":"array","items":{"$ref":"#/$defs/equation"}},"representations":{"type":"array","items":{"$ref":"#/$defs/representation"}},"misconception_contrasts":{"type":"array","items":{"type":"object"}},"symbol_bridge":{"oneOf":[{"type":"null"},{"type":"object"}]},"fading_plan":{"type":"object"}}}}}
}
