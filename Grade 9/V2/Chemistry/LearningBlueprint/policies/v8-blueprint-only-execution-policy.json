{
  "policy_id": "CHEM-G9-V2-BLUEPRINT-v8-BLUEPRINT-ONLY-EXECUTION",
  "schema_version": "8.0.0",
  "principle": "ALL_CHEMISTRY_TASKS_MUST_EXECUTE_FROM_SERIALIZED_BLUEPRINT_AUTHORITY_NOT_MODEL_OR_CONVERSATION_MEMORY",
  "allowed_authority_sources": [
    "BLUEPRINT_PACKET",
    "EXPLICIT_OWNER_INPUT",
    "CONNECTED_SOURCE_WITH_PROVENANCE",
    "WEB_RESEARCH_AUTHORIZED_BY_BLUEPRINT"
  ],
  "forbidden_authority_sources": [
    "MODEL_MEMORY",
    "CONVERSATION_MEMORY_AS_FACT_SOURCE",
    "AD_HOC_INFERENCE_AS_AUTHORITY",
    "UNTRACED_GENERAL_KNOWLEDGE"
  ],
  "task_types": [
    "TOPIC_SELECTION",
    "CONTENT_AUDIT",
    "CORE_GENERATION",
    "QUESTION_SELECTION",
    "EXAMPLE_SELECTION",
    "EQUATION_SELECTION",
    "DIFFICULTY_DECISION",
    "LEARNER_FIT",
    "TTU_DESIGN",
    "SIMILARITY_AUDIT",
    "RELEASE"
  ],
  "task_requirements": {
    "TOPIC_SELECTION": ["CANONICAL_DOMAIN_REGISTRY", "CDAU"],
    "CONTENT_AUDIT": ["CANONICAL_DOMAIN_REGISTRY", "CCBOM", "PRODUCT_ASSURANCE"],
    "CORE_GENERATION_CORE1A": ["CANONICAL_DOMAIN_REGISTRY", "CDAU", "SDU", "CONCEPT_TTU", "CCBOM", "PRODUCT_ASSURANCE"],
    "CORE_GENERATION_CORE1B": ["CANONICAL_DOMAIN_REGISTRY", "CDAU", "SDU", "CONCEPT_TTU", "TUTOR_DIALOGUE", "CCBOM", "PRODUCT_ASSURANCE"],
    "CORE_GENERATION_CORE2A": ["CANONICAL_DOMAIN_REGISTRY", "CDAU", "LAU", "PROBLEM_TTU", "QUESTION_CUSTODY", "CCBOM", "PRODUCT_ASSURANCE"],
    "CORE_GENERATION_CORE2B": ["CANONICAL_DOMAIN_REGISTRY", "CDAU", "LAU", "PROBLEM_TTU", "TUTOR_DIALOGUE", "QUESTION_CUSTODY", "CCBOM", "PRODUCT_ASSURANCE"],
    "QUESTION_SELECTION": ["PROBLEM_TTU", "QUESTION_CUSTODY"],
    "EXAMPLE_SELECTION": ["CANONICAL_DOMAIN_REGISTRY", "CCBOM", "CDAU"],
    "EQUATION_SELECTION": ["CANONICAL_DOMAIN_REGISTRY", "CCBOM"],
    "DIFFICULTY_DECISION": ["SDU", "PRODUCT_ASSURANCE"],
    "LEARNER_FIT": ["LAU", "PRODUCT_ASSURANCE"],
    "TTU_DESIGN_CONCEPT": ["CONCEPT_TTU", "CDAU"],
    "TTU_DESIGN_PROBLEM": ["PROBLEM_TTU", "CDAU"],
    "SIMILARITY_AUDIT": ["CDAU", "PRODUCT_ASSURANCE"],
    "RELEASE": ["CCBOM", "PRODUCT_ASSURANCE"]
  },
  "output_binding_rule": {
    "every_learner_facing_technical_object_requires_authority_ref": true,
    "technical_object_classes": [
      "CONCEPT",
      "LEARNING_ATOM",
      "EQUATION",
      "DATA",
      "EXAMPLE",
      "REPRESENTATION",
      "MISCONCEPTION",
      "BOUNDARY",
      "QUESTION",
      "ANSWER",
      "SOLUTION",
      "TTU",
      "DIFFICULTY_BADGE",
      "SUPPORT_DECISION"
    ]
  },
  "missing_authority_action": "BLOCK",
  "research_rule": "IF_AUTHORITY_IS_INCOMPLETE_RESEARCH_OR_OWNER_INPUT_MUST_UPDATE_THE_BLUEPRINT_PACKET_BEFORE_PRODUCT_EXECUTION_RESUMES",
  "conversation_memory_rule": "MAY_BE_USED_ONLY_TO_LOCATE_PRIOR_BLUEPRINT_REFERENCES_OR_USER_INTENT_NEVER_AS_CHEMISTRY_CONTENT_AUTHORITY"
}
