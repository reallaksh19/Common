{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-answer-record.schema.json",
  "title": "Chemistry Answer Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "response_mode", "verification"],
  "properties": {
    "question_id": {"type": "string", "minLength": 2},
    "response_mode": {"enum": ["MCQ", "CONSTRUCTED_RESPONSE", "OPEN_ENDED"]},
    "quick_check": {"type": ["string", "null"]},
    "full_working": {
      "type": "array",
      "items": {"type": "string", "minLength": 2}
    },
    "expected_response_rubric": {
      "type": "array",
      "items": {"type": "string", "minLength": 2}
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "final_unit_or_entity": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"response_mode": {"enum": ["MCQ", "CONSTRUCTED_RESPONSE"]}}},
      "then": {
        "required": ["quick_check", "full_working"],
        "properties": {
          "quick_check": {"type": "string", "minLength": 1},
          "full_working": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"response_mode": {"const": "OPEN_ENDED"}}},
      "then": {
        "required": ["expected_response_rubric"],
        "properties": {"expected_response_rubric": {"minItems": 1}}
      }
    }
  ]
}
