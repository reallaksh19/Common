{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-core1a-manuscript.schema.json",
  "title": "Chemistry Core1A Semantic Manuscript",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manuscript_id", "schema_version", "subject", "bucket_plan_ref", "bucket_plan_digest",
    "core1_plan_ref", "core1_plan_digest", "learner_language_policy_ref", "answer_path_policy_ref",
    "buckets", "summary", "manuscript_digest"
  ],
  "properties": {
    "manuscript_id": {"type": "string", "minLength": 3},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "CHEMISTRY"},
    "bucket_plan_ref": {"type": "string", "minLength": 3},
    "bucket_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core1_plan_ref": {"type": "string", "minLength": 3},
    "core1_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "learner_language_policy_ref": {"const": "CHEM-LEARNER-LANGUAGE-v1"},
    "answer_path_policy_ref": {"const": "CHEM-ANSWER-PATH-v1"},
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bucket_id", "learner_title", "bucket_invariant", "teaching_sections",
          "problem_family_routines", "practice_items", "readiness_gate"
        ],
        "properties": {
          "bucket_id": {"type": "string"},
          "learner_title": {"type": "string", "minLength": 1},
          "bucket_invariant": {"type": "string", "minLength": 1},
          "teaching_sections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "problem_family_routines": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "practice_items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_ref", "capability_ref", "support_stage", "prompt", "answer_path"],
              "properties": {
                "item_ref": {"type": "string"},
                "capability_ref": {"type": "string"},
                "support_stage": {"type": "string"},
                "prompt": {"type": "string", "minLength": 1},
                "answer_path": {"type": "object"}
              }
            }
          },
          "readiness_gate": {"type": "object"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_count", "teaching_section_count", "practice_question_count",
        "open_rubric_count", "objective_question_count", "answer_path_failures", "status"
      ],
      "properties": {
        "bucket_count": {"type": "integer", "minimum": 1},
        "teaching_section_count": {"type": "integer", "minimum": 1},
        "practice_question_count": {"type": "integer", "minimum": 0},
        "open_rubric_count": {"type": "integer", "minimum": 0},
        "objective_question_count": {"type": "integer", "minimum": 0},
        "answer_path_failures": {"const": 0},
        "status": {"const": "PASS"}
      }
    },
    "manuscript_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
