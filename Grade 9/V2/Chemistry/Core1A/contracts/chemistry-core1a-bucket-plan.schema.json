{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-core1a-bucket-plan.schema.json",
  "title": "Chemistry Core1A Bucket Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "schema_version",
    "subject",
    "study_model_ref",
    "study_model_digest",
    "core1_plan_ref",
    "core1_plan_digest",
    "representation_bundle_ref",
    "representation_bundle_digest",
    "core2_plan_ref",
    "core2_plan_digest",
    "problem_family_registry_ref",
    "synthesis_policy_ref",
    "buckets",
    "coverage",
    "plan_digest"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^CHEM-C1A-BP-"},
    "schema_version": {"const": "1.0.0"},
    "subject": {"const": "CHEMISTRY"},
    "study_model_ref": {"type": "string", "minLength": 1},
    "study_model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core1_plan_ref": {"type": "string", "minLength": 1},
    "core1_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representation_bundle_ref": {"type": "string", "minLength": 1},
    "representation_bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core2_plan_ref": {"type": "string", "minLength": 1},
    "core2_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "problem_family_registry_ref": {"type": "string", "minLength": 1},
    "synthesis_policy_ref": {"const": "CHEM-CORE1A-BUCKET-SYNTHESIS-v1"},
    "buckets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/bucket"}
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "learnerTreatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ref", "learner_state", "treatment", "priority"],
      "properties": {
        "capability_ref": {"type": "string", "minLength": 1},
        "learner_state": {"enum": ["UNKNOWN", "DEMONSTRATED", "EVIDENCE_OF_DIFFICULTY", "MIXED"]},
        "treatment": {"enum": ["READY_VERIFY_ONLY", "ACTIVE_STUDY", "REPAIR_BEFORE", "REPAIR_IN_UNIT", "PROBE_FIRST"]},
        "priority": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "learningAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "capability_ref", "atom_kind", "text", "source_refs"],
      "properties": {
        "atom_id": {"type": "string", "pattern": "^CHEM-C1A-ATOM-"},
        "capability_ref": {"type": "string", "minLength": 1},
        "atom_kind": {
          "enum": [
            "MEANING",
            "RULE_MODEL_CONDITION",
            "RECONSTRUCTION_STEP",
            "WORKED_REASONING",
            "MISCONCEPTION_CONTRAST",
            "TRANSFER_BRIDGE"
          ]
        },
        "text": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "representationObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation_ref", "capability_ref", "primitive_id", "instructional_job", "learner_action_expected"],
      "properties": {
        "representation_ref": {"type": "string", "minLength": 1},
        "capability_ref": {"type": "string", "minLength": 1},
        "primitive_id": {"type": "string", "minLength": 1},
        "instructional_job": {"type": "string", "minLength": 1},
        "learner_action_expected": {"type": "string", "minLength": 1}
      }
    },
    "representationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "evidence_refs", "reason"],
      "properties": {
        "stage": {
          "enum": [
            "SEE_THE_PHENOMENON",
            "SEE_THE_PARTICLES",
            "SEE_THE_CHEMICAL_STRUCTURE",
            "SEE_THE_SYMBOLS",
            "CONNECT_THE_QUANTITIES",
            "DO_THE_CHEMISTRY",
            "VERIFY_THE_RESULT",
            "CONNECT_TO_CORE2"
          ]
        },
        "status": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "REQUIRED"}}, "required": ["status"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    },
    "problemFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_family_ref",
        "chemical_signature",
        "recognition_signals",
        "method_steps",
        "core2_primary_question_refs"
      ],
      "properties": {
        "problem_family_ref": {"type": "string", "pattern": "^PF-"},
        "chemical_signature": {"type": "string", "minLength": 1},
        "recognition_signals": {"$ref": "#/$defs/strings"},
        "method_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "core2_primary_question_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "hintBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_ref", "h1_evidence_refs", "h2_evidence_refs", "h3_evidence_refs"],
      "properties": {
        "question_ref": {"type": "string", "minLength": 1},
        "h1_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "h2_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "h3_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "readinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_dimensions", "release_rule", "remediation_target_kind"],
      "properties": {
        "required_dimensions": {
          "const": ["RECOGNISE", "REPRESENT", "FIRST_MOVE", "FINISH_AND_VERIFY"]
        },
        "release_rule": {"const": "4_OF_4_WITHOUT_H2_OR_H3"},
        "remediation_target_kind": {"const": "LEARNING_ATOM_OR_PROBLEM_FAMILY_ROUTINE"}
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_id",
        "learner_title",
        "bucket_invariant",
        "intrinsic_difficulty",
        "primary_problem_family_ref",
        "primary_capability_refs",
        "supporting_capability_refs",
        "learner_treatment_by_capability",
        "source_obligation_refs",
        "assessment_question_refs",
        "core2_primary_question_refs",
        "learning_atoms",
        "representation_obligations",
        "representation_sequence",
        "problem_families",
        "core2_hint_bindings",
        "readiness_gate"
      ],
      "properties": {
        "bucket_id": {"type": "string", "pattern": "^CHEM-C1A-SBA-[0-9]{2}$"},
        "learner_title": {"type": "string", "minLength": 3},
        "bucket_invariant": {"type": "string", "minLength": 3},
        "intrinsic_difficulty": {"enum": ["D1", "D2", "D3"]},
        "primary_problem_family_ref": {"type": "string", "pattern": "^PF-"},
        "primary_capability_refs": {"$ref": "#/$defs/strings"},
        "supporting_capability_refs": {"$ref": "#/$defs/strings"},
        "learner_treatment_by_capability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learnerTreatment"}},
        "source_obligation_refs": {"$ref": "#/$defs/strings"},
        "assessment_question_refs": {"$ref": "#/$defs/strings"},
        "core2_primary_question_refs": {"$ref": "#/$defs/strings"},
        "learning_atoms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learningAtom"}},
        "representation_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/representationObligation"}},
        "representation_sequence": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/representationStage"}
        },
        "problem_families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/problemFamily"}},
        "core2_hint_bindings": {"type": "array", "items": {"$ref": "#/$defs/hintBinding"}},
        "readiness_gate": {"$ref": "#/$defs/readinessGate"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_capability_refs",
        "placed_capability_refs",
        "missing_capability_refs",
        "duplicate_primary_capability_refs",
        "required_core2_question_refs",
        "mapped_core2_question_refs",
        "missing_core2_question_refs",
        "hint_reveals_required",
        "hint_reveals_bound",
        "status"
      ],
      "properties": {
        "required_capability_refs": {"$ref": "#/$defs/strings"},
        "placed_capability_refs": {"$ref": "#/$defs/strings"},
        "missing_capability_refs": {"$ref": "#/$defs/strings"},
        "duplicate_primary_capability_refs": {"$ref": "#/$defs/strings"},
        "required_core2_question_refs": {"$ref": "#/$defs/strings"},
        "mapped_core2_question_refs": {"$ref": "#/$defs/strings"},
        "missing_core2_question_refs": {"$ref": "#/$defs/strings"},
        "hint_reveals_required": {"type": "integer", "minimum": 0},
        "hint_reveals_bound": {"type": "integer", "minimum": 0},
        "status": {"const": "PASS"}
      }
    }
  }
}
