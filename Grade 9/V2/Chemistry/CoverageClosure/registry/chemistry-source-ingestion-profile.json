  "purpose": "Freeze the source/question denominator from the supplied documents BEFORE authoring is allowed to start, and keep it reconcilable afterwards. This replaces PR #346's manual per-topic source audit with a generic stage whose counters are re-derived from declared evidence.",
  "required_counters": [
    "TOTAL_SCANNED",
    "ELIGIBLE_IN_SCOPE",
    "PLACED_UNIQUE",
    "EXCLUDED_WITH_REASON",
    "UNRESOLVED_WITH_REASON",
    "MISSING",
    "DUPLICATE_PRIMARY"
  ],
  "closure_invariants": [
    "ELIGIBLE_IN_SCOPE == PLACED_UNIQUE",
    "MISSING == 0",
    "DUPLICATE_PRIMARY == 0",
    "TOTAL_SCANNED == ELIGIBLE_IN_SCOPE + EXCLUDED_WITH_REASON + UNRESOLVED_WITH_REASON"
  ],
  "freeze_states": [
    "UNFROZEN",
    "FROZEN_ELIGIBLE_ONLY",
    "FROZEN_ITEM_LEDGER"
  ],
  "authoring_requires_freeze_state": [
    "FROZEN_ITEM_LEDGER"
  ],
  "freeze_state_semantics": {
    "UNFROZEN": "No denominator has been frozen. Authoring is refused.",
    "FROZEN_ELIGIBLE_ONLY": "The eligible/placed denominator is frozen and reconcilable, but the scanned denominator and exclusion counts were never recorded by the producing run. Usable as a coverage baseline; NOT sufficient to start authoring a new chapter.",
    "FROZEN_ITEM_LEDGER": "Every scanned item is enumerated with a status and an explicit reason where it is not eligible. Authoring may start."
  },
  "unresolved_counter_policy": "RECORD_AS_UNRESOLVED_NEVER_INFER",
  "falsifiers": [
    "SOURCE_DENOMINATOR_NOT_FROZEN",
    "AUTHORING_BEFORE_DENOMINATOR_FREEZE",
    "ELIGIBLE_PLACED_MISMATCH",
    "MISSING_SOURCE_ITEM",
    "DUPLICATE_PRIMARY_PLACEMENT",
    "EXCLUSION_WITHOUT_REASON",
    "SCANNED_TOTAL_RECONCILIATION_FAILURE",
    "INGESTION_EVIDENCE_DIGEST_MISMATCH",
    "FROZEN_COUNTERS_NOT_DERIVED_FROM_EVIDENCE",
    "SOURCE_ITEM_LEDGER_UNAVAILABLE",
    "POST_AUTHORING_DENOMINATOR_DRIFT"
  ],
