{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemistry-core-appendix-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appendix_a",
    "appendix_b",
    "appendix_c"
  ],
  "properties": {
    "appendix_a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "present",
        "items"
      ],
      "properties": {
        "title": {
          "const": "Appendix A — Core Practice"
        },
        "present": {
          "const": true
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/practice"
          }
        }
      }
    },
    "appendix_b": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "present",
        "solutions"
      ],
      "properties": {
        "title": {
          "const": "Appendix B — Core Solutions"
        },
        "present": {
          "const": true
        },
        "solutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/solution"
          }
        }
      }
    },
    "appendix_c": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "present",
        "answer_free",
        "supported_capability_refs",
        "introduced_capability_refs",
        "reference_entries",
        "print_constraints"
      ],
      "properties": {
        "title": {
          "const": "Appendix C — Printable Handout"
        },
        "present": {
          "const": true
        },
        "answer_free": {
          "const": true
        },
        "supported_capability_refs": {
          "$ref": "#/$defs/strings"
        },
        "introduced_capability_refs": {
          "type": "array",
          "maxItems": 0
        },
        "reference_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_ref",
              "first_move",
              "rule_or_decision_cue",
              "verification_cue"
            ],
            "properties": {
              "capability_ref": {
                "type": "string"
              },
              "first_move": {
                "type": "string"
              },
              "rule_or_decision_cue": {
                "type": "string"
              },
              "verification_cue": {
                "type": "string"
              }
            }
          }
        },
        "print_constraints": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GRAYSCALE_SAFE",
              "NO_COLOR_DEPENDENCY",
              "NOTATION_SAFE",
              "ANSWER_FREE",
              "STANDALONE_USABLE"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "source_class",
        "problem_family_ref",
        "primary_capability_ref",
        "supports_capability_refs",
        "support_stage",
        "scored",
        "prompt",
        "representation_spec",
        "external_candidate_refs",
        "instance_custody",
        "solution_ref",
        "instance_authority",
        "instance_digest"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "source_class": {
          "const": "NEW_AUTHORED_CORE1"
        },
        "problem_family_ref": {
          "type": "string",
          "minLength": 1
        },
        "primary_capability_ref": {
          "type": "string"
        },
        "supports_capability_refs": {
          "$ref": "#/$defs/strings"
        },
        "support_stage": {
          "enum": [
            "GUIDED",
            "FADED",
            "INDEPENDENT",
            "PROBE"
          ]
        },
        "scored": {
          "type": "boolean"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "representation_spec": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_candidate_refs": {
          "type": "array",
          "maxItems": 0
        },
        "solution_ref": {
          "type": "string"
        },
        "instance_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instance_authority": {
          "$ref": "#/$defs/instanceAuthority"
        },
        "instance_custody": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "authority_refs",
            "concrete_prompt"
          ],
          "properties": {
            "status": {
              "enum": [
                "GROUNDED",
                "UNRESOLVED"
              ]
            },
            "authority_refs": {
              "$ref": "#/$defs/strings"
            },
            "concrete_prompt": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solution_id",
        "item_ref",
        "primary_capability_ref",
        "reasoning_steps",
        "verification_steps",
        "instance_custody",
        "final_response",
        "condition_exception_note",
        "instance_digest"
      ],
      "properties": {
        "solution_id": {
          "type": "string"
        },
        "item_ref": {
          "type": "string"
        },
        "primary_capability_ref": {
          "type": "string"
        },
        "reasoning_steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "verification_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "final_response": {
          "type": "string",
          "minLength": 1
        },
        "condition_exception_note": {
          "type": "string"
        },
        "instance_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instance_custody": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis_refs",
            "instance_specific"
          ],
          "properties": {
            "status": {
              "enum": [
                "CHECKABLE",
                "UNRESOLVED"
              ]
            },
            "basis_refs": {
              "$ref": "#/$defs/strings"
            },
            "instance_specific": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "instanceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_kind",
        "authority_ref",
        "source_locator",
        "authority_digest",
        "content",
        "representation"
      ],
      "properties": {
        "authority_kind": {
          "enum": [
            "SOURCE_OBLIGATION",
            "ASSESSMENT_QUESTION"
          ]
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formulas",
            "charges",
            "coefficients",
            "states",
            "conditions",
            "structures",
            "figures",
            "observations",
            "units"
          ],
          "properties": {
            "formulas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "charges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "coefficients": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "states": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "figures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "units": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
