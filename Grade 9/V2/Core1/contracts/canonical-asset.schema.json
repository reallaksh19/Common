{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-asset.schema.json",
  "title": "V2 Canonical Asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_id","asset_version","subject_domain","semantic_kind","promotion_state","semantic_payload","conditions","dependencies","provenance_refs","representation_refs","requires_revalidation","semantic_digest"],
  "properties": {
    "canonical_id": {"type":"string","pattern":"^[A-Z0-9][A-Z0-9._:-]+$"},
    "asset_version": {"type":"string","minLength":1},
    "subject_domain": {"type":"string","minLength":2},
    "semantic_kind": {"enum":["CONCEPT","CAPABILITY","FORMAL_OBJECT","RELATION","REPRESENTATION","MISCONCEPTION_SIGNATURE","DIAGNOSTIC_PROBE"]},
    "promotion_state": {"enum":["RESEARCH_CANDIDATE","SUBJECT_AUTHORITY_REVIEW","PROMOTED","REJECTED"]},
    "semantic_payload": {"type":"object","minProperties":1},
    "conditions": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["canonical_id","relation","reason"],"properties":{"canonical_id":{"type":"string","minLength":2},"relation":{"enum":["REQUIRES","USES_SHARED","REFINES"]},"reason":{"type":"string","minLength":3}}}},
    "provenance_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":2}},
    "representation_refs": {"type":"array","items":{"type":"string","minLength":2}},
    "requires_revalidation": {"type":"boolean"},
    "semantic_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
