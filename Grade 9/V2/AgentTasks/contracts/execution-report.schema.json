{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/common/schemas/grade9/agent-tasks/execution-report.schema.json",
  "title": "StandaloneExecutionReport",
  "description": "Governing schema for machine completion reports generated by executing agents. Separates execution completion from engineering readiness, research state, and publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_identity",
    "packet_identity",
    "start_head",
    "end_head",
    "execution_result",
    "engineering_state",
    "consumer_permissions",
    "authority_bindings_used",
    "changed_files",
    "tests",
    "workflows",
    "blockers",
    "limitations",
    "unresolved",
    "architecture_findings",
    "memory_dependency_detected"
  ],
  "properties": {
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "agent_id", "timestamp"],
      "properties": {
        "execution_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "packet_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "compiled_packet_digest"],
      "properties": {
        "packet_id": { "type": "string" },
        "compiled_packet_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "start_head": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|UNKNOWN)$"
    },
    "end_head": {
      "type": "string",
      "pattern": "^([0-9a-f]{7,40}|UNKNOWN)$"
    },
    "execution_result": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED"],
      "description": "Task execution outcome. A task can complete successfully by proving engineering remains HELD."
    },
    "engineering_state": {
      "type": "string",
      "enum": [
        "ENGINEERING_GATE_READY",
        "ENGINEERING_GATE_INCOMPLETE",
        "HELD",
        "NOT_EVALUATED"
      ],
      "description": "State derived strictly by evaluating repository Engineering Gate policy; never manually asserted."
    },
    "research_state": {
      "type": "string",
      "enum": [
        "NOT_REQUESTED",
        "DISCOVERY_ONLY",
        "PROMOTED_WITH_PROVENANCE",
        "REJECTED_UNVERIFIED"
      ],
      "description": "Disposition of external research evidence."
    },
    "consumer_permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["READY", "HELD", "NOT_EVALUATED", "NOT_IMPLIED"]
      },
      "description": "Permission states for downstream consumers (PROBLEM_SEMANTICS, CORE_AUTHORING, etc.)."
    },
    "publication_state": {
      "type": "string",
      "enum": [
        "NOT_IMPLIED",
        "PENDING_AUTHORIZED_HUMAN_REVIEW",
        "BLOCKED"
      ],
      "default": "NOT_IMPLIED",
      "description": "Publication readiness. Strictly requires authorized human review attestation; never inferred from Engineering."
    },
    "authority_bindings_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_class", "ref_path", "digest_sha256"],
        "properties": {
          "authority_class": { "type": "string" },
          "ref_path": { "type": "string" },
          "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "change_class", "authority_impact"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" },
          "change_class": {
            "type": "string",
            "enum": [
              "DATA_ONLY",
              "CONTRACT_OR_SCHEMA",
              "GENERIC_ENGINE",
              "SUBJECT_ADAPTER",
              "BLUEPRINT",
              "TEST",
              "DOC",
              "MIGRATION"
            ]
          },
          "authority_impact": { "type": "string" }
        }
      }
    },
    "discovery_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "source_locator", "rights_use", "disposition"],
        "properties": {
          "title": { "type": "string" },
          "source_locator": { "type": "string" },
          "rights_use": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": [
              "REUSE_EXISTING",
              "EXTEND_EXISTING",
              "CREATE_CHILD",
              "CREATE_NEW",
              "CURRICULUM_ONLY",
              "PEDAGOGY_ONLY",
              "ASSESSMENT_ONLY",
              "RESEARCH_OVERLAY_ONLY",
              "OUT_OF_SCOPE",
              "CONFLICTING",
              "UNRESOLVED"
            ]
          }
        }
      },
      "default": []
    },
    "promotion_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "disposition", "source_provenance_ref", "justification"],
        "properties": {
          "item_id": { "type": "string" },
          "disposition": { "type": "string" },
          "source_provenance_ref": { "type": "string" },
          "justification": { "type": "string" }
        }
      },
      "default": []
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test", "result", "evidence"],
        "properties": {
          "test": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "SKIPPED", "NOT_RUN"]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow", "run", "result"],
        "properties": {
          "workflow": { "type": "string" },
          "run": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific blocking reasons if execution_result is BLOCKED or engineering_state is HELD."
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    },
    "architecture_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "memory_dependency_detected": {
      "type": "boolean",
      "description": "True if execution relied on unrecorded conversation or out-of-band memory."
    },
    "recommended_next_task": {
      "type": "string"
    }
  }
}
