{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reallaksh19/Common/Grade%209/Chemistry/schema/chemistry-publication-package.schema.json",
  "title": "Grade 9 Chemistry Publication Package",
  "type": "object",
  "required": ["schema_version","subject","package_id","chapter_id","source_obligations_path","artifacts","review_state"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "subject": {"const": "Chemistry"},
    "package_id": {"type":"string","minLength":3},
    "chapter_id": {"type":"string","minLength":1},
    "source_obligations_path": {"type":"string"},
    "external_corpus_path": {"type":["string","null"]},
    "artifact_bundle_manifest_path": {"type":["string","null"]},
    "render_audit_path": {"type":"string"},
    "review_docs": {"type":"array","items":{"type":"string"},"minItems":1},
    "artifacts": {
      "type":"array","minItems":1,
      "items": {
        "type":"object",
        "required":["artifact_id","filename","sha256","pages","review_text_snapshot","min_font_size_pt"],
        "properties": {
          "artifact_id":{"type":"string"},
          "filename":{"type":"string"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "pages":{"type":"integer","minimum":1},
          "review_text_snapshot":{"type":"string"},
          "review_text_snapshot_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "link_expectations_path":{"type":["string","null"]},
          "min_font_size_pt":{"type":"number","minimum":1},
          "required_notation_probes":{"type":"array","items":{"type":"string"}},
          "forbidden_text_patterns":{"type":"array","items":{"type":"string"}},
          "question_page_ranges":{"type":"array","items":{"type":"array","prefixItems":[{"type":"integer"},{"type":"integer"}],"minItems":2,"maxItems":2}},
          "answer_markers":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": true
      }
    },
    "review_state": {
      "type":"object",
      "required":["technical_gate","independent_pedagogy_review","classroom_validation"],
      "properties": {
        "technical_gate":{"enum":["PASS","BLOCKED","PENDING"]},
        "independent_pedagogy_review":{"enum":["PASS","PENDING","NOT_RUN"]},
        "classroom_validation":{"enum":["PASS","PENDING","NOT_RUN"]}
      }
    }
  },
  "additionalProperties": true
}
