{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core2-study-guide.schema.json",
  "title": "Core2 StudyGuidePublicationModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["publication_id", "schema_version", "publication_plan_id", "title", "main_sections", "appendix_A", "appendix_B", "appendix_C"],
  "properties": {
    "publication_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "publication_plan_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "main_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "concept_id", "instructional_profile", "items"],
        "properties": {
          "section_id": {"type": "string"},
          "concept_id": {"type": "string"},
          "instructional_profile": {"enum": ["FOUNDATION", "BRIDGE", "COMPRESSED", "REFERENCE"]},
          "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material_item"}}
        }
      }
    },
    "appendix_A": {"$ref": "#/$defs/appendix"},
    "appendix_B": {"$ref": "#/$defs/appendix"},
    "appendix_C": {"$ref": "#/$defs/appendix"}
  },
  "$defs": {
    "material_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "type", "content", "traceability_class", "research_refs"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["CLAIM", "CONDITION", "WORKED_REASONING", "REPRESENTATION", "FORMAL_OBJECT", "PRACTICE_PROMPT", "SOLUTION", "CONNECTIVE", "BADGE_LINE"]},
        "content": {"type": "string"},
        "traceability_class": {"enum": ["MATERIAL", "PEDAGOGICAL_CONNECTIVE", "PRESENTATION_ONLY"]},
        "research_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "representation_instance_id": {"type": "string"}
      }
    },
    "appendix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "items": {"type": "array", "items": {"$ref": "#/$defs/material_item"}}
      }
    }
  }
}
