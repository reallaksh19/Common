{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core2-representation-instance.schema.json",
  "title": "Core2 RepresentationInstance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "representation_instance_id",
    "requirement_id",
    "representation_type",
    "renderer_id",
    "route",
    "placement_role",
    "research_refs",
    "required_labels",
    "status"
  ],
  "properties": {
    "representation_instance_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "representation_type": {"type": "string", "minLength": 1},
    "renderer_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string"},
    "route": {"enum": ["GENERATED_VECTOR", "APPROVED_VECTOR_ASSET", "SOURCE_CROP"]},
    "placement_role": {"enum": ["TEACHING", "QUESTION", "SOLUTION", "APPENDIX"]},
    "research_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_labels": {"type": "array", "items": {"type": "string"}},
    "rendered_labels": {"type": "array", "items": {"type": "string"}, "default": []},
    "asset_id": {"type": "string"},
    "duplicate_of": {"type": "string"},
    "grayscale_safe": {"type": "boolean"},
    "bounds_pass": {"type": "boolean"},
    "legibility_pass": {"type": "boolean"},
    "status": {"enum": ["PLANNED", "RENDERED", "FAILED_UNSUPPORTED", "FAILED_QA"]}
  }
}
