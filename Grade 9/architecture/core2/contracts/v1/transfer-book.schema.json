{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core2-transfer-book.schema.json",
  "title": "Core2 TransferBookPublicationModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["publication_id", "schema_version", "publication_plan_id", "title", "sets", "solutions"],
  "properties": {
    "publication_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "publication_plan_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "question_evidence_ledger_id": {"type": "string"},
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set_id", "mode", "question_ids"],
        "properties": {
          "set_id": {"type": "string"},
          "mode": {"enum": ["ASSIMILATION", "MIXED_TRANSFER"]},
          "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["question_id", "research_refs", "primary_concept_id", "stem"],
        "properties": {
          "question_id": {"type": "string"},
          "research_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "primary_concept_id": {"type": "string"},
          "stem": {"type": "string", "minLength": 1},
          "hint_profile": {"enum": ["H0", "H1_H3", "NONE"]},
          "source_badge_id": {"type": "string"},
          "difficulty_badge_id": {"type": "string"},
          "transfer_badge_id": {"type": "string"}
        }
      },
      "default": []
    },
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["question_id", "method", "answer", "research_refs"],
        "properties": {
          "question_id": {"type": "string"},
          "method": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "research_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
