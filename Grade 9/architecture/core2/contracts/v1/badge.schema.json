{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core2-badge.schema.json",
  "title": "Core2 Badge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["badge_id", "type", "machine_value", "label", "visual_token", "student_visible"],
  "properties": {
    "badge_id": {"type": "string", "minLength": 1},
    "type": {"enum": ["SOURCE", "EXAM", "YEAR_SHIFT", "DIFFICULTY", "TRANSFER", "TASK", "STATUS", "BASELINE_SUPPORT"]},
    "machine_value": {"type": ["string", "integer", "number", "boolean"]},
    "label": {"type": "string", "minLength": 1},
    "visual_token": {"type": "string", "minLength": 1},
    "student_visible": {"type": "boolean"},
    "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
    "monochrome_label": {"type": "string"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
