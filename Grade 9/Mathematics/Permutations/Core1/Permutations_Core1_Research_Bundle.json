        "SRC-REPO-MATH-CORPUS-AUDITOR"
      ],
      "statement": "Positional restrictions should be applied to the restricted positions or value classes before using an unrestricted permutation count; otherwise the base sample space is wrong.",
      "traceability_class": "MATERIAL_CLAIM",
      "verification_status": "VERIFIED"
    },
    {
