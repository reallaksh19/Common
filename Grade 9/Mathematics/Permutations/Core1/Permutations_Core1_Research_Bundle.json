      ],
      "statement": "When specified objects must stay together, a block representation preserves the external order of the block and the internal order within it; both levels must be counted exactly once.",
      "traceability_class": "MATERIAL_CLAIM",
      "verification_status": "VERIFIED"
    },
    {
      "claim_id": "R-MATH-PERM-006",
