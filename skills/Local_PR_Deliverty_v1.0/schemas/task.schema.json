{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1:task",
  "type": "object",
  "properties": {
    "record": {
      "const": "TASK"
    },
    "version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "PARENT",
        "CHILD"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "parent_issue": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "parent_owner": {
      "type": "string",
      "minLength": 1
    },
    "spec_ref": {
      "type": "string",
      "format": "uri"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}:skills/Local_PR_Deliverty_v1[.]0$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "requirement",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "issue",
          "scope",
          "covers",
          "depends_on"
        ],
        "additionalProperties": false
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "timers": {
      "type": "object",
      "properties": {
        "poll_seconds": {
          "const": 60
        },
        "stage_minutes": {
          "type": "object",
          "properties": {
            "CODER": {
              "type": "integer",
              "minimum": 1
            },
            "REVIEWER": {
              "type": "integer",
              "minimum": 1
            },
            "COORDINATOR": {
              "type": "integer",
              "minimum": 1
            },
            "PARENT_CHECK": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "CODER",
            "REVIEWER",
            "COORDINATOR",
            "PARENT_CHECK"
          ],
          "additionalProperties": false
        },
        "ci_wait_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_grace_minutes": {
          "const": 5
        },
        "handover_seconds": {
          "const": 0
        },
        "override_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "poll_seconds",
        "stage_minutes",
        "ci_wait_minutes",
        "recovery_grace_minutes",
        "handover_seconds",
        "override_reason"
      ],
      "additionalProperties": false
    },
    "owner_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "enum": [
              "HOLD",
              "PAUSE",
              "RESUME",
              "STOP",
              "TIMER",
              "STATUS"
            ]
          },
          "target": {
            "enum": [
              "ALL",
              "CODER",
              "REVIEWER",
              "COORDINATOR"
            ]
          },
          "child_issue": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "instruction_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "id",
          "command",
          "target",
          "child_issue",
          "issued_at",
          "instruction_ref",
          "reason",
          "minutes"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "command": {
                  "const": "TIMER"
                }
              }
            },
            "then": {
              "properties": {
                "minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "target": {
                  "const": "ALL"
                },
                "child_issue": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "minutes": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "merge_authority": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "OWNER_ONLY",
            "DELEGATED"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "reference"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record",
    "version",
    "task_id",
    "kind",
    "repository",
    "issue",
    "parent_issue",
    "pr",
    "parent_owner",
    "spec_ref",
    "spec_digest",
    "protocol_ref",
    "scope",
    "acceptance",
    "children",
    "required_checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PARENT"
          }
        }
      },
      "then": {
        "required": [
          "workspace",
          "timers",
          "owner_commands",
          "merge_authority"
        ],
        "properties": {
          "parent_issue": {
            "type": "null"
          },
          "pr": {
            "type": "null"
          },
          "children": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CHILD"
          }
        }
      },
      "then": {
        "properties": {
          "parent_issue": {
            "type": "integer",
            "minimum": 1
          },
          "children": {
            "maxItems": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "workspace"
              ]
            },
            {
              "required": [
                "timers"
              ]
            },
            {
              "required": [
                "owner_commands"
              ]
            },
            {
              "required": [
                "merge_authority"
              ]
            }
          ]
        }
      }
    }
  ]
}
