{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Z][A-Z0-9._:-]{0,71}$",
      "type": "string"
    },
    "owner_event": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "REQUIREMENT_MIRROR",
            "AMENDMENT_MIRROR",
            "DECISION_CLAIM"
          ]
        },
        "predecessor_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_grade": {
          "enum": [
            "UNKNOWN",
            "GITHUB_VERBATIM_MIRROR",
            "SYNTHETIC_LAB_ONLY"
          ]
        },
        "source_url": {
          "maxLength": 400,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "source_grade",
        "source_url",
        "content_sha256",
        "predecessor_id"
      ],
      "type": "object"
    },
    "session_event": {
      "additionalProperties": false,
      "properties": {
        "actor_label": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\n\\r]*$",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "START_CLAIMED",
            "STOP_CLAIMED",
            "HANDOVER_OFFERED",
            "RUNNER_PREPARED"
          ]
        },
        "owner_event_id": {
          "$ref": "#/$defs/id"
        },
        "predecessor_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "source_commit": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "session_id",
        "actor_label",
        "kind",
        "owner_event_id",
        "source_commit",
        "predecessor_id"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "$id": "relay-lifecycle-owner-session-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reference-only research observations. No Owner authentication, writer lease, Local approval or progress authority.",
  "properties": {
    "identity": {
      "type": "object"
    },
    "mode": {
      "const": "RESEARCH_ONLY"
    },
    "owner_events": {
      "items": {
        "$ref": "#/$defs/owner_event"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "relay-lifecycle-owner-session-v1"
    },
    "session_events": {
      "items": {
        "$ref": "#/$defs/session_event"
      },
      "maxItems": 4096,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "mode",
    "identity",
    "owner_events",
    "session_events"
  ],
  "title": "R14 WP1/U2 - untrusted Owner event and session custody observation envelope",
  "type": "object"
}
