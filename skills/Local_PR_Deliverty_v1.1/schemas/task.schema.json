{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:task",
  "type": "object",
  "properties": {
    "record": {"const": "TASK"},
    "version": {"const": "1.1"},
    "task_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["PARENT", "RESPONSIBILITY", "CHILD"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "issue": {"type": "integer", "minimum": 1},
    "parent_issue": {"type": ["integer", "null"], "minimum": 1},
    "pr": {"type": ["integer", "null"], "minimum": 1},
    "parent_owner": {"type": "string", "minLength": 1},
    "spec_ref": {"type": "string", "format": "uri"},
    "spec_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}:skills/Local_PR_Deliverty_v1[.]1$"
    },
    "scope": {"type": "string", "minLength": 1},
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "verification_method_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "super_review_required": {"type": "boolean"}
        },
        "required": ["id", "requirement", "required", "verification_method_ids", "super_review_required"],
        "additionalProperties": false
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "scope": {"type": "string", "minLength": 1},
          "covers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        },
        "required": ["issue", "scope", "covers", "depends_on"],
        "additionalProperties": false
      }
    },
    "representation": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["SINGLE_ISSUE", "ISSUE_SET", "CONTINUATION"]},
        "primary_issue": {"type": "integer", "minimum": 1},
        "member_issues": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "predecessor_attempt_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "delivery_pr_history": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        }
      },
      "required": ["kind", "primary_issue", "member_issues", "predecessor_attempt_refs", "delivery_pr_history"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "SINGLE_ISSUE"}}},
          "then": {"properties": {"member_issues": {"maxItems": 1}}}
        },
        {
          "if": {"properties": {"kind": {"const": "ISSUE_SET"}}},
          "then": {"properties": {"member_issues": {"minItems": 2}}}
        }
      ]
    },
    "acceptance_epoch_id": {"type": "string", "minLength": 1},
    "acceptance_profile_ref": {"type": "string", "minLength": 1},
    "acceptance_profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_plane": {
      "type": "object",
      "properties": {
        "bootstrap_state": {"enum": ["INCOMPLETE", "ESTABLISHED"]},
        "current_acceptance_epoch_id": {"type": ["string", "null"], "minLength": 1},
        "acceptance_basis_registry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "epoch_id": {"type": "string", "minLength": 1},
              "epoch_ref": {"type": "string", "minLength": 1},
              "epoch_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "required": ["epoch_id", "epoch_ref", "epoch_digest"],
            "additionalProperties": false
          }
        },
        "responsibility_registry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {"type": "string", "pattern": "^PRD-[A-Za-z0-9_.-]+$"},
              "release_state": {"enum": ["READY", "BLOCKED_DEPENDENCY", "HELD", "STOPPED"]},
              "acceptance_profile_ref": {"type": "string", "minLength": 1},
              "acceptance_profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "required": ["task_id", "release_state", "acceptance_profile_ref", "acceptance_profile_digest"],
            "additionalProperties": false
          }
        },
        "authority_grant_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": [
        "bootstrap_state", "current_acceptance_epoch_id", "acceptance_basis_registry",
        "responsibility_registry", "authority_grant_refs"
      ],
      "additionalProperties": false
    },
    "required_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "workspace": {"type": "string", "minLength": 1},
    "timers": {
      "type": "object",
      "properties": {
        "poll_seconds": {"const": 60},
        "stage_minutes": {
          "type": "object",
          "properties": {
            "CODER": {"type": "integer", "minimum": 1},
            "REVIEWER": {"type": "integer", "minimum": 1},
            "COORDINATOR": {"type": "integer", "minimum": 1},
            "PARENT_CHECK": {"type": "integer", "minimum": 1}
          },
          "required": ["CODER", "REVIEWER", "COORDINATOR", "PARENT_CHECK"],
          "additionalProperties": false
        },
        "ci_wait_minutes": {"type": "integer", "minimum": 1},
        "recovery_grace_minutes": {"const": 5},
        "handover_seconds": {"const": 0},
        "override_reason": {"type": ["string", "null"], "minLength": 1}
      },
      "required": [
        "poll_seconds", "stage_minutes", "ci_wait_minutes", "recovery_grace_minutes",
        "handover_seconds", "override_reason"
      ],
      "additionalProperties": false
    },
    "owner_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"enum": ["HOLD", "PAUSE", "RESUME", "STOP", "TIMER", "STATUS"]},
          "target": {"enum": ["ALL", "CODER", "REVIEWER", "COORDINATOR"]},
          "child_issue": {"type": ["integer", "null"], "minimum": 1},
          "responsibility_task_id": {"type": ["string", "null"], "pattern": "^PRD-[A-Za-z0-9_.-]+$"},
          "issued_at": {"type": "string", "format": "date-time"},
          "instruction_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "minutes": {"type": ["integer", "null"], "minimum": 1},
          "owner_principal": {"type": "string", "minLength": 1},
          "source_kind": {
            "enum": ["GITHUB_PROVIDER", "DIRECT_OWNER_SESSION", "OTHER_AUTHENTICATED_PROVIDER", "UNVERIFIED"]
          },
          "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authentication_status": {
            "enum": ["AUTHENTICATED", "OBSERVED_TRUSTED_PROVIDER", "UNVERIFIED"]
          }
        },
        "required": [
          "id", "command", "target", "child_issue", "issued_at", "instruction_ref", "reason",
          "minutes", "owner_principal", "source_kind", "source_digest", "authentication_status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"command": {"const": "TIMER"}}},
            "then": {
              "properties": {
                "minutes": {"type": "integer", "minimum": 1},
                "child_issue": {"type": "null"}
              }
            },
            "else": {"properties": {"minutes": {"type": "null"}}}
          }
        ]
      }
    },
    "merge_authority": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["OWNER_ONLY", "DELEGATED"]},
        "reference": {"type": ["string", "null"], "minLength": 1},
        "delegate_principal": {"type": ["string", "null"], "minLength": 1}
      },
      "required": ["mode", "reference", "delegate_principal"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "OWNER_ONLY"}}},
          "then": {"properties": {"delegate_principal": {"type": "null"}}}
        },
        {
          "if": {"properties": {"mode": {"const": "DELEGATED"}}},
          "then": {
            "properties": {
              "reference": {"type": "string", "minLength": 1},
              "delegate_principal": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "start_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "child_issue": {"type": ["integer", "null"], "minimum": 1},
          "responsibility_task_id": {"type": ["string", "null"], "pattern": "^PRD-[A-Za-z0-9_.-]+$"},
          "issued_at": {"type": "string", "format": "date-time"},
          "coordinator": {"type": "string", "minLength": 1},
          "parent_comment_ref": {"type": "string", "format": "uri"},
          "reason": {"type": "string", "minLength": 1},
          "during_record": {"type": ["string", "null"], "minLength": 1},
          "reviewed_head_sha": {
            "anyOf": [
              {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              {"type": "null"}
            ]
          },
          "mode": {"enum": ["SERIAL", "COORDINATOR_READ_ONLY"]},
          "revoked_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "required": [
          "id", "child_issue", "issued_at", "coordinator", "parent_comment_ref", "reason",
          "during_record", "reviewed_head_sha", "mode", "revoked_at"
        ],
        "additionalProperties": false
      }
    },
    "project_protocol_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}:.+$"
    },
    "project_protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_principals": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "required_check_policy": {
      "type": "object",
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider": {"type": "string", "minLength": 1}
      },
      "required": ["source_ref", "digest", "provider"],
      "additionalProperties": false
    },
    "required_check_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "policy_source": {"type": "string", "minLength": 1},
          "workflow_path": {"type": "string", "minLength": 1},
          "expected_app": {"type": "string", "minLength": 1},
          "certifies": {"enum": ["PR_HEAD", "INTEGRATION_CANDIDATE"]},
          "allowed_checkout_modes": {
            "type": "array",
            "items": {"enum": ["PR_HEAD", "SYNTHETIC_MERGE", "MERGE_QUEUE"]},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "check", "provider", "workflow_digest", "policy_source", "workflow_path",
          "expected_app", "certifies", "allowed_checkout_modes"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "waivable_criteria": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_principals": {
      "type": "object",
      "properties": {
        "CODER": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "REVIEWER": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "COORDINATOR": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["CODER", "REVIEWER", "COORDINATOR"],
      "additionalProperties": false
    },
    "stacked_dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "waivable_required_checks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "target_ref": {"type": "string", "pattern": "^refs/heads/.+$"}
  },
  "required": [
    "record", "version", "task_id", "kind", "repository", "issue", "parent_issue", "pr",
    "parent_owner", "spec_ref", "spec_digest", "protocol_ref", "project_protocol_ref",
    "project_protocol_digest", "scope", "acceptance", "children", "required_checks",
    "owner_principals", "required_check_policy", "required_check_contracts", "waivable_criteria",
    "protocol_digest", "role_principals", "stacked_dependencies", "waivable_required_checks",
    "target_ref"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "PARENT"}}},
      "then": {
        "required": ["workspace", "timers", "owner_commands", "merge_authority", "start_permissions"],
        "properties": {
          "parent_issue": {"type": "null"},
          "pr": {"type": "null"},
          "acceptance": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "CHILD"}}},
      "then": {
        "properties": {
          "parent_issue": {"type": "integer", "minimum": 1},
          "children": {"maxItems": 0},
          "acceptance": {"minItems": 1}
        },
        "not": {
          "anyOf": [
            {"required": ["workspace"]},
            {"required": ["timers"]},
            {"required": ["owner_commands"]},
            {"required": ["merge_authority"]},
            {"required": ["start_permissions"]},
            {"required": ["control_plane"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "RESPONSIBILITY"}}},
      "then": {
        "required": ["representation", "acceptance_epoch_id", "acceptance_profile_ref", "acceptance_profile_digest"],
        "properties": {
          "task_id": {"pattern": "^PRD-[A-Za-z0-9_.-]+$"},
          "parent_issue": {"type": "integer", "minimum": 1},
          "children": {"maxItems": 0},
          "acceptance": {"maxItems": 0}
        },
        "not": {
          "anyOf": [
            {"required": ["workspace"]},
            {"required": ["timers"]},
            {"required": ["owner_commands"]},
            {"required": ["merge_authority"]},
            {"required": ["start_permissions"]},
            {"required": ["control_plane"]}
          ]
        }
      }
    }
  ]
}