{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:acceptance-epoch",
  "type": "object",
  "properties": {
    "record": {"const": "ACCEPTANCE_EPOCH"},
    "version": {"const": "1"},
    "epoch_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": "string", "minLength": 1},
    "previous_epoch_id": {"type": ["string", "null"], "minLength": 1},
    "project_protocol_ref": {"type": "string", "minLength": 1},
    "project_protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protected_surface_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adopted_by": {"type": "string", "minLength": 1},
    "adoption_ref": {"type": "string", "minLength": 1},
    "adopted_at": {"type": "string", "format": "date-time"},
    "change_proposal_ref": {"type": "string", "minLength": 1},
    "change_kind": {
      "enum": [
        "DEFECT_REPAIR", "COVERAGE_EXTENSION", "METHOD_CHANGE", "ORACLE_CHANGE",
        "BASELINE_CHANGE", "TOLERANCE_CHANGE", "REQUIREMENT_CHANGE", "CLARIFICATION"
      ]
    },
    "risk_effect": {"enum": ["STRENGTHENING", "NEUTRAL", "RELAXING", "UNKNOWN"]},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "record", "version", "epoch_id", "parent_task_id", "previous_epoch_id",
    "project_protocol_ref", "project_protocol_digest", "protected_surface_digest",
    "adopted_by", "adoption_ref", "adopted_at", "change_proposal_ref",
    "change_kind", "risk_effect", "digest"
  ],
  "additionalProperties": false
}