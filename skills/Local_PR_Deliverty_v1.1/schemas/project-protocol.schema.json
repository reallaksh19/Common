{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:project-protocol",
  "type": "object",
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "acceptance_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "reviewer_check_required": {
                  "type": "boolean"
                },
                "super_review_required": {
                  "type": "boolean"
                },
                "verification_method_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "required",
                "reviewer_check_required",
                "super_review_required",
                "verification_method_ids"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "protected": {
            "const": true
          }
        },
        "required": [
          "id",
          "criteria",
          "protected"
        ],
        "additionalProperties": false
      }
    },
    "external_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "waivable": {
            "type": "boolean"
          },
          "applies_to": {
            "enum": [
              "CHILD",
              "PARENT",
              "ALL"
            ]
          }
        },
        "required": [
          "id",
          "required",
          "waivable",
          "applies_to"
        ],
        "additionalProperties": false
      }
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}:.+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protected_surface": {
      "type": "object",
      "properties": {
        "harness_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oracle_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "harness_digest",
        "baseline_digest",
        "oracle_digests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_id",
    "version",
    "repository",
    "acceptance_sets",
    "harnesses",
    "external_gates",
    "source_ref",
    "digest",
    "protected_surface"
  ],
  "additionalProperties": false
}
