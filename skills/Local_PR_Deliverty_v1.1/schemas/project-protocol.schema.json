{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:project-protocol",
  "type": "object",
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "acceptance_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "reviewer_check_required": {
                  "type": "boolean"
                },
                "super_review_required": {
                  "type": "boolean"
                },
                "verification_method_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "required",
                "reviewer_check_required",
                "super_review_required",
                "verification_method_ids"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "protected": {
            "const": true
          },
          "verification_method_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "manifest_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "criteria",
          "protected",
          "verification_method_ids",
          "manifest_refs"
        ],
        "additionalProperties": false
      }
    },
    "external_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "waivable": {
            "type": "boolean"
          },
          "applies_to": {
            "enum": [
              "CHILD",
              "PARENT",
              "ALL"
            ]
          },
          "allowed_evidence_classes": {
            "type": "array",
            "items": {
              "enum": [
                "SUPER_REVIEW_INDEPENDENT",
                "CI_PROVIDER",
                "EXTERNAL_ORACLE",
                "MANUAL_OBSERVATION"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "required",
          "waivable",
          "applies_to",
          "allowed_evidence_classes"
        ],
        "additionalProperties": false
      }
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}:.+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protected_surface": {
      "type": "object",
      "properties": {
        "harness_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oracle_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "fixture_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "manifest": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "HARNESS_ENTRYPOINT",
                  "IMPORTED_HELPER",
                  "FIXTURE",
                  "BASELINE",
                  "ORACLE_CONFIG",
                  "TOLERANCE",
                  "GENERATOR",
                  "LOCKFILE",
                  "TOOLCHAIN_CONFIG",
                  "CI_WORKFLOW",
                  "POLICY",
                  "OTHER"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "transitive": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "ref",
              "digest",
              "transitive"
            ],
            "additionalProperties": false
          }
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "harness_digest",
        "baseline_digest",
        "oracle_digests",
        "fixture_digests",
        "manifest",
        "manifest_digest"
      ],
      "additionalProperties": false
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_finding_ref": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "harness_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "const": true
          }
        },
        "required": [
          "id",
          "source_finding_ref",
          "criterion_id",
          "harness_id",
          "rationale",
          "active"
        ],
        "additionalProperties": false
      }
    },
    "verification_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verification_class": {
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "BOUNDARY",
              "INVARIANT",
              "ROUND_TRIP",
              "METAMORPHIC",
              "PROPERTY",
              "DIFFERENTIAL",
              "FAULT_INJECTION",
              "ROLLBACK",
              "IDEMPOTENCY",
              "REPLAY",
              "CONCURRENCY",
              "PRODUCER_CONSUMER",
              "FUZZ",
              "PERFORMANCE",
              "EXTERNAL_ORACLE",
              "MANUAL_VISUAL",
              "SECURITY",
              "CI"
            ]
          },
          "harness_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "external_gate_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "required_evidence_classes": {
            "type": "array",
            "items": {
              "enum": [
                "AUTHOR",
                "REVIEWER_INDEPENDENT",
                "SUPER_REVIEW_INDEPENDENT",
                "CI_PROVIDER",
                "EXTERNAL_ORACLE",
                "MANUAL_OBSERVATION"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "material_inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rerun_policy": {
            "enum": [
              "FULL_REQUIRED_SET",
              "DECLARED_MATERIAL_INPUTS"
            ]
          },
          "applies_to_roles": {
            "type": "array",
            "items": {
              "enum": [
                "CODER",
                "REVIEWER",
                "COORDINATOR",
                "PARENT_CHECK"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "verification_class",
          "harness_id",
          "external_gate_id",
          "required_evidence_classes",
          "material_inputs",
          "rerun_policy",
          "applies_to_roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_id",
    "version",
    "repository",
    "acceptance_sets",
    "verification_methods",
    "harnesses",
    "external_gates",
    "source_ref",
    "digest",
    "protected_surface",
    "regressions"
  ],
  "additionalProperties": false
}
