{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:evidence-record",
  "type": "object",
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "AUTHOR",
        "REVIEWER_INDEPENDENT",
        "SUPER_REVIEW_INDEPENDENT",
        "CI_PROVIDER",
        "EXTERNAL_ORACLE",
        "MANUAL_OBSERVATION"
      ]
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "project_protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "harness_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "INCONCLUSIVE",
        "NOT_APPLICABLE"
      ]
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "artifact_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "common_protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_lease_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "acceptance_surface_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "procedure_kind": {
      "enum": [
        "COMMAND",
        "MANUAL",
        "PROVIDER"
      ]
    },
    "command_argv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": false
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "fixture_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "origin_kind": {
      "enum": [
        "STAGE_EXECUTOR",
        "CI_PROVIDER",
        "EXTERNAL_ORACLE",
        "HUMAN_OBSERVER",
        "OTHER_AUTHENTICATED_PROVIDER"
      ]
    },
    "origin_principal": {
      "type": "string",
      "minLength": 1
    },
    "collected_by_role": {
      "enum": [
        "CODER",
        "REVIEWER",
        "COORDINATOR",
        "PARENT_CHECK"
      ]
    },
    "collected_by_principal": {
      "type": "string",
      "minLength": 1
    },
    "provider_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "verification_method_id": {
      "type": "string",
      "minLength": 1
    },
    "harness_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "external_gate_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "oracle_independence": {
      "enum": [
        "PINNED_ORACLE_INDEPENDENT",
        "PROVIDER_INDEPENDENT",
        "HUMAN_INDEPENDENT",
        "NOT_INDEPENDENT",
        "UNKNOWN"
      ]
    },
    "principal_relationship_to_candidate": {
      "enum": [
        "AUTHOR_OF_CANDIDATE",
        "LAST_PRODUCT_WRITER",
        "PRIOR_PRODUCT_WRITER",
        "NON_WRITER_REVIEWER",
        "EXTERNAL_PROVIDER",
        "EXTERNAL_HUMAN"
      ]
    },
    "acceptance_surface_manifest_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "evidence_id",
    "evidence_class",
    "candidate_sha",
    "project_protocol_digest",
    "harness_digest",
    "result",
    "procedure",
    "artifact_digest",
    "baseline_digest",
    "environment_digest",
    "common_protocol_digest",
    "review_lease_ref",
    "acceptance_surface_digest",
    "collected_at",
    "procedure_kind",
    "command_argv",
    "exit_code",
    "fixture_digests",
    "origin_kind",
    "origin_principal",
    "collected_by_role",
    "collected_by_principal",
    "provider_ref",
    "verification_method_id",
    "harness_id",
    "external_gate_id",
    "oracle_independence",
    "principal_relationship_to_candidate",
    "acceptance_surface_manifest_digest"
  ],
  "additionalProperties": false
}
