{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:stage-record",
  "type": "object",
  "properties": {
    "record": {
      "const": "STAGE_RECORD"
    },
    "version": {
      "const": "1.1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "CODER",
        "REVIEWER",
        "COORDINATOR",
        "PARENT_CHECK"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "previous_record": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "work_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "RUNNING",
        "PASS",
        "REWORK",
        "STALLED",
        "BLOCKED",
        "HELD",
        "PAUSED",
        "STOPPED",
        "WAITING_CI",
        "WAITING_OWNER",
        "INCONCLUSIVE",
        "WAITING_EXTERNAL",
        "APPROVED_WITH_WAIVER"
      ]
    },
    "input_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "output_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "validated_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "handover": {
      "type": "object",
      "properties": {
        "pr_description_ref": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "child_comment_ref": {
          "type": "string",
          "format": "uri"
        },
        "parent_comment_ref": {
          "type": "string",
          "format": "uri"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "workspace_notes": {
          "type": "string",
          "minLength": 1
        },
        "reconciliation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "pr_description_ref",
        "child_comment_ref",
        "parent_comment_ref",
        "changed_files",
        "workspace_notes",
        "reconciliation"
      ],
      "additionalProperties": false
    },
    "acceptance_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "problem",
          "status",
          "resolution"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RESOLVED"
                }
              }
            },
            "then": {
              "properties": {
                "resolution": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check",
          "required",
          "result",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "string",
      "minLength": 1
    },
    "repeat_stages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CODER",
          "REVIEWER",
          "COORDINATOR"
        ]
      },
      "maxItems": 0
    },
    "writer_stopped": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "ci_wait_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "stalled_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "publications": {
      "type": "object",
      "properties": {
        "start": {
          "type": "object",
          "properties": {
            "comment_ref": {
              "type": "string",
              "format": "uri"
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "comment_ref",
            "published_at",
            "summary"
          ],
          "additionalProperties": false
        },
        "end": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "comment_ref": {
                  "type": "string",
                  "format": "uri"
                },
                "published_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "comment_ref",
                "published_at",
                "summary"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "parent_context": {
      "type": "object",
      "properties": {
        "read_at": {
          "type": "string",
          "format": "date-time"
        },
        "through_comment_ref": {
          "type": "string",
          "format": "uri"
        },
        "reconciled_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "read_at",
        "through_comment_ref",
        "reconciled_points"
      ],
      "additionalProperties": false
    },
    "workspace_mode": {
      "enum": [
        "WRITE",
        "READ_ONLY"
      ]
    },
    "review_source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "head_sha",
            "reference"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "INCONCLUSIVE",
              "NOT_APPLICABLE"
            ]
          },
          "verification_method_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "criterion_id",
          "required",
          "result",
          "verification_method_ids",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "evidence_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "AUTHOR",
              "REVIEWER_INDEPENDENT",
              "SUPER_REVIEW_INDEPENDENT",
              "CI_PROVIDER",
              "EXTERNAL_ORACLE",
              "MANUAL_OBSERVATION"
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "INCONCLUSIVE",
              "NOT_APPLICABLE"
            ]
          },
          "source_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "artifact_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "harness_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "environment_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "evidence_id",
          "class",
          "result",
          "source_sha",
          "procedure",
          "artifact_digest",
          "harness_digest",
          "baseline_digest",
          "environment_digest"
        ],
        "additionalProperties": false
      }
    },
    "acceptance_surface": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "project_protocol_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "harness_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "baseline_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "oracle_digests": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "uniqueItems": true
            },
            "mutation_detected": {
              "const": false
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "project_protocol_digest",
            "harness_digest",
            "baseline_digest",
            "oracle_digests",
            "mutation_detected",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "production_output": {
      "type": "object",
      "properties": {
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "coverage_completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fixes_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "regressions_added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "education_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "unresolved_internal_defects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "internal_fixable_defects_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_class": {
          "enum": [
            "NONE",
            "OWNER",
            "EXTERNAL",
            "PROVIDER",
            "PROTECTED_ACCEPTANCE_SURFACE"
          ]
        },
        "coverage_complete_for_stage": {
          "type": "boolean"
        },
        "early_termination": {
          "type": "boolean"
        },
        "early_termination_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "deliverables",
        "coverage_completed",
        "fixes_applied",
        "regressions_added",
        "education_points",
        "unresolved_internal_defects",
        "internal_fixable_defects_remaining",
        "blocking_class",
        "coverage_complete_for_stage",
        "early_termination",
        "early_termination_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "early_termination": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "early_termination_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "early_termination": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "early_termination_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "role_integrity": {
      "type": "object",
      "properties": {
        "claimed_role": {
          "enum": [
            "CODER",
            "REVIEWER",
            "COORDINATOR",
            "PARENT_CHECK"
          ]
        },
        "principal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claimed_role",
        "principal"
      ],
      "additionalProperties": false
    },
    "review_lease_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "context_start_ref": {
      "type": "string",
      "minLength": 1
    },
    "context_pre_verdict_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_attestation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "candidate_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "integration_tree_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "workspace_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "unrecorded_changes": {
              "const": false
            },
            "merge_base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "candidate_sha",
            "base_sha",
            "integration_tree_digest",
            "workspace_digest",
            "unrecorded_changes",
            "merge_base_sha"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "type": "object",
      "properties": {
        "common_protocol_current": {
          "type": "boolean"
        },
        "project_protocol_current": {
          "type": "boolean"
        },
        "spec_current": {
          "type": "boolean"
        },
        "parent_context_current": {
          "type": "boolean"
        },
        "child_context_current": {
          "type": "boolean"
        },
        "pr_description_current": {
          "type": "boolean"
        },
        "acceptance_surface_current": {
          "type": "boolean"
        },
        "environment_current": {
          "type": "boolean"
        },
        "dependencies_current": {
          "type": "boolean"
        }
      },
      "required": [
        "common_protocol_current",
        "project_protocol_current",
        "spec_current",
        "parent_context_current",
        "child_context_current",
        "pr_description_current",
        "acceptance_surface_current",
        "environment_current",
        "dependencies_current"
      ],
      "additionalProperties": false
    },
    "carried_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "blocking",
          "status",
          "source_ref"
        ],
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "common_protocol_ref": {
      "type": "string",
      "minLength": 1
    },
    "common_protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_protocol_ref": {
      "type": "string",
      "minLength": 1
    },
    "external_gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "INCONCLUSIVE",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "gate_id",
          "result",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "waiver_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "record",
    "version",
    "record_id",
    "task_id",
    "stage",
    "attempt",
    "executor",
    "previous_record",
    "started_at",
    "work_periods",
    "status",
    "input_sha",
    "output_sha",
    "validated_sha",
    "base_sha",
    "spec_digest",
    "parent_spec_digest",
    "workspace",
    "handover",
    "acceptance_checked",
    "findings",
    "validation",
    "changes",
    "repeat_stages",
    "writer_stopped",
    "next_action",
    "ci_wait_started_at",
    "stalled_at",
    "publications",
    "parent_context",
    "workspace_mode",
    "review_source",
    "acceptance_results",
    "evidence_manifest",
    "acceptance_surface",
    "production_output",
    "role_integrity",
    "review_lease_ref",
    "context_start_ref",
    "context_pre_verdict_ref",
    "environment_ref",
    "source_attestation",
    "freshness",
    "carried_findings",
    "evidence_refs",
    "common_protocol_ref",
    "common_protocol_digest",
    "project_protocol_ref",
    "external_gate_results",
    "waiver_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "output_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "validated_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "writer_stopped": {
            "const": true
          },
          "validation": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAITING_CI"
          }
        }
      },
      "then": {
        "properties": {
          "ci_wait_started_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "STALLED"
          }
        }
      },
      "then": {
        "properties": {
          "stalled_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "HELD",
              "PAUSED",
              "STOPPED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "writer_stopped": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "writer_stopped": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "publications": {
            "properties": {
              "end": {
                "type": "object",
                "properties": {
                  "comment_ref": {
                    "type": "string",
                    "format": "uri"
                  },
                  "published_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "comment_ref",
                  "published_at",
                  "summary"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "handover": {
            "properties": {
              "pr_description_ref": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "production_output": {
            "properties": {
              "internal_fixable_defects_remaining": {
                "const": 0
              },
              "unresolved_internal_defects": {
                "maxItems": 0
              },
              "blocking_class": {
                "const": "NONE"
              },
              "coverage_complete_for_stage": {
                "const": true
              },
              "early_termination": {
                "const": false
              }
            }
          },
          "acceptance_results": {
            "minItems": 1
          },
          "evidence_manifest": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "COORDINATOR",
              "PARENT_CHECK"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_surface": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "production_output": {
            "properties": {
              "blocking_class": {
                "enum": [
                  "OWNER",
                  "EXTERNAL",
                  "PROVIDER",
                  "PROTECTED_ACCEPTANCE_SURFACE"
                ]
              },
              "internal_fixable_defects_remaining": {
                "const": 0
              },
              "unresolved_internal_defects": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED_WITH_WAIVER"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "enum": [
              "COORDINATOR",
              "PARENT_CHECK"
            ]
          },
          "output_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "validated_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "writer_stopped": {
            "const": true
          },
          "validation": {
            "minItems": 1
          },
          "waiver_refs": {
            "minItems": 1
          },
          "production_output": {
            "properties": {
              "internal_fixable_defects_remaining": {
                "const": 0
              },
              "unresolved_internal_defects": {
                "maxItems": 0
              },
              "blocking_class": {
                "const": "NONE"
              },
              "coverage_complete_for_stage": {
                "const": true
              },
              "early_termination": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
