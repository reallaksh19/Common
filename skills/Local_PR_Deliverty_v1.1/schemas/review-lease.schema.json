{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pr-deliverty:v1.1:review-lease",
  "type": "object",
  "properties": {
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_record_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "integration_tree_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "common_protocol_ref": {
      "type": "string",
      "minLength": 1
    },
    "project_protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "child_context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pr_description_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_check_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance_surface_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_heads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "task_id",
          "sha"
        ],
        "additionalProperties": false
      }
    },
    "sealed_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    },
    "context_pre_verdict_ref": {
      "type": "string",
      "minLength": 1
    },
    "common_protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "lease_id",
    "task_id",
    "stage_record_id",
    "candidate_sha",
    "base_sha",
    "integration_tree_digest",
    "common_protocol_ref",
    "project_protocol_digest",
    "spec_digest",
    "parent_spec_digest",
    "parent_context_digest",
    "child_context_digest",
    "pr_description_digest",
    "required_check_policy_digest",
    "acceptance_surface_digest",
    "environment_digest",
    "dependency_heads",
    "sealed_at",
    "environment_ref",
    "context_pre_verdict_ref",
    "common_protocol_digest"
  ],
  "additionalProperties": false
}
