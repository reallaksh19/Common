{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rll-directive.schema.json",
  "title": "RELAY_DIRECTIVE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sequence",
    "issue",
    "action"
  ],
  "properties": {
    "schema": {
      "const": "RELAY_DIRECTIVE_V1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "action": {
      "enum": [
        "CONTINUE",
        "PAUSE",
        "RESUME",
        "REPLAN",
        "CANCEL"
      ]
    },
    "instruction": {
      "type": "string"
    }
  }
}
