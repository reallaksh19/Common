[CmdletBinding()]
param(
    [string]$CommonRoot = $env:COMMON_REPO_ROOT,
    [string]$WorkerId = "{{WORKER_ID}}",
    [string]$AuthorizedLogin = "{{AUTHORIZED_LOGIN}}",
    [string]$RequiredCommonBasis = "{{REQUIRED_COMMON_BASIS}}",
    [string]$PrintTimeout = "2h",
    [ValidateSet("low","medium","high")]
    [string]$Effort = "high",
    [switch]$Smoke
)

$ErrorActionPreference = "Stop"
$RepoRoot = Split-Path -Parent $PSScriptRoot

if (-not $env:RLL_DATA_DIR -and $env:ANTIGRAVITY_EXECUTABLE_DATA_DIR) {
    $env:RLL_DATA_DIR = Join-Path $env:ANTIGRAVITY_EXECUTABLE_DATA_DIR "rll"
}

if (-not $CommonRoot) {
    $candidate = Join-Path (Split-Path -Parent $RepoRoot) "Common"
    if (Test-Path $candidate) { $CommonRoot = $candidate }
}
if (-not $CommonRoot) { throw "Common checkout not found. Set COMMON_REPO_ROOT or pass -CommonRoot." }

$Launcher = Join-Path $CommonRoot "skills\engineering-pr-delivery-v3.1\scripts\rll_worker.py"
if (-not (Test-Path $Launcher)) { throw "Common RLL-1 launcher not found: $Launcher" }

foreach ($tool in @("python","git","gh","agy")) {
    if (-not (Get-Command $tool -ErrorAction SilentlyContinue)) { throw "Required command '$tool' is not on PATH." }
}

& git -C $CommonRoot cat-file -e "$RequiredCommonBasis^{commit}" *> $null
if ($LASTEXITCODE -ne 0) { throw "Required Common basis $RequiredCommonBasis is absent." }
& git -C $CommonRoot merge-base --is-ancestor $RequiredCommonBasis HEAD *> $null
if ($LASTEXITCODE -ne 0) { throw "Common HEAD does not contain required RLL basis $RequiredCommonBasis." }

& gh auth status *> $null
if ($LASTEXITCODE -ne 0) { throw "GitHub CLI is not authenticated. Run 'gh auth login' first." }

$argsList = @(
    $Launcher,
    "--repo-root", $RepoRoot,
    "--repository", "{{REPOSITORY}}",
    "--worker-id", $WorkerId,
    "--authorized-login", $AuthorizedLogin,
    "--print-timeout", $PrintTimeout,
    "--effort", $Effort
)
if ($Smoke -or ($env:RLL_SMOKE -eq "1")) { $argsList += "--smoke" }

& python @argsList
exit $LASTEXITCODE
