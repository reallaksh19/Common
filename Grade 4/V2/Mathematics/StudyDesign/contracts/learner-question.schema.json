{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/Grade4/V2/Mathematics/StudyDesign/contracts/learner-question.schema.json",
  "title": "Grade4MathLearnerQuestionContract",
  "type": "object",
  "required": [
    "question_id",
    "origin",
    "display_ref",
    "prompt",
    "answer_contract",
    "hint_contract"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "origin": {"enum": ["SOURCE", "GENERATED_PRACTICE"]},
    "display_ref": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "source_identity": {
      "oneOf": [
        {"$ref": "../../CoreSkills/contracts/source-identity.schema.json"},
        {"type": "null"}
      ]
    },
    "task_support_policy": {"enum": ["NUMERIC_FIRST", "VISUAL_FIRST", "MIXED", "NO_HINT"]},
    "answer_contract": {
      "type": "object",
      "required": ["answer_kind", "answer_text", "check_route", "answer_ref"],
      "properties": {
        "answer_kind": {"enum": ["EXACT", "EXEMPLAR", "RUBRIC", "SOURCE_DEFECT_RESOLUTION"]},
        "answer_text": {"type": "string", "minLength": 1},
        "check_route": {"enum": ["INLINE", "CHECK_AFTER_TRY", "ANSWER_MAP", "TEACHER_KEY"]},
        "answer_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "hint_contract": {
      "type": "object",
      "required": ["modality", "may_reveal_final_answer"],
      "properties": {
        "modality": {"enum": ["NUMERIC", "VISUAL", "MIXED", "NONE"]},
        "hint_text": {"type": ["string", "null"]},
        "visual_ref": {"type": ["string", "null"]},
        "may_reveal_final_answer": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "SOURCE"}}, "required": ["origin"]},
      "then": {
        "required": ["source_identity"],
        "properties": {"source_identity": {"type": "object"}}
      }
    },
    {
      "if": {"properties": {"origin": {"const": "GENERATED_PRACTICE"}}, "required": ["origin"]},
      "then": {
        "properties": {"source_identity": {"type": "null"}}
      }
    }
  ],
  "additionalProperties": false
}
