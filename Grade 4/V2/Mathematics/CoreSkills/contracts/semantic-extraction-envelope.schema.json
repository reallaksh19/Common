{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/Primary/V2/Mathematics/CoreSkills/contracts/semantic-extraction-envelope.schema.json",
  "title": "Primary Math V2 Semantic Extraction Envelope",
  "type": "object",
  "required": ["schema_version", "extraction_id", "extractor", "questions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "extraction_id": {"type": "string", "minLength": 1},
    "extractor": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["MODEL_ASSISTED", "MANUAL", "SOURCE_STRUCTURED"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_ref", "source_text", "claims"],
        "properties": {
          "question_ref": {"type": "string", "minLength": 1},
          "source_ref": {"type": ["string", "null"]},
          "source_text": {"type": "string", "minLength": 1},
          "claims": {
            "type": "object",
            "required": ["concept_key", "concept_title", "scope_basis", "capability_refs", "problem_family_refs", "representation_requirements"],
            "properties": {
              "concept_key": {"type": "string", "minLength": 1},
              "concept_title": {"type": "string", "minLength": 1},
              "scope_basis": {"enum": ["CURRICULUM_CONFIRMED", "QUESTION_SET_OBSERVED", "SCHOOL_CLASSWORK_OBSERVED", "COMMON_G4_5_CAPABILITY", "CURRICULUM_OVERLAY", "EXTENSION", "STRETCH", "MAPPING_PENDING", "SOURCE_NOT_PROVIDED"]},
              "authority_ref": {"type": ["string", "null"]},
              "universal_grade_claim": {"type": "boolean", "default": false},
              "capability_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
              "prerequisite_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "problem_family_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "translation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "representation_requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
              "quantity_structure": {"type": ["object", "null"]},
              "invariant_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "transfer_dimension_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "ambiguity": {"type": "array", "items": {"type": "string"}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
