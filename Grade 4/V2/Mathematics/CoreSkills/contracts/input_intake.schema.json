{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrimaryMathInputIntake",
  "description": "Product intake contract for Primary Mathematics V2: question_set (REQUIRED), student_workout (OPTIONAL), topic_hints (OPTIONAL).",
  "type": "object",
  "required": ["question_set"],
  "properties": {
    "question_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "prompt"],
        "properties": {
          "question_id": { "type": "string" },
          "prompt": { "type": "string" },
          "grade_level": { "type": "integer", "enum": [4, 5] },
          "topic": { "type": "string" },
          "operands": { "type": "array", "items": { "type": "number" } },
          "target_operation": { "type": "string" },
          "school_context": {
            "type": "object",
            "properties": {
              "school_id": { "type": "string" },
              "assignment_name": { "type": "string" }
            }
          }
        }
      }
    },
    "student_workout": {
      "type": "object",
      "properties": {
        "workout_id": { "type": "string" },
        "provenance_tier": {
          "type": "string",
          "enum": [
            "ORIGINAL_SOURCE_IMAGE",
            "FAITHFUL_TRANSCRIPTION",
            "STRUCTURED_REPLAY",
            "AUTHORED_NOTEBOOK_EXAMPLE"
          ]
        },
        "student_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_number", "content"],
            "properties": {
              "step_number": { "type": "integer" },
              "content": { "type": "string" },
              "is_ambiguous": { "type": "boolean" },
              "self_corrected": { "type": "boolean" },
              "teacher_annotation": { "type": "string" }
            }
          }
        }
      }
    },
    "topic_hints": {
      "type": "object",
      "properties": {
        "focus_areas": { "type": "array", "items": { "type": "string" } },
        "avoid_representations": { "type": "array", "items": { "type": "string" } },
        "learner_notes": { "type": "string" }
      }
    }
  }
}
