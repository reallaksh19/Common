{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrimaryMathCore2CompanionPlan",
  "description": "Plan specification for Core 2 Companion: Appendix A Practice Batches, Appendix B Hint Ladder & Solutions, Appendix C Visual Quick Reference.",
  "type": "object",
  "required": [
    "companion_id",
    "linked_core1_id",
    "appendix_a",
    "appendix_b",
    "appendix_c"
  ],
  "properties": {
    "companion_id": { "type": "string" },
    "linked_core1_id": { "type": "string" },
    "appendix_a": {
      "type": "object",
      "required": ["batches"],
      "properties": {
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["batch_id", "title", "practice_role", "items"],
            "properties": {
              "batch_id": { "type": "string" },
              "title": { "type": "string" },
              "practice_role": {
                "type": "string",
                "enum": ["RECONNECT", "BUILD", "CHOOSE", "MIX", "TRANSFER", "RETRIEVE"]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["item_id", "prompt"],
                  "properties": {
                    "item_id": { "type": "string" },
                    "prompt": { "type": "string" },
                    "answer": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "appendix_b": {
      "type": "object",
      "required": ["ladders"],
      "properties": {
        "ladders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "H0_try",
              "H1_notice",
              "H2_remember",
              "H3_represent",
              "fresh_independent_retry_H0"
            ],
            "properties": {
              "item_id": { "type": "string" },
              "H0_try": { "type": "string" },
              "H1_notice": { "type": "string" },
              "H2_remember": { "type": "string" },
              "H3_represent": { "type": "string" },
              "fresh_independent_retry_H0": { "type": "string" },
              "solution_trace": {
                "type": "object",
                "properties": {
                  "steps": { "type": "array", "items": { "type": "string" } },
                  "final_answer": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "appendix_c": {
      "type": "object",
      "required": ["title", "format", "decision_aid_name", "is_prose_cram_sheet"],
      "properties": {
        "title": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["VISUAL_DECISION_REFERENCE", "FLOW_CARD", "COMPARISON_MATRIX"]
        },
        "decision_aid_name": { "type": "string" },
        "is_prose_cram_sheet": { "type": "boolean", "default": false },
        "primitive_call": {
          "type": "object",
          "properties": {
            "kind": { "type": "string" },
            "params": { "type": "object" }
          }
        }
      }
    }
  }
}
