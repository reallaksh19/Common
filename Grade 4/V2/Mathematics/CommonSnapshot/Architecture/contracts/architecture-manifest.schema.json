{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/Primary/V2/Mathematics/Architecture/contracts/architecture-manifest.schema.json",
  "title": "PrimaryMathArchitectureManifest",
  "type": "object",
  "required": ["schema_version", "run_id", "input_digest", "skill_model_digest", "core1_plan_digest", "core2_plan_digest", "representation_plan_digest", "human_review_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "minLength": 1},
    "skill_model_digest": {"type": "string", "minLength": 1},
    "core1_plan_digest": {"type": "string", "minLength": 1},
    "core2_plan_digest": {"type": "string", "minLength": 1},
    "representation_plan_digest": {"type": "string", "minLength": 1},
    "producer_version": {"type": ["string", "null"]},
    "candidate_export_ref": {"type": ["string", "null"]},
    "artifact_refs": {
      "type": "object",
      "properties": {
        "core1_pdf_sha256": {"type": ["string", "null"]},
        "core2_pdf_sha256": {"type": ["string", "null"]},
        "physical_page_map_digest": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "benchmark_ref": {"type": ["string", "null"]},
    "evidence_class": {"enum": ["TEST_FIXTURE", "REAL_CANDIDATE"]},
    "semantic_status": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
    "artifact_status": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
    "human_review_status": {
      "type": "object",
      "required": ["SUBJECT_CORRECTNESS", "PEDAGOGICAL_DESIGN", "ASSESSMENT_DESIGN", "VISUAL_USABILITY", "CHILD_USABILITY", "MATURE_DESIGN_QUALITY"],
      "properties": {
        "SUBJECT_CORRECTNESS": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
        "PEDAGOGICAL_DESIGN": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
        "ASSESSMENT_DESIGN": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
        "VISUAL_USABILITY": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
        "CHILD_USABILITY": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
        "MATURE_DESIGN_QUALITY": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
