{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/Common/Grade4/V2/English/CoreSkills/contracts/semantic-extraction-envelope.schema.json",
  "title": "PrimaryEnglishSemanticExtractionEnvelope",
  "type": "object",
  "required": ["schema_version", "source", "question_evidence", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "required": ["source_id", "source_type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["WORKSHEET_SCAN", "QUESTION_PAPER_SCAN", "TEXTBOOK_SCAN", "TYPED_QUESTION_SET", "TEACHER_NOTE", "OTHER"]},
        "grade": {"type": "integer", "enum": [4, 5]},
        "source_issues": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "source_models": {"type": "array", "items": {"$ref": "source-model.schema.json"}},
    "question_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "question-evidence.schema.json"}},
    "learner_evidence": {"type": "array", "items": {"$ref": "learner-evidence.schema.json"}},
    "provenance": {
      "type": "object",
      "required": ["extraction_mode"],
      "properties": {
        "extraction_mode": {"enum": ["FAITHFUL_TRANSCRIPTION", "STRUCTURED_REPLAY", "ORIGINAL_SOURCE_IMAGE"]},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
