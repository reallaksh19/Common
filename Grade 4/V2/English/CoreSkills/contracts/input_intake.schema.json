{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrimaryEnglishInputIntake",
  "description": "Product intake contract for Primary English V2: question_set is required; learner evidence, topic hints and source authority are optional.",
  "type": "object",
  "required": ["question_set"],
  "properties": {
    "question_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "prompt"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "grade_level": {"type": "integer", "enum": [4, 5]},
          "section_ref": {"type": ["string", "null"]},
          "source_ref": {"type": ["string", "null"]},
          "domain_hint": {"type": ["string", "null"]},
          "printed_rubric": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    },
    "learner_evidence": {
      "type": "array",
      "items": {"$ref": "learner-evidence.schema.json"}
    },
    "topic_hints": {
      "type": "object",
      "properties": {
        "focus_areas": {"type": "array", "items": {"type": "string"}},
        "known_source_models": {"type": "array", "items": {"type": "string"}},
        "learner_notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source_authority": {
      "type": "object",
      "properties": {
        "authority_type": {"enum": ["QUESTION_SET", "WORKSHEET", "TEXTBOOK", "TEACHER_PORTION", "CURRICULUM_DOCUMENT", "OTHER"]},
        "authority_ref": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
